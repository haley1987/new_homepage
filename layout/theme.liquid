<script>
document.addEventListener('DOMContentLoaded', () => {
  const giftCardPath = window.location.pathname.includes('/products/gift-card');
  if (!giftCardPath) return;

  let isCanadian = false;
  let hasAutoSelected = false;

  // ✅ Use Shopify's localization API instead of external fetch
  const country = {{ localization.country.iso_code | json }};
  isCanadian = country === 'CA';
  console.log('[GiftCard] Detected country:', country);

  function filterGiftCardOptions() {
    const denominationSelect = document.querySelector('select[name*="Denominations"]');
    if (!denominationSelect) return;

    let firstVisibleOptionIndex = -1;

    Array.from(denominationSelect.options).forEach((option, index) => {
      const label = option.textContent.trim();
      const isCAD = label.startsWith('CAD$');
      const isUSD = label.startsWith('US$');

      const shouldHide = (isCanadian && isUSD) || (!isCanadian && isCAD);
      option.hidden = shouldHide;

      if (!shouldHide && firstVisibleOptionIndex === -1) {
        firstVisibleOptionIndex = index;
      }
    });

    // Auto-select only once on first render
    if (!hasAutoSelected && firstVisibleOptionIndex >= 0) {
      denominationSelect.selectedIndex = firstVisibleOptionIndex;
      denominationSelect.dispatchEvent(new Event('change', { bubbles: true }));
      console.log('[GiftCard] Auto-selected:', denominationSelect.options[firstVisibleOptionIndex].textContent.trim());
      hasAutoSelected = true;
    }
  }

  // Run immediately
  filterGiftCardOptions();

  // Watch for DOM changes to reapply logic
  const observer = new MutationObserver(() => {
    filterGiftCardOptions();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
});
</script>

