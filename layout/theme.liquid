  <body class="gradient{% if request.page_type == 'index' %} hw-homepage{% endif %}{% if request.page_type == 'page' and page.handle == 'booking' %} hw-booking-page{% endif %}{% if request.page_type == 'page' and page.handle == 'store-locator' %} hw-locator-page{% endif %}{% if request.page_type == 'page' and page.handle == 'return-policy' %} hw-return-policy-page{% endif %}{% if request.page_type == 'page' and page.handle == 'faqs' %} hw-faq-page{% endif %}{% if request.page_type == 'page' and page.handle == 'contact' %} hw-contact-page{% endif %}{% if settings.animations_hover_elements != 'none' %} animate--hover-{{ settings.animations_hover_elements }}{% endif %}">
