<script>
document.addEventListener('submit', function (e) {
  const form = e.target;
  if (!form.matches('form[action="/cart/add"]')) return;

  // Catch before Dawn/app handlers
  e.preventDefault();
  e.stopImmediatePropagation();

  console.log('[ATC] Intercepted /cart/add submit', form);

  const drawer = document.getElementById('cart-notification-drawer');
  const submitBtn = e.submitter || form.querySelector('button[name="add"]');
  const formData = new FormData(form);

  if (submitBtn) submitBtn.disabled = true;

  fetch('/cart/add.js', {
    method: 'POST',
    body: formData,
    headers: { 'Accept': 'application/json' }
  })
  .then(res => {
    if (!res.ok) throw new Error('Add to cart failed');
    return res.json();
  })
  .then(data => {
    // Close any open config overlay
    const overlay = document.querySelector('config-drawer[open]');
    if (overlay) {
      overlay.removeAttribute('open');
      document.body.classList.remove('overlay-open');
    }

    // Open your custom drawer
    if (drawer) {
      drawer.style.display = 'block';
      requestAnimationFrame(() => {
        drawer.style.opacity = '1';
        drawer.style.transform = 'translateY(0)';
      });
    }

    // Update cart count
    return fetch('/cart.js').then(r => r.json()).then(cart => {
      let bubble = document.querySelector('#cart-icon-bubble .cart-count-bubble');
      if (!bubble) {
        const wrap = document.getElementById('cart-icon-bubble');
        if (wrap) {
          bubble = document.createElement('div');
          bubble.className = 'cart-count-bubble';
          wrap.appendChild(bubble);
        }
      }
      if (bubble) {
        const count = cart.item_count;
        if (count > 0) {
          bubble.innerHTML = `
            <span aria-hidden="true">${count}</span>
            <span class="visually-hidden">${count} item${count !== 1 ? 's' : ''}</span>
          `;
          bubble.style.display = 'block';
        } else {
          bubble.style.display = 'none';
        }
      }
    });
  })
  .then(() => {
    // Auto-hide drawer after 5s
    if (drawer) {
      setTimeout(() => {
        drawer.style.opacity = '0';
        drawer.style.transform = 'translateY(-10px)';
        setTimeout(() => { drawer.style.display = 'none'; }, 300);
      }, 5000);
    }
  })
  .catch(err => {
    console.error('[ATC] Error:', err);
    alert('Something went wrong. Please try again.');
  })
  .finally(() => {
    if (submitBtn) submitBtn.disabled = false;
  });
}, true); // <-- capture phase is key
</script>



