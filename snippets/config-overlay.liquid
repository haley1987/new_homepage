<style>
  config-drawer {
    position: fixed;
    inset: 0;
    z-index: 999;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.2s ease;
    background: rgba(0, 0, 0, 0.65); /* ✅ Dim background */
  }

  config-drawer[open] {
    visibility: visible;
    opacity: 1;
  }

  .cfg-inner {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: 100%;
    max-width: 90vw;
    background: #fff;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    box-shadow: -4px 0 10px rgba(0, 0, 0, 0.2);
  }

  config-drawer[open] .cfg-inner {
    transform: translateX(0);
  }

  .cfg-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background: #fff;
    border-bottom: 1px solid #e5e5e5;
    font-weight: 44;
    font-size: 1.6rem;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .cfg-header button {
    background: none;
    border: none;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    font-weight: bold;
    color: #888;
  }

  .cfg-body {
    display: flex;
    flex: 1;
    overflow-y: auto;
  }

  .cfg-left {
    width: 50%;
    padding-inline: 2rem;
    position: sticky;
    top: 1px;
    height: fit-content;
    align-self: flex-start;
  }

  .cfg-left img {
    max-width: 100%;
    height: auto;
    display: block;
    border: none;
    background: none;
  }

  .cfg-right {
    width: 50%;
    padding: 2rem;
  }



@media (min-width: 1440px) {
  .cfg-left {
    padding-inline: 10rem; /* large desktops (21" screens) */
  }
}

@media (min-width: 1920px) {
  .cfg-left {
    padding-inline: 15rem; /* ultra-wide monitors */
  }

}


  @media (max-width: 990px) {
        .cfg-left {
      display: none;
    }
    .cfg-inner {
      max-width: 100vw;
    }

    .cfg-body {
      flex-direction: column;
    }

    .cfg-left,
    .cfg-right {
      width: 100%;
    }
  }

  body.overlay-open {
    overflow: hidden;
    height: 100vh;
  }

  .mw-option__container .mw-option__value .mw-stack__item .mw-label {
padding: 0 !important;
}

.mw-option__value--selected .mw-option__value-title {
    padding: 0 !important;
    margin-top: 0 !important; }

    .mw-option__value-title {
    font-size: 1.25rem !important;
}

.mw-option__value.mw-option__value--has-horizontal .mw-stack.mw-stack--alignment-center.mw-stack--alignment-horizontal .mw-stack__near {

    margin-top: -4px !important; }

    .mw-option__value.mw-option__value--has-horizontal .mw-stack.mw-stack--alignment-center.mw-stack--alignment-horizontal .mw-stack__near .mw-text {
    padding-top: 8px;
    padding-bottOm: 8px;
}

.mw-option--type-button .mw-option__button, .mw-option--type-multibutton .mw-option__button {
border: none !important;
}

.mw-option__value .mw-text {
  white-space: normal !important;
}


