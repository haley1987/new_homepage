<style>
  config-drawer {
    --cfg-navy: #0b2341;
    --cfg-navy-soft: #17314f;
    --cfg-gold: #c9a66b;
    --cfg-paper: #f2eee5;
    --cfg-ink: #0b0b0a;
    --cfg-muted: #5b5a55;
    --cfg-line: rgba(11, 35, 65, 0.16);
    --cfg-serif: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
    position: fixed;
    inset: 0;
    z-index: 10000;
    visibility: hidden;
    opacity: 0;
    color: var(--cfg-ink);
    background: rgba(5, 14, 25, 0.72);
    backdrop-filter: blur(4px);
    transition: opacity 0.22s ease, visibility 0.22s ease;
  }

  config-drawer[open] {
    visibility: visible;
    opacity: 1;
  }

  .cfg-inner {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    width: min(92vw, 144rem);
    height: 100%;
    overflow: hidden;
    flex-direction: column;
    background: #fff;
    box-shadow: -2rem 0 6rem rgba(0, 0, 0, 0.24);
    transform: translateX(100%);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  config-drawer[open] .cfg-inner {
    transform: translateX(0);
  }

  .cfg-header {
    position: relative;
    z-index: 12;
    display: flex;
    min-height: 9.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.6rem clamp(2rem, 3vw, 4.8rem);
    color: #fff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    background: var(--cfg-navy);
  }

  .cfg-heading {
    display: grid;
    gap: 0.25rem;
  }

  .cfg-kicker {
    color: var(--cfg-gold);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .cfg-title {
    font-family: var(--cfg-serif);
    font-size: clamp(2.2rem, 2.4vw, 3.2rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .cfg-guidance {
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .cfg-header button {
    display: grid;
    width: 4.4rem;
    height: 4.4rem;
    flex: 0 0 4.4rem;
    place-items: center;
    padding: 0;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 50%;
    background: transparent;
    font-size: 2.6rem;
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .cfg-header button:hover,
  .cfg-header button:focus-visible {
    color: var(--cfg-navy);
    border-color: var(--cfg-gold);
    outline: none;
    background: var(--cfg-gold);
  }

  .cfg-body {
    display: grid;
    min-height: 0;
    flex: 1;
    grid-template-columns: minmax(32rem, 42%) minmax(0, 58%);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cfg-left {
    position: sticky;
    top: 0;
    display: flex;
    min-height: calc(100vh - 9.2rem);
    height: fit-content;
    align-self: start;
    align-items: center;
    justify-content: center;
    padding: clamp(3rem, 5vw, 8rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 88% 112%, rgba(11, 35, 65, 0.07) 0 25%, transparent 25.2%),
      var(--cfg-paper);
  }

  .cfg-left::before {
    position: absolute;
    top: clamp(2.4rem, 4vw, 5rem);
    left: clamp(2.4rem, 4vw, 5rem);
    content: "BUILT TO YOUR SPECS";
    color: var(--cfg-navy);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .cfg-left::after {
    position: absolute;
    right: clamp(2.4rem, 4vw, 5rem);
    bottom: clamp(11rem, 9vw, 14rem);
    width: 8rem;
    height: 1px;
    content: "";
    background: var(--cfg-gold);
  }

  .cfg-left img {
    position: relative;
    z-index: 1;
    display: block;
    width: min(100%, 58rem);
    height: auto;
    max-height: calc(100vh - 24rem);
    border: 0;
    background: transparent;
    object-fit: contain;
  }

  .cfg-right {
    width: 100%;
    min-width: 0;
    padding: clamp(3rem, 4vw, 6rem) clamp(2.4rem, 4vw, 6rem) 18rem;
    background: #fff;
  }

  .cfg-right form {
    width: min(100%, 82rem);
    margin-inline: auto;
  }

  .cfg-required-note {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 3rem;
    color: var(--cfg-muted);
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .cfg-required-note::before {
    width: 3rem;
    height: 1px;
    content: "";
    background: var(--cfg-gold);
  }

  body.overlay-open {
    height: 100vh;
    overflow: hidden;
  }

  /* Advanced Product Options: visual presentation only. */
  #ConfigDrawer .mw-apo-container {
    padding-bottom: 0 !important;
  }

  #ConfigDrawer .mw-option {
    margin: 0 0 2.8rem !important;
    padding: 0 0 2.8rem !important;
    border-bottom: 1px solid var(--cfg-line);
  }

  #ConfigDrawer .mw-option > .mw-stack > .mw-stack__item:first-child > .mw-stack .mw-label {
    display: inline-block;
    margin: 0 0 1.2rem !important;
    padding: 0 !important;
    color: var(--cfg-navy);
    font-size: 1.45rem !important;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  #ConfigDrawer .mw-text--style-negative {
    color: var(--cfg-gold) !important;
  }

  #ConfigDrawer .mw-accumulated-title {
    color: var(--cfg-muted);
    font-weight: 400;
  }

  #ConfigDrawer .mw-option__container {
    gap: 0.9rem !important;
  }

  #ConfigDrawer .mw-option--type-button .mw-option__container,
  #ConfigDrawer .mw-option--type-multibutton .mw-option__container {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #ConfigDrawer .mw-option__value {
    min-width: 0;
  }

  #ConfigDrawer .mw-option__value .mw-label {
    display: block;
    height: 100%;
    padding: 0 !important;
    cursor: pointer;
  }

  #ConfigDrawer .mw-option--type-button .mw-option__button,
  #ConfigDrawer .mw-option--type-multibutton .mw-option__button {
    display: grid;
    min-height: 5.2rem;
    height: 100%;
    place-items: center;
    padding: 1.2rem 1.4rem !important;
    color: var(--cfg-navy) !important;
    border: 1px solid rgba(11, 35, 65, 0.42) !important;
    border-radius: 0 !important;
    background: #fff !important;
    box-shadow: none !important;
    text-align: center;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  #ConfigDrawer .mw-option--type-button .mw-option__value:hover .mw-option__button,
  #ConfigDrawer .mw-option--type-multibutton .mw-option__value:hover .mw-option__button,
  #ConfigDrawer .mw-option--type-button .mw-label:focus-within .mw-option__button,
  #ConfigDrawer .mw-option--type-multibutton .mw-label:focus-within .mw-option__button {
    border-color: var(--cfg-gold) !important;
    box-shadow: inset 0 -2px 0 var(--cfg-gold) !important;
  }

  #ConfigDrawer .mw-option--type-button .mw-option__value--selected .mw-option__button,
  #ConfigDrawer .mw-option--type-multibutton .mw-option__value--selected .mw-option__button {
    color: #fff !important;
    border-color: var(--cfg-navy) !important;
    background: var(--cfg-navy) !important;
    box-shadow: inset 0 -3px 0 var(--cfg-gold) !important;
  }

  #ConfigDrawer .mw-option--type-button .mw-option__value--selected .mw-text,
  #ConfigDrawer .mw-option--type-multibutton .mw-option__value--selected .mw-text {
    color: inherit !important;
  }

  #ConfigDrawer .mw-option__value-title {
    margin: 0 !important;
    padding: 0 !important;
    font-size: 1.2rem !important;
    font-weight: 700;
    letter-spacing: 0.055em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #ConfigDrawer .mw-option__value .mw-text {
    white-space: normal !important;
  }

  #ConfigDrawer .mw-option__price {
    display: block;
    margin-top: 0.3rem;
    color: inherit !important;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  #ConfigDrawer .mw-option--type-swatch .mw-option__container-horizontal {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem !important;
  }

  #ConfigDrawer .mw-option--type-swatch .mw-option__value {
    width: auto !important;
    overflow: hidden;
    border: 1px solid var(--cfg-line);
    background: #fff;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  #ConfigDrawer .mw-option--type-swatch .mw-option__value:hover,
  #ConfigDrawer .mw-option--type-swatch .mw-option__value:focus-within {
    border-color: var(--cfg-gold);
  }

  #ConfigDrawer .mw-option--type-swatch .mw-option__value--selected {
    border-color: var(--cfg-navy);
    box-shadow: inset 0 -3px 0 var(--cfg-gold);
  }

  #ConfigDrawer .mw-option__swatch-media {
    width: 100% !important;
    min-width: 0 !important;
    aspect-ratio: 1.45 / 1;
    overflow: hidden;
    background: #f4f5f6;
  }

  #ConfigDrawer .mw-option__swatch-image {
    width: 100% !important;
    height: 100% !important;
    padding: 0 !important;
    object-fit: contain !important;
  }

  #ConfigDrawer .mw-option__value--has-horizontal .mw-stack__near {
    margin: 0 !important;
    padding: 1.2rem 1.4rem 1.4rem;
  }

  #ConfigDrawer .mw-option__value--has-horizontal .mw-stack__near .mw-text {
    padding: 0 !important;
  }

  #ConfigDrawer .mw-option__helptext:not(.mw-hidden) {
    margin-top: 1rem;
    padding: 1rem 1.2rem;
    color: #8b2e2e !important;
    border-left: 3px solid #a33d3d;
    background: #fff2f1;
    font-size: 1.2rem;
  }

  #ConfigDrawer .set-section::before,
  #ConfigDrawer .putter-section::before,
  #ConfigDrawer .iron-section::before,
  #ConfigDrawer .shafts-section::before,
  #ConfigDrawer .grip-section::before,
  #ConfigDrawer .stamp-section::before {
    display: block;
    margin: 0 0 2.4rem;
    padding: 0 0 1.4rem;
    color: var(--cfg-navy);
    border-bottom: 1px solid var(--cfg-gold);
    font-family: var(--cfg-serif);
    font-size: clamp(2.3rem, 2.5vw, 3.2rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  #ConfigDrawer .set-section::before { content: "Complete set or heads only"; }
  #ConfigDrawer .putter-section::before { content: "Putter"; }
  #ConfigDrawer .iron-section::before { content: "Irons"; }
  #ConfigDrawer .shafts-section::before { content: "Shafts"; }
  #ConfigDrawer .grip-section::before { content: "Grip"; }
  #ConfigDrawer .stamp-section::before { content: "Custom stamping"; }

  .cfg-footer {
    position: fixed;
    right: 0;
    bottom: 0;
    z-index: 14;
    display: grid;
    width: min(92vw, 144rem);
    min-height: 10.4rem;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 4vw, 6rem);
    padding: 1.4rem clamp(2rem, 3vw, 4.8rem);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    background: var(--cfg-navy);
    box-shadow: 0 -1rem 3rem rgba(11, 35, 65, 0.13);
  }

  .cfg-footer .top-row {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    gap: clamp(2rem, 4vw, 5rem);
  }

  .cfg-footer .cfg-info {
    display: flex;
    min-width: max-content;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cfg-footer .footer-info {
    color: #fff;
    text-align: left;
  }

  .cfg-footer .footer-info .sezzle-shopify-info {
    display: block;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
  }

  .cfg-footer div.sezzle-shopify-info-button {
    color: #fff;
  }

  #ProductPrice {
    color: #fff;
    font-family: var(--cfg-serif);
    font-size: clamp(2.2rem, 2.2vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .cfg-footer .objection-busters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.8rem 2rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }

  .cfg-footer .objection-busters span {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .cfg-footer .objection-busters span::before {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 0.45rem;
    content: "";
    border-radius: 50%;
    background: var(--cfg-gold);
  }

  .cfg-footer .addcartconfig {
    min-width: min(25vw, 30rem);
  }

  .cfg-footer .add-to-cart {
    width: 100%;
    min-height: 5.8rem;
    padding: 1.5rem 2.4rem;
    color: var(--cfg-navy);
    border: 1px solid var(--cfg-gold);
    border-radius: 0;
    background: var(--cfg-gold);
    font-size: 1.15rem;
    font-weight: 800;
