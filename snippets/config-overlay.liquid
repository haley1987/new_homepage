  }

  .cfg-footer .add-to-cart:hover,
  .cfg-footer .add-to-cart:focus-visible {
    color: #fff;
    border-color: #fff;
    outline: none;
    background: var(--cfg-navy-soft);
  }

  body.overlay-open .crisp-client .cc-1brb6 .cc-1yy0g .cc-1m2mf .cc-157aw,
  body.overlay-open .cc-yv368 .cc-1kr6o .cc-18ov6 {
    margin-right: 0 !important;
    margin-bottom: 11rem !important;
  }

  @media (max-width: 990px) {
    .cfg-inner,
    .cfg-footer {
      width: 100vw;
    }

    .cfg-header {
      min-height: 8rem;
      padding: 1.2rem 1.6rem;
    }

    .cfg-title {
      max-width: calc(100vw - 8rem);
      overflow: hidden;
      font-size: clamp(1.9rem, 5vw, 2.5rem);
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .cfg-guidance {
      display: none;
    }

    .cfg-body {
      display: block;
    }

    .cfg-left {
