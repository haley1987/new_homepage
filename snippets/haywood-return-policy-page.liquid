{%- liquid
  assign policy_eyebrow = page_settings.policy_eyebrow | default: 'RETURNS, ORDERS & SHIPPING'
  assign policy_heading = page_settings.policy_heading | default: 'What to know before you order.'
  assign policy_intro = page_settings.policy_intro | default: 'Straight answers about returns, custom builds, order changes, production times and shipping.'
  assign contact_eyebrow = page_settings.policy_contact_eyebrow | default: 'NEED A HAND?'
  assign contact_heading = page_settings.policy_contact_heading | default: 'Questions about your order?'
  assign contact_copy = page_settings.policy_contact_copy | default: 'Our team can confirm eligibility, explain the return process or help with an existing order.'
  assign contact_label = page_settings.policy_contact_label | default: 'EMAIL OUR TEAM'
  assign contact_email = page_settings.policy_contact_email | default: 'info@haywoodgolf.com'
  assign contact_href = 'mailto:' | append: contact_email
-%}

<div class="hwrp" data-hwrp>
  <section class="hwrp__hero" aria-labelledby="hwrp-title">
    <div class="hwrp__shell hwrp__hero-inner">
      <p class="hwrp__eyebrow"><span></span>{{ policy_eyebrow | escape }}</p>
      <h1 id="hwrp-title" class="hwrp__title">{{ policy_heading | escape }}</h1>
      <p class="hwrp__intro">{{ policy_intro | escape }}</p>
    </div>
    {%- render 'haywood-arc-mark', variant: 'return-policy' -%}
  </section>

  <section class="hwrp__summary" aria-label="Policy at a glance">
    <div class="hwrp__summary-grid">
      <article class="hwrp__fact">
        <span class="hwrp__fact-number">30 DAYS</span>
        <div><strong>Stock returns</strong><p>Eligible unused stock products may be returned within 30 days. Approved returns are subject to a 10% restocking fee.</p></div>
      </article>
      <article class="hwrp__fact hwrp__fact--text">
        <span class="hwrp__fact-number">FINAL SALE</span>
        <div><strong>Custom orders</strong><p>Custom-built and limited-edition products cannot be returned.</p></div>
      </article>
      <article class="hwrp__fact">
        <span class="hwrp__fact-number">2.5–4 WEEKS</span>
        <div><strong>Typical build time</strong><p>Custom orders are assembled in the order they are received.</p></div>
      </article>
      <article class="hwrp__fact hwrp__fact--text">
        <span class="hwrp__fact-number">TRACKED</span>
        <div><strong>Insured shipping</strong><p>Estimated delivery is 1–8 business days after dispatch. A signature is required.</p></div>
      </article>
    </div>
  </section>

  <section class="hwrp__details" aria-labelledby="hwrp-details-title">
    <div class="hwrp__shell">
      <div class="hwrp__details-heading">
        <p class="hwrp__section-label">POLICY DETAILS</p>
        <h2 id="hwrp-details-title">Everything you need to know.</h2>
      </div>

      <div class="hwrp__details-grid">
        <aside class="hwrp__nav-wrap">
          <p class="hwrp__nav-label">ON THIS PAGE</p>
          <nav class="hwrp__nav" data-hwrp-nav aria-label="Return policy sections"></nav>
        </aside>

        <div class="hwrp__policy rte" data-hwrp-policy>
          {{ page.content }}
        </div>
      </div>
    </div>
  </section>

  <section class="hwrp__contact" aria-labelledby="hwrp-contact-title">
    <div class="hwrp__shell hwrp__contact-inner">
      <div>
        <p class="hwrp__contact-eyebrow">{{ contact_eyebrow | escape }}</p>
        <h2 id="hwrp-contact-title">{{ contact_heading | escape }}</h2>
        <p>{{ contact_copy | escape }}</p>
      </div>
      <a class="hwrp__button" href="{{ contact_href }}">{{ contact_label | escape }} <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>
