{% comment %}Product-family overview refresh.{% endcomment %}
{%- liquid
  assign description_parts = product.description | split: '<!-- bullets -->'
  assign overview_intro = product.description
  assign overview_benefits = blank
  assign overview_compare = blank

  if description_parts.size > 1
    assign detail_parts = description_parts[1] | split: '<!-- details -->'
    assign overview_intro = description_parts[0]
    assign overview_benefits = detail_parts[0]
    if detail_parts.size > 1
      assign overview_compare = detail_parts[1]
    endif
  endif

  assign overview_heading = 'Built around the way you play.'
  assign shop_app_warning = '⚠️ Important: Options may not appear in the Shop App. Please view this product on our website to select your custom options before purchasing.'
  assign overview_summary = overview_intro | strip_html | replace: shop_app_warning, '' | strip | truncatewords: 58

  assign is_seven_iron_program = false
  if product.handle == '7-iron-purchase-program'
    assign is_seven_iron_program = true
  endif

  assign is_heads_only = false
  if product.tags contains 'headsonly' or product.title contains 'Heads Only' or product.title contains 'Head Only'
    assign is_heads_only = true
  endif

  assign is_complete_set = false
  if product.title contains 'Complete Set'
    assign is_complete_set = true
  endif

  assign is_driving_iron = false
  if product.title contains 'Driving Iron' or product.title contains 'DI.2'
    assign is_driving_iron = true
  endif

  assign is_wedge = false
  if product.title contains 'Wedge'
    assign is_wedge = true
  endif

  assign is_wood = false
  if product.title contains 'Driver' or product.title contains 'Fairway' or product.title contains 'Hybrid'
    assign is_wood = true
  endif

  assign is_putter = false
  if product.title contains 'Putter'
    assign is_putter = true
  endif

  assign is_golf_bag = false
  if product.handle == 'premium-golf-stand-bag' or product.title contains 'Golf Bag'
    assign is_golf_bag = true
  endif

  if is_seven_iron_program
    assign overview_heading = 'Try one before you build the set.'
    assign overview_summary = 'Choose your model, shaft, grip and adjustments, then put your custom-built 7-iron into play. When you are ready to order a qualifying full set, the 7-iron purchase price is applied to that build.'
  elsif is_complete_set
    assign overview_heading = 'One coordinated set. Built around you.'
  elsif is_heads_only
    assign overview_heading = 'Haywood performance, ready for your build.'
  elsif is_driving_iron
    assign overview_heading = 'Controlled flight. Confident distance.'
  elsif is_wedge
    assign overview_heading = 'Versatility where scoring happens.'
    assign overview_summary = 'Forged from S20C carbon steel with CNC-milled grooves and versatile sole shaping, Signature Wedges are built for predictable flight, spin and touch—from full swings to greenside shots.'
  elsif is_golf_bag
    assign overview_heading = 'Built to carry the full round.'
    assign overview_summary = 'A stable six-way stand bag with comfortable dual straps, protected storage and the details needed from the first tee to the final green.'
  elsif is_wood
    assign overview_heading = 'Launch, speed and stability—dialled in.'
  elsif is_putter
    assign overview_heading = 'Milled feel. Purposeful alignment.'
  elsif product.title contains 'SV.2'
    assign overview_heading = 'Distance and forgiveness, refined.'
    assign overview_summary = 'SV.2 blends game-improvement forgiveness with a more refined profile. A 431 body, S450 face and injected foam are engineered for faster ball speed, softer feel and more consistent sound. Progressive offset adds confidence in the long irons without sacrificing control in the scoring clubs.'
  elsif product.title contains 'PD.1'
    assign overview_heading = 'Speed in a player’s profile.'
  elsif product.title contains 'CB'
    assign overview_heading = 'Forged control with added stability.'
  elsif product.title contains 'MB'
    assign overview_heading = 'Pure feedback. Total control.'
  endif

  assign is_iron = false
  if product.type contains 'Iron' or product.title contains 'Iron' or product.title contains 'CB' or product.title contains 'MB' or product.title contains 'PD.1' or product.title contains 'SV.2'
    assign is_iron = true
  endif

  assign show_iron_compare = is_iron
  if is_seven_iron_program or is_heads_only or is_complete_set or is_driving_iron
    assign show_iron_compare = false
  endif

  assign buybox_summary = 'Purpose-built performance, configured around the way you play.'
  if is_seven_iron_program
    assign buybox_summary = 'Order one custom-built 7-iron, then apply its purchase price to a qualifying full set.'
  elsif is_complete_set
    assign buybox_summary = 'A coordinated club setup, configured around the way you play from tee to green.'
  elsif is_heads_only
    assign buybox_summary = 'Haywood performance without the standard build, ready for your preferred components.'
  elsif is_driving_iron
    assign buybox_summary = 'Controlled distance and a confident flight from the tee or turf.'
  elsif is_wedge
    assign buybox_summary = 'Forged feel and versatile sole geometry for flight, spin and touch.'
  elsif is_golf_bag
    assign buybox_summary = 'A refined six-way stand bag with considered storage, balanced carrying comfort and weather-ready protection.'
  elsif is_wood
    assign buybox_summary = 'Adjustable performance and dependable launch, built around your preferred setup.'
  elsif is_putter
    assign buybox_summary = 'Precision-milled feedback and balanced weighting for a repeatable stroke.'
  elsif product.title contains 'CB'
    assign buybox_summary = 'A compact cavity profile balancing forged feel, control and forgiveness.'
  elsif product.title contains 'MB'
    assign buybox_summary = 'A muscle-back profile created for feedback, precision and workability.'
  elsif product.title contains 'PD.1'
    assign buybox_summary = 'Players distance performance in a clean, confidence-inspiring profile.'
  elsif product.title contains 'SV.2'
    assign buybox_summary = 'Forgiveness, launch and speed for golfers who want help without excess bulk.'
  endif
-%}

<section
  class="hw-product-overview"
  aria-labelledby="ProductOverview-{{ product.id }}"
  data-buybox-summary="{{ buybox_summary | escape }}"
  data-show-iron-guidance="{{ show_iron_compare }}"
>
  <div class="hw-product-overview__shell">
    <div class="hw-product-overview__lead">
      <p class="hw-product-overview__eyebrow">Performance overview</p>
      <h2 id="ProductOverview-{{ product.id }}">{{ overview_heading }}</h2>
      <div class="hw-product-overview__intro rte">
        <p>{{ overview_summary }}</p>
        <details class="hw-product-overview__story">
          <summary>Read the full product story</summary>
          <div class="rte">{{ overview_intro }}</div>
        </details>
      </div>
    </div>

    {%- if is_wedge -%}
      <div class="hw-product-overview__wedge-guide" aria-labelledby="WedgeGuide-{{ product.id }}">
        <div class="hw-product-overview__wedge-heading">
          <p class="hw-product-overview__eyebrow">Build your scoring setup</p>
          <h3 id="WedgeGuide-{{ product.id }}">Choose your loft.</h3>
        </div>
        <div class="hw-product-overview__wedge-options">
          <article>
            <span>48°–52°</span>
            <strong>8°–10° bounce</strong>
            <p>Bridge the distance between your iron set and higher-lofted scoring wedges.</p>
          </article>
          <article>
            <span>54°–56°</span>
            <strong>12° bounce</strong>
            <p>A versatile choice for approach shots, controlled pitches and bunker play.</p>
          </article>
          <article>
            <span>58°–60°</span>
            <strong>10° bounce</strong>
            <p>Add height and touch when the shot calls for more greenside control.</p>
          </article>
        </div>
      </div>
    {%- endif -%}

    {%- if is_golf_bag -%}
      <div class="hw-product-overview__bag-guide" aria-labelledby="BagGuide-{{ product.id }}">
        <div class="hw-product-overview__bag-heading">
          <p class="hw-product-overview__eyebrow">Designed for the round</p>
          <h3 id="BagGuide-{{ product.id }}">Everything in its place.</h3>
        </div>

        <div class="hw-product-overview__bag-features">
          <article>
            <span>01</span>
            <strong>Six-way protection</strong>
            <p>A velvet-wrapped divider and reinforced base help protect and organize every club.</p>
          </article>
          <article>
            <span>02</span>
            <strong>Balanced carrying</strong>
            <p>Padded dual straps use easy-release clasps for comfortable adjustment.</p>
          </article>
          <article>
            <span>03</span>
            <strong>Fast access</strong>
            <p>A velvet-lined magnetic pocket keeps your rangefinder close at hand.</p>
          </article>
          <article>
            <span>04</span>
            <strong>Protected storage</strong>
            <p>A waterproof valuables pocket and water-resistant cooler compartment secure essentials.</p>
          </article>
          <article>
            <span>05</span>
            <strong>Stable stance</strong>
            <p>Carbon-fibre legs and a stability base provide dependable support on uneven ground.</p>
          </article>
          <article>
            <span>06</span>
            <strong>Weather ready</strong>
            <p>An included rain hood helps keep your clubs protected when conditions change.</p>
          </article>
        </div>

        <dl class="hw-product-overview__bag-specs">
          <div><dt>Weight</dt><dd>6.6 lb</dd></div>
          <div><dt>Bag dimensions</dt><dd>35 × 12 × 13 in</dd></div>
          <div><dt>Top dimensions</dt><dd>9 × 11 in</dd></div>
        </dl>
      </div>
    {%- endif -%}

    {%- if overview_benefits != blank -%}
      <div class="hw-product-overview__benefits rte">
        {{ overview_benefits }}
      </div>
    {%- endif -%}

    {%- if show_iron_compare -%}
      <div class="hw-product-overview__compare">
        <div class="hw-product-overview__compare-copy">
          <p class="hw-product-overview__eyebrow">Compare the lineup</p>
          <h3>See where {{ display_title }} fits.</h3>
          <p>Compare forgiveness, launch, workability and player profile across the Haywood iron lineup.</p>
          <a href="/pages/iron-selection">Compare all irons <span aria-hidden="true">→</span></a>
        </div>
        <div class="hw-product-overview__compare-art rte">
          {%- if overview_compare != blank -%}
            {{ overview_compare }}
          {%- else -%}
            {% render 'haywood-arc-mark', variant: 'product-compare' %}
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <script>
    (() => {
      const overview = document.currentScript.closest('.hw-product-overview');
      const productShell = overview && overview.closest('.hw-product-shell');
      const productInfo = productShell && productShell.querySelector('.product__info-container');
      if (!productInfo) return;

      const summary = productInfo.querySelector('.hw-product-summary');
      if (summary && overview.dataset.buyboxSummary) {
        summary.textContent = overview.dataset.buyboxSummary;
      }

      if (overview.dataset.showIronGuidance !== 'true' || productInfo.querySelector('.hw-product-guidance')) return;
      const ctas = productInfo.querySelector('.hw-ctas');
      if (!ctas) return;

      const guidance = document.createElement('nav');
      guidance.className = 'hw-product-guidance';
      guidance.setAttribute('aria-label', 'Iron selection help');

      const links = [
        { href: '/pages/fitting-tool', label: 'Find My Fit' },
        { href: '/pages/iron-selection', label: 'Compare irons' }
      ];

      links.forEach(({ href, label }) => {
        const link = document.createElement('a');
        link.className = 'hw-quiz-link';
        link.href = href;
        link.append(document.createTextNode(`${label} `));
        const arrow = document.createElement('span');
        arrow.setAttribute('aria-hidden', 'true');
        arrow.textContent = '→';
        link.append(arrow);
        guidance.append(link);
      });

      ctas.append(guidance);
    })();
  </script>
</section>
