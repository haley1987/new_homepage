{%- comment -%}
  Breadcrumb structured data for indexable storefront content. The visible
  breadcrumb remains in snippets/breadcrumbs.liquid; this gives search engines
  the same hierarchy in a machine-readable form.
{%- endcomment -%}

{%- liquid
  assign breadcrumb_supported = false
  assign breadcrumb_collection = nil

  if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'blog' or request.page_type == 'article' or request.page_type == 'page' or request.page_type == 'list-collections'
    assign breadcrumb_supported = true
  endif

  if request.page_type == 'collection' and collection
    assign breadcrumb_collection = collection
  elsif request.page_type == 'product'
    if collection
      assign breadcrumb_collection = collection
    else
      assign breadcrumb_collection = product.collections | reject: 'handle', 'all' | first
    endif
  endif
-%}

{%- if breadcrumb_supported -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | append: routes.root_url | json }}
        }
        {%- if request.page_type == 'product' -%}
          {%- if breadcrumb_collection -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ breadcrumb_collection.title | strip_html | json }},
              "item": {{ request.origin | append: breadcrumb_collection.url | json }}
            },{
              "@type": "ListItem",
              "position": 3,
              "name": {{ product.title | strip_html | json }},
              "item": {{ canonical_url | json }}
            }
          {%- else -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.title | strip_html | json }},
              "item": {{ canonical_url | json }}
            }
          {%- endif -%}
        {%- elsif request.page_type == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | strip_html | json }},
            "item": {{ canonical_url | json }}
          }
        {%- elsif request.page_type == 'article' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | strip_html | json }},
            "item": {{ request.origin | append: blog.url | json }}
          },{
            "@type": "ListItem",
            "position": 3,
            "name": {{ article.title | strip_html | json }},
            "item": {{ canonical_url | json }}
          }
        {%- elsif request.page_type == 'blog' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | strip_html | json }},
            "item": {{ canonical_url | json }}
          }
        {%- elsif request.page_type == 'page' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | strip_html | json }},
            "item": {{ canonical_url | json }}
          }
        {%- elsif request.page_type == 'list-collections' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": "Collections",
            "item": {{ canonical_url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
