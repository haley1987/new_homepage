{% comment %}
  Product-page community media. Each numbered slot renders one item only,
  in the order image → video → Instagram, so duplicate metafields cannot
  create accidental extra cards.
{% endcomment %}

{% assign ugc_count = 0 %}
{% for i in (1..5) %}
  {% assign img_key = 'ugc_image_' | append: i %}
  {% assign vid_key = 'ugc_video_url_' | append: i %}
  {% assign ig_key = 'ugc_instagram_' | append: i %}
  {% assign img = product.metafields.custom[img_key] %}
  {% assign video_url = product.metafields.custom[vid_key].value %}
  {% assign instagram_url = product.metafields.custom[ig_key].value %}

  {% if img.value != blank or video_url != blank or instagram_url != blank %}
    {% assign ugc_count = ugc_count | plus: 1 %}
  {% endif %}
{% endfor %}

{% if ugc_count > 0 %}
  <section class="ugc-gallery" aria-labelledby="ugc-gallery-title-{{ section.id }}">
    <div class="ugc-gallery__header">
      <div>
        <p class="ugc-gallery__eyebrow">Haywood in play</p>
        <h2 id="ugc-gallery-title-{{ section.id }}" class="ugc-gallery__title">From our players.</h2>
      </div>
      <p class="ugc-gallery__intro">Real builds, real swings and stories from the Haywood community.</p>
    </div>

    <div class="ugc-gallery__track" data-count="{{ ugc_count }}">
      {% for i in (1..5) %}
        {% assign img_key = 'ugc_image_' | append: i %}
        {% assign vid_key = 'ugc_video_url_' | append: i %}
        {% assign ig_key = 'ugc_instagram_' | append: i %}
        {% assign img = product.metafields.custom[img_key] %}
        {% assign video_url = product.metafields.custom[vid_key].value %}
        {% assign instagram_url = product.metafields.custom[ig_key].value %}

        {% if img.value != blank %}
          <figure class="ugc-gallery__card ugc-gallery__card--image">
            <img
              src="{{ img | file_url }}"
              alt="Player using {{ product.title | escape }}"
              width="1200"
              height="1500"
              loading="lazy"
              decoding="async"
            >
          </figure>
        {% elsif video_url != blank %}
          {% assign video_id = '' %}
          {% if video_url contains 'youtube.com/watch' %}
            {% assign video_id = video_url | split: 'v=' | last | split: '&' | first %}
          {% elsif video_url contains 'youtu.be/' %}
            {% assign video_id = video_url | split: '/' | last | split: '?' | first %}
          {% elsif video_url contains '/shorts/' %}
            {% assign video_id = video_url | split: '/shorts/' | last | split: '?' | first %}
          {% endif %}

          <figure class="ugc-gallery__card ugc-gallery__card--video">
            {% if video_id != blank %}
              <iframe
                src="https://www.youtube.com/embed/{{ video_id }}?rel=0"
                title="Player video featuring {{ product.title | escape }}"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            {% elsif video_url contains 'facebook.com' %}
              {% assign facebook_url = video_url %}
              {% assign last_character = facebook_url | slice: -1 %}
              {% if last_character != '/' %}
                {% assign facebook_url = facebook_url | append: '/' %}
              {% endif %}
              <iframe
                src="https://www.facebook.com/plugins/video.php?href={{ facebook_url | url_encode }}&show_text=false"
                title="Player video featuring {{ product.title | escape }}"
                loading="lazy"
                scrolling="no"
                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            {% else %}
              <video src="{{ video_url }}" controls playsinline preload="metadata">
                Your browser does not support HTML5 video.
              </video>
            {% endif %}
          </figure>
        {% elsif instagram_url != blank %}
          <figure class="ugc-gallery__card ugc-gallery__card--instagram">
            <blockquote
              class="instagram-media"
              data-instgrm-permalink="{{ instagram_url }}"
              data-instgrm-version="14"
            ></blockquote>
          </figure>
        {% endif %}
      {% endfor %}
    </div>

    {% if ugc_count > 1 %}
      <p class="ugc-gallery__swipe" aria-hidden="true">Swipe <span>→</span></p>
    {% endif %}
  </section>

  <script>
    (() => {
      const section = document.currentScript.previousElementSibling;
      if (!section || !section.querySelector('.instagram-media')) return;

      const loadInstagram = () => {
        if (window.instgrm?.Embeds?.process) {
          window.instgrm.Embeds.process();
          return;
        }
        if (document.querySelector('script[data-haywood-instagram]')) return;
        const script = document.createElement('script');
        script.src = 'https://www.instagram.com/embed.js';
        script.async = true;
        script.dataset.haywoodInstagram = 'true';
        document.body.appendChild(script);
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          loadInstagram();
        }, { rootMargin: '300px 0px' });
        observer.observe(section);
      } else {
        loadInstagram();
      }
    })();
  </script>
{% endif %}

{% style %}
  .ugc-gallery {
    width: min(calc(100% - 4rem), 150rem);
    margin: clamp(5rem, 8vw, 9rem) auto;
  }

  .ugc-gallery__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(28rem, .7fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 2.4rem;
  }

  .ugc-gallery__eyebrow {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin: 0 0 1rem;
    color: #0b2a4b;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .ugc-gallery__eyebrow::before {
    width: 3.2rem;
    height: 1px;
    content: '';
    background: #c9a66b;
  }

  .ugc-gallery__title {
    margin: 0;
    color: #0b2a4b;
    font-family: var(--font-heading-family);
    font-size: clamp(3.6rem, 4.5vw, 6.2rem);
    font-weight: 400;
    line-height: .98;
  }

  .ugc-gallery__intro {
    max-width: 46rem;
    margin: 0 0 .4rem auto;
    color: #5f625f;
    font-size: 1.6rem;
    line-height: 1.6;
  }

  .ugc-gallery__track {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1.2rem;
  }

  .ugc-gallery__card {
    position: relative;
    min-width: 0;
    aspect-ratio: 4 / 5;
    margin: 0;
    overflow: hidden;
    border: 1px solid #d8d8d4;
    background: linear-gradient(145deg, #e9e9e5, #d7d8d7);
  }

  .ugc-gallery__card::after {
    position: absolute;
    inset: auto 0 0;
    height: 18%;
    content: '';
    pointer-events: none;
    background: linear-gradient(transparent, rgba(3, 16, 29, .24));
  }

  .ugc-gallery__card > img,
  .ugc-gallery__card > video,
  .ugc-gallery__card > iframe,
  .ugc-gallery__card > .instagram-media,
  .ugc-gallery__card > .instagram-media-rendered {
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    width: 100% !important;
    max-width: none !important;
    height: 100% !important;
    min-width: 0 !important;
    margin: 0 !important;
    border: 0 !important;
  }

  .ugc-gallery__card > img,
  .ugc-gallery__card > video {
    object-fit: cover;
  }

  .ugc-gallery__card--video {
    background: #071726;
  }

  .ugc-gallery__swipe {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ugc-gallery {
      width: 100%;
      margin: 4.5rem 0;
    }

    .ugc-gallery__header {
      display: block;
      padding: 0 1.5rem;
      margin-bottom: 1.8rem;
    }

    .ugc-gallery__title {
      font-size: clamp(3.4rem, 12vw, 4.8rem);
    }

    .ugc-gallery__intro {
      margin: 1.4rem 0 0;
      font-size: 1.5rem;
    }

    .ugc-gallery__track {
      display: flex;
      gap: 1rem;
      padding: 0 1.5rem 1.2rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-padding-inline: 1.5rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .ugc-gallery__track::-webkit-scrollbar {
      display: none;
    }

    .ugc-gallery__card {
      flex: 0 0 82vw;
      max-width: 34rem;
      scroll-snap-align: start;
    }

    .ugc-gallery__swipe {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
      margin: .6rem 1.5rem 0;
      color: #0b2a4b;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
    }

    .ugc-gallery__swipe::before {
      width: 3rem;
      height: 1px;
      content: '';
      background: #c9a66b;
    }

    .ugc-gallery__swipe span {
      color: #c9a66b;
      font-size: 1.8rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Haywood • UGC gallery",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [{ "name": "Haywood • UGC gallery" }]
}
{% endschema %}
