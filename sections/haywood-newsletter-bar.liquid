<section
  class="hw-section hw-newsletter"
  style="--hw-section-background: {{ section.settings.background_color | default: '#0b2341' }}; --hw-heading-color: {{ section.settings.heading_color | default: '#f2eee5' }}; --hw-text-color: {{ section.settings.text_color | default: '#c7cfda' }};"
>
  <div class="hw-shell hw-newsletter__inner">
    <div class="hw-newsletter__message">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium hw-newsletter__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.copy != blank -%}<p class="hw-copy">{{ section.settings.copy | escape }}</p>{%- endif -%}
    </div>

    {%- form 'customer', id: 'HaywoodNewsletter', class: 'hw-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="hw-newsletter__fields">
        <label class="visually-hidden" for="HaywoodNewsletterEmail-{{ section.id }}">Email address</label>
        <input
          id="HaywoodNewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="Email address"
          required
        >
        <button type="submit" name="commit">{{ section.settings.button_label | escape }}</button>
      </div>
      {%- if form.errors -%}<div class="hw-newsletter__status" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      {%- if form.posted_successfully? -%}<p class="hw-newsletter__status" role="status">Thanks for subscribing.</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Haywood newsletter bar",
  "settings": [
    { "type": "header", "content": "Content colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#0b2341" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#f2eee5" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#c7cfda" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From Haywood" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better golf, delivered." },
    { "type": "textarea", "id": "copy", "label": "Copy", "default": "New releases, fitting knowledge and stories from the workshop—sent occasionally." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Haywood newsletter bar" }]
}
{% endschema %}
