{% comment %}Haywood product proof layout — compact editorial treatment.{% endcomment %}
{% assign points = product.metafields.custom.why_players_list.value %}
{% assign total  = points.size %}
{% assign display_title = product.title | remove: ' (Game Improvement Model)' | remove: ' (Players Distance Model)' | remove: ' (Players Cavity Model)' | remove: ' (Muscle Back Model)' | remove: ' Irons' | strip %}
{% if product.title contains 'CB2' and product.title contains 'MB2' %}
  {% assign display_title = 'CB2 + MB2 Combo' %}
{% elsif product.title contains 'CB2' %}
  {% assign display_title = 'CB2' %}
{% elsif product.title contains 'MB2' %}
  {% assign display_title = 'MB2' %}
{% elsif product.title contains 'SV.2' and product.title contains 'PD.1' %}
  {% assign display_title = 'SV.2 + PD.1 Combo' %}
{% elsif product.title contains 'PD.1' %}
  {% assign display_title = 'PD.1' %}
{% elsif product.title contains 'SV.2' %}
  {% assign display_title = 'SV.2' %}
{% elsif product.handle == '7-iron-purchase-program' %}
  {% assign display_title = 'the 7-Iron Program' %}
{% endif %}

{% if points and total > 1 %}
  <section class="why-players" aria-labelledby="WhyPlayers-{{ section.id }}">
    <div class="why-players__header">
      <p class="why-players__eyebrow">Why this model</p>
      <h2 class="why-players__title" id="WhyPlayers-{{ section.id }}">Why players choose {{ display_title }}.</h2>
    </div>
    <div class="why-players__grid">
      {% for point in points %}
        {% assign idx = forloop.index0 %}
        {% assign mod = idx | modulo: 2 %}
        {% if mod == 0 %}
          {% assign heading_raw = points[idx] %}
          {% assign next_idx    = idx | plus: 1 %}
          {% assign desc        = points[next_idx] %}

          {% if heading_raw and desc %}
            {% assign parts = heading_raw | split: ' ' %}
            {% assign emoji = parts[0] %}
            {% assign title = heading_raw | remove_first: emoji | strip %}
            {% assign pair_index = idx | divided_by: 2 | plus: 1 %}

            <article class="why-point">
              <span class="why-point__index" aria-hidden="true">{% if pair_index < 10 %}0{% endif %}{{ pair_index }}</span>
              <h3 class="why-point__title">{{ title }}</h3>
              <p class="why-point__text">{{ desc }}</p>
            </article>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Why players choose",
  "settings": [
    
  ]
}
{% endschema %}
