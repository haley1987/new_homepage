<section class="hw-section hw-product-explorer" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="hw-shell hw-product-explorer__header">
    {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.copy != blank -%}<div class="hw-copy">{{ section.settings.copy }}</div>{%- endif -%}
  </div>

  <div class="hw-product-explorer__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign card_link = block.settings.manual_link
        if card_link == blank and block.settings.product != blank
          assign card_link = block.settings.product.url
        endif
        if card_link == blank and block.settings.collection != blank
          assign card_link = block.settings.collection.url
        endif
        assign card_image = block.settings.image
        if card_image == blank and block.settings.product != blank
          assign card_image = block.settings.product.featured_image
        endif
        if card_image == blank and block.settings.collection != blank
          assign card_image = block.settings.collection.featured_image
        endif
      -%}
      <article class="hw-product-card" {{ block.shopify_attributes }}>
        <div class="hw-product-card__media">
          {%- if card_image != blank -%}
            {{ card_image | image_url: width: 1400 | image_tag: widths: '550, 750, 1000, 1200, 1400', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 82vw', loading: 'lazy' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="hw-product-card__content">
          {%- if block.settings.category != blank -%}<p class="hw-product-card__category">{{ block.settings.category | escape }}</p>{%- endif -%}
          <h3 class="hw-product-card__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.fit != blank -%}<p class="hw-product-card__fit">{{ block.settings.fit | escape }}</p>{%- endif -%}
        </div>
        {%- if card_link != blank -%}<a class="hw-card-link" href="{{ card_link }}"><span class="visually-hidden">Explore {{ block.settings.title | escape }}</span></a>{%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Haywood product explorer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Explore the lineup" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built around the way you play." },
    { "type": "richtext", "id": "copy", "label": "Supporting copy", "default": "<p>Different shapes. Different flights. The same commitment to feel and precision.</p>" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Explore Haywood golf clubs" }
  ],
  "blocks": [
    { "type": "card", "name": "Product family", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "CB2" },
      { "type": "text", "id": "category", "label": "Category", "default": "Players cavity" },
      { "type": "textarea", "id": "fit", "label": "Golfer-fit context", "default": "Forgiveness and control without losing the feedback better players expect." },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "url", "id": "manual_link", "label": "Manual link" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Haywood product explorer", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
