<section class="hw-section hw-story" style="--hw-story-position: {{ section.settings.image_position }};">
  <div class="hw-shell hw-story__grid">
    <div class="hw-story__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '550, 750, 1100, 1400, 1600', sizes: '(min-width: 750px) 52vw, 100vw', loading: 'lazy' }}
      {%- else -%}
        <div class="hw-purpose-placeholder hw-purpose-placeholder--editorial" data-image-purpose="WHY HAYWOOD PHOTOGRAPHY">
          <span>WHY HAYWOOD PHOTOGRAPHY</span>
        </div>
      {%- endif -%}
    </div>
    <div class="hw-story__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="hw-copy">{{ section.settings.intro }}</div>{%- endif -%}
      <div class="hw-story__rows">
        {%- for block in section.blocks -%}
          <details class="hw-story__row" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.title | escape }}</summary>
            <p>{{ block.settings.copy | escape }}</p>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [
      { "value": "left top", "label": "Left top" }, { "value": "center top", "label": "Center top" }, { "value": "right top", "label": "Right top" },
      { "value": "left center", "label": "Left center" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right center" },
      { "value": "left bottom", "label": "Left bottom" }, { "value": "center bottom", "label": "Center bottom" }, { "value": "right bottom", "label": "Right bottom" }
    ], "default": "center center" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Haywood" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Advice without an agenda." },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>We explain the tradeoffs, build to your specifications, and let performance guide the decision.</p>" }
  ],
  "blocks": [
    { "type": "row", "name": "Story row", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Objective Before Opinion" },
      { "type": "textarea", "id": "copy", "label": "Copy", "default": "Recommendations are earned through data, not manufacturer preference." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Haywood story", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
