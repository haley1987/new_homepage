<section class="hw-section hw-education">
  <div class="hw-shell">
    <header class="hw-education__header">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </header>

    <div class="hw-education__layout">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_article = block.settings.article
          assign card_image = block.settings.image | default: card_article.image
          assign card_title = block.settings.title | default: card_article.title
          assign card_excerpt = block.settings.excerpt
          if card_excerpt == blank and card_article != blank
            assign card_excerpt = card_article.excerpt_or_content | strip_html | truncatewords: 24
          endif
          assign card_link = block.settings.link | default: card_article.url
        -%}
        {%- if forloop.index == 2 -%}<div class="hw-education__supporting" aria-label="More journal articles">{%- endif -%}
        <article class="hw-education-card {% if forloop.first %}hw-education-card--featured{% else %}hw-education-card--supporting{% endif %}" {{ block.shopify_attributes }}>
          {%- if card_link != blank -%}<a class="hw-education-card__inner hw-education-card__link" href="{{ card_link }}">{%- else -%}<div class="hw-education-card__inner">{%- endif -%}
            <div class="hw-education-card__media">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 1600 | image_tag: widths: '550, 750, 1100, 1400, 1600', sizes: '(min-width: 990px) 55vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
              {%- else -%}
                <div class="hw-education-card__placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <div class="hw-education-card__content">
              {%- if card_title != blank -%}<h3 class="hw-education-card__title">{{ card_title | escape }}</h3>{%- endif -%}
              {%- if card_excerpt != blank -%}<p class="hw-education-card__excerpt">{{ card_excerpt | escape }}</p>{%- endif -%}
            </div>
          {%- if card_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </article>
        {%- if forloop.last and forloop.index > 1 -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood education",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Learn before you choose." }
  ],
  "blocks": [
    { "type": "card", "name": "Editorial card", "settings": [
      { "type": "article", "id": "article", "label": "Article" },
      { "type": "image_picker", "id": "image", "label": "Manual image" },
      { "type": "text", "id": "title", "label": "Manual title", "default": "Blade or cavity back?" },
      { "type": "textarea", "id": "excerpt", "label": "Manual excerpt", "default": "Understand how shape, mass and feedback change the way an iron performs." },
      { "type": "url", "id": "link", "label": "Manual link" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Haywood education", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
