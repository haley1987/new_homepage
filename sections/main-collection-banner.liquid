{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'haywood-commerce.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hw_is_accessories_collection = false
  if collection.handle == 'merch' or collection.title contains 'Accessories' or collection.title contains 'Merch'
    assign hw_is_accessories_collection = true
  endif

  assign hw_collection_eyebrow = section.settings.eyebrow
  assign hw_collection_description = section.settings.fallback_description
  assign hw_collection_aside = section.settings.aside_copy
  assign hw_collection_count_label = 'models'
  if collection.products_count == 1
    assign hw_collection_count_label = 'model'
  endif

  if hw_is_accessories_collection
    assign hw_collection_eyebrow = 'Accessories and apparel'
    assign hw_collection_description = 'Course-ready essentials, thoughtful tools and Haywood apparel for on and off the golf course.'
    assign hw_collection_aside = 'Useful details, clean design and everyday pieces made to carry the Haywood identity.'
    assign hw_collection_count_label = 'items'
    if collection.products_count == 1
      assign hw_collection_count_label = 'item'
    endif
  endif
-%}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<section class="hw-commerce hw-collection-hero{% if hw_is_accessories_collection %} hw-collection-hero--minimal{% endif %}" aria-labelledby="CollectionHeading-{{ section.id }}">
  <div class="hw-collection-hero__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="hw-collection-hero__main">
      <div>
        <p class="hw-collection-hero__eyebrow">{{ hw_collection_eyebrow | escape }}</p>
        <h1 class="hw-collection-hero__title" id="CollectionHeading-{{ section.id }}">
          <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
          {{- collection.title | escape -}}
        </h1>

        {%- if section.settings.show_collection_description -%}
          <div class="hw-collection-hero__description rte">
            {%- if collection.description != blank -%}
              {{ collection.description }}
            {%- else -%}
              <p>{{ hw_collection_description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- unless hw_is_accessories_collection -%}
        <div class="hw-collection-hero__aside">
          <p class="hw-collection-hero__count">{{ collection.products_count }} {{ hw_collection_count_label }}</p>
          <p class="hw-collection-hero__aside-copy">{{ hw_collection_aside | escape }}</p>
        </div>
      {%- endunless -%}
    </div>

    {%- if section.settings.show_decision_links and hw_is_accessories_collection == false -%}
      <nav class="hw-collection-hero__links" aria-label="Shop and fitting tools">
        <a class="hw-collection-hero__link" href="{{ routes.all_products_collection_url }}">Shop all clubs</a>
        <a class="hw-collection-hero__link" href="/pages/fitting-tool">Find My Fit</a>
        <a class="hw-collection-hero__link" href="/pages/fitting-tool?view=iron-Selection">Compare irons</a>
      </nav>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Haywood lineup"
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback description",
      "default": "Purpose-built golf equipment, configured around the way you play."
    },
    {
      "type": "text",
      "id": "aside_copy",
      "label": "Model count supporting copy",
      "default": "Compare the lineup, then configure the model that fits your game."
    },
    {
      "type": "checkbox",
      "id": "show_decision_links",
      "default": true,
      "label": "Show shopping and fitting links"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
