{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'haywood-commerce.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hw_is_accessories_collection = false
  if collection.handle == 'merch' or collection.title contains 'Accessories' or collection.title contains 'Merch'
    assign hw_is_accessories_collection = true
  endif

  assign hw_is_lab_collection = false
  if collection.handle == 'the-lab' or collection.title == 'The Lab' or request.path contains '/collections/the-lab'
    assign hw_is_lab_collection = true
  endif

  assign hw_is_irons_collection = false
  if collection.handle == 'golf-irons' or request.path contains '/collections/golf-irons'
    assign hw_is_irons_collection = true
  endif

  assign hw_is_woods_collection = false
  if collection.handle == 'drivers-fairway-woods-hybrids' or request.path contains '/collections/drivers-fairway-woods-hybrids'
    assign hw_is_woods_collection = true
  endif

  assign hw_is_putters_collection = false
  if collection.handle == 'golf-putters' or request.path contains '/collections/golf-putters'
    assign hw_is_putters_collection = true
  endif

  assign hw_is_heads_only_collection = false
  if collection.handle == 'heads-only' or collection.title contains 'Heads Only' or request.path contains '/collections/heads-only'
    assign hw_is_heads_only_collection = true
  endif

  assign hw_collection_title = collection.title
  assign hw_collection_eyebrow = section.settings.eyebrow
  assign hw_collection_description = section.settings.fallback_description
  assign hw_collection_aside = section.settings.aside_copy
  assign hw_collection_count_label = 'models'
  if collection.products_count == 1
    assign hw_collection_count_label = 'model'
  endif

  if hw_is_accessories_collection
    assign hw_collection_eyebrow = 'Accessories and apparel'
    assign hw_collection_description = 'Course-ready essentials, thoughtful tools and Haywood apparel for on and off the golf course.'
    assign hw_collection_aside = 'Useful details, clean design and everyday pieces made to carry the Haywood identity.'
    assign hw_collection_count_label = 'items'
    if collection.products_count == 1
      assign hw_collection_count_label = 'item'
    endif
  endif


  if hw_is_lab_collection
    assign hw_collection_eyebrow = 'One of one · Haywood HQ'
    assign hw_collection_description = 'One-of-a-kind clubs, experimental builds and limited pieces created at Haywood HQ. Each release is unique and available only while it lasts.'
  endif

  if hw_is_irons_collection
    assign hw_collection_eyebrow = 'Find your iron'
    assign hw_collection_description = 'Four distinct profiles, from confidence-building forgiveness to compact forged precision. Compare the differences, then choose the iron built for your game.'
  endif

  if hw_is_woods_collection
    assign hw_collection_title = 'Drivers, woods & hybrids'
    assign hw_collection_eyebrow = 'Build the top of your bag'
    assign hw_collection_description = 'Choose speed off the tee, versatile distance from the fairway or easier launch into long approaches. Find the club and flight your game needs.'
  endif

  if hw_is_putters_collection
    assign hw_collection_title = 'Putters'
    assign hw_collection_eyebrow = 'Find your shape'
    assign hw_collection_description = 'Two precision-milled profiles with distinct alignment and stability. Choose a traditional blade or the added confidence of a mid-mallet.'
  endif

  if hw_is_heads_only_collection
    assign hw_collection_title = 'Heads Only'
    assign hw_collection_eyebrow = 'For independent club builders'
    assign hw_collection_description = 'Choose the Haywood clubhead, then complete the shaft, grip and final build to your own specifications.'
  endif
-%}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<section class="hw-commerce hw-collection-hero{% if hw_is_accessories_collection or hw_is_lab_collection or hw_is_irons_collection or hw_is_woods_collection or hw_is_putters_collection or hw_is_heads_only_collection %} hw-collection-hero--minimal{% endif %}" aria-labelledby="CollectionHeading-{{ section.id }}">
  <div class="hw-collection-hero__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="hw-collection-hero__main">
      <div>
        <p class="hw-collection-hero__eyebrow">{{ hw_collection_eyebrow | escape }}</p>
        <h1 class="hw-collection-hero__title" id="CollectionHeading-{{ section.id }}">
          <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
          {{- hw_collection_title | escape -}}
        </h1>

        {%- if section.settings.show_collection_description -%}
          <div class="hw-collection-hero__description rte">
            {%- if hw_is_accessories_collection or hw_is_lab_collection or hw_is_irons_collection or hw_is_woods_collection or hw_is_putters_collection or hw_is_heads_only_collection -%}
              <p>{{ hw_collection_description | escape }}</p>
            {%- elsif collection.description != blank -%}
              {{ collection.description }}
            {%- else -%}
              <p>{{ hw_collection_description | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if hw_is_accessories_collection == false and hw_is_lab_collection == false and hw_is_irons_collection == false and hw_is_woods_collection == false and hw_is_putters_collection == false and hw_is_heads_only_collection == false -%}
        <div class="hw-collection-hero__aside">
          <p class="hw-collection-hero__count">{{ collection.products_count }} {{ hw_collection_count_label }}</p>
          <p class="hw-collection-hero__aside-copy">{{ hw_collection_aside | escape }}</p>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_decision_links -%}
      {%- if hw_is_irons_collection -%}
        <nav class="hw-collection-hero__links hw-collection-hero__links--two" aria-label="Iron fitting and comparison tools">
          <a class="hw-collection-hero__link" href="/pages/fitting-tool">Find My Fit</a>
          <a class="hw-collection-hero__link" href="/pages/fitting-tool?view=iron-Selection">Compare irons</a>
        </nav>
      {%- elsif hw_is_woods_collection -%}
        <nav class="hw-collection-hero__links hw-collection-hero__links--two" aria-label="Woods and hybrid shopping tools">
          <a class="hw-collection-hero__link" href="#ProductGridContainer">Explore the lineup</a>
          <a class="hw-collection-hero__link" href="/pages/fitting-tool">Find My Fit</a>
        </nav>
      {%- elsif hw_is_putters_collection -%}
        <nav class="hw-collection-hero__links hw-collection-hero__links--two" aria-label="Putter shopping and fitting tools">
          <a class="hw-collection-hero__link" href="#ProductGridContainer">Explore the putters</a>
          <a class="hw-collection-hero__link" href="/pages/booking">Book a fitting</a>
        </nav>
      {%- elsif hw_is_heads_only_collection -%}
        <nav class="hw-collection-hero__links hw-collection-hero__links--two" aria-label="Heads-only shopping tools">
          <a class="hw-collection-hero__link" href="#ProductGridContainer">Explore clubheads</a>
          <a class="hw-collection-hero__link" href="{{ routes.all_products_collection_url }}">Shop complete clubs</a>
        </nav>
      {%- elsif hw_is_accessories_collection == false and hw_is_lab_collection == false -%}
        <nav class="hw-collection-hero__links" aria-label="Shop and fitting tools">
          <a class="hw-collection-hero__link" href="{{ routes.all_products_collection_url }}">Shop all clubs</a>
          <a class="hw-collection-hero__link" href="/pages/fitting-tool">Find My Fit</a>
          <a class="hw-collection-hero__link" href="/pages/fitting-tool?view=iron-Selection">Compare irons</a>
        </nav>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Haywood lineup"
    },
    {
      "type": "textarea",
      "id": "fallback_description",
      "label": "Fallback description",
      "default": "Purpose-built golf equipment, configured around the way you play."
    },
    {
      "type": "text",
      "id": "aside_copy",
      "label": "Model count supporting copy",
      "default": "Compare the lineup, then configure the model that fits your game."
    },
    {
      "type": "checkbox",
      "id": "show_decision_links",
      "default": true,
      "label": "Show shopping and fitting links"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
