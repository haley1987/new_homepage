<style>
.accordion-returns-exchanges-{{ section.id }} {
  cursor: pointer;
  padding: 1rem 0;
  width: 100%;
  border: none;
  text-align: left;
  outline: none;
  font-size: 20px;
  font-weight: 700;
  transition: 1s;
  background-color: #fff;
}
.custom-faq-wrapper {
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 10px;
}
.custom-faq-wrapper h2 {
  font-weight: bold;
}
.faq_head {
  margin-bottom: 50px;
  font-size: 25px;
  text-align: center;
}
.accordion-returns-exchanges-{{ section.id }}:after {
  content: "";
  float: right;
  font-weight: 500;
  font-size: 15px;
  margin-left: 5px;
  background-image: url('https://cdn.shopify.com/s/files/1/0066/1202/5428/files/icons8-plus-math-60.png?v=1673907287');
  background-repeat: no-repeat;
  background-size: contain;
  min-height: 25px;
  width: 25px;
  height: 25px;
}
.active-returns-exchanges:after {
  content: "";
  background-image: url('https://cdn.shopify.com/s/files/1/0066/1202/5428/files/icons8-subtract-60.png?v=1673907287');
  background-repeat: no-repeat;
  min-height: 30px;
}
.panel-returns-exchanges {
  padding: 0 5px;
  background-color: white;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.8s ease-out;
  border-bottom: 1.5px solid #1c3a3a !important;
}
.faq-accordions-{{ section.id }} .panel-returns-exchanges p {
  max-width: 100%;
}
</style>

<section class="faq-accordions-{{ section.id }}">
  <div class="custom-faq-wrapper">
    <h2>{{ section.settings.heading-title }}</h2>
    {% for block in section.blocks %}
      <div style="text-align:{{ block.settings.alignment }};">
        <h3 class="accordion-returns-exchanges-{{ section.id }}">{{ block.settings.heading }}</h3>
        <div class="panel-returns-exchanges">
          <p>{{ block.settings.sub_head }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function() {
  var acc = document.getElementsByClassName("accordion-returns-exchanges-{{ section.id }}");
  for (var i = 0; i < acc.length; i++) {
    acc[i].addEventListener("click", function() {
      this.classList.toggle("active-returns-exchanges");
      var panel = this.nextElementSibling;
      if (panel.style.maxHeight) {
        panel.style.maxHeight = null;
      } else {
        panel.style.maxHeight = panel.scrollHeight + "px";
      }
    });
  }
});
</script>

{% schema %}
{
  "name": "Careers Accordion",
  "settings": [
    {
      "type": "text",
      "id": "heading-title",
      "label": "Title"
    }
  ],
  "blocks": [
    {
      "type": "select",
      "name": "Info accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Title" },
        { "type": "richtext", "id": "sub_head", "label": "Sub Header" },
        {
          "type": "select",
          "id": "alignment",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Centered" },
            { "value": "right", "label": "Right" }
          ]
        }
      ]
    }
  ],
  "presets": [
    { "name": "Careers Accordion" }
  ]
}
{% endschema %}
