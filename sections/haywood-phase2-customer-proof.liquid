{%- liquid
  assign has_quote = false
  if section.settings.quote != blank
    assign has_quote = true
  endif

  assign review_rating = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
  assign review_count = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count
  assign has_live_rating = false
  if review_rating != blank and review_count != blank
    assign has_live_rating = true
  endif
-%}

<section class="hw-section hw-proof" style="--hw-section-background: {{ section.settings.background_color | default: '#f2eee5' }}; --hw-heading-color: {{ section.settings.heading_color | default: '#0b2341' }}; --hw-text-color: {{ section.settings.text_color | default: '#56647a' }};">
  <div class="hw-shell hw-proof__inner{% if has_quote %} hw-proof__inner--quote{% endif %}">
    <div class="hw-proof__intro">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>

    {%- if has_quote -%}
      <figure class="hw-proof__featured">
        <blockquote class="hw-proof__quote">“{{ section.settings.quote | escape }}”</blockquote>
        {%- if section.settings.customer_name != blank or section.settings.product_purchased != blank -%}
          <figcaption class="hw-proof__cite">
            {{ section.settings.customer_name | escape }}
            {%- if section.settings.product_purchased != blank -%}<span class="hw-proof__product">{{ section.settings.product_purchased | escape }}</span>{%- endif -%}
          </figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    <div class="hw-proof__rating">
      {%- if has_live_rating -%}
        <div class="hw-proof__stars" role="img" aria-label="{{ review_rating | round: 1 }} out of 5 stars from {{ review_count }} customer reviews">★★★★★</div>
        <p class="hw-proof__score">
          <strong>{{ review_rating | round: 1 }}</strong>
          <span>from {{ review_count }} customer reviews</span>
        </p>
        {%- if section.settings.source_label != blank -%}<p class="hw-proof__source">{{ section.settings.source_label | escape }}</p>{%- endif -%}
      {%- elsif section.settings.summary != blank -%}
        <p class="hw-proof__summary">{{ section.settings.summary | escape }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}<a class="hw-button hw-button--solid" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood customer proof",
  "settings": [
    { "type": "header", "content": "Content colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f2eee5" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#0b2341" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#56647a" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer proof" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for golfers who care about the details." },
    { "type": "textarea", "id": "quote", "label": "Approved quote" },
    { "type": "text", "id": "customer_name", "label": "Customer name" },
    { "type": "text", "id": "product_purchased", "label": "Product purchased" },
    { "type": "text", "id": "summary", "label": "Fallback review summary", "default": "Trusted by golfers worldwide" },
    { "type": "text", "id": "source_label", "label": "Rating source", "default": "Verified customer reviews via Judge.me" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read Customer Reviews" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Haywood customer proof" }]
}
{% endschema %}
