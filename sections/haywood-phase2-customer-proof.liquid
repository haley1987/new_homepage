{%- assign has_quote = false -%}
{%- if section.settings.quote != blank -%}{%- assign has_quote = true -%}{%- endif -%}

<section class="hw-section hw-proof{% unless has_quote %} hw-proof--placeholder-copy{% endunless %}">
  <div class="hw-proof__grid">
    <div class="hw-proof__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '550, 750, 1100, 1400, 1600', sizes: '(min-width: 750px) 30vw, 100vw', loading: 'lazy' }}
      {%- else -%}
        <div class="hw-proof__placeholder" data-image-purpose="CUSTOMER PROOF PHOTOGRAPHY"><span>CUSTOMER PROOF PHOTOGRAPHY</span></div>
      {%- endif -%}
    </div>
    <div class="hw-proof__content">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if has_quote -%}
        <blockquote class="hw-proof__quote">“{{ section.settings.quote | escape }}”</blockquote>
        {%- if section.settings.customer_name != blank or section.settings.product_purchased != blank -%}
          <cite class="hw-proof__cite">
            {{ section.settings.customer_name | escape }}
            {%- if section.settings.product_purchased != blank -%}<span class="hw-proof__product">{{ section.settings.product_purchased | escape }}</span>{%- endif -%}
          </cite>
        {%- endif -%}
      {%- endif -%}
      {%- unless has_quote -%}
        {%- if section.settings.placeholder_copy != blank -%}<p class="hw-proof__empty">{{ section.settings.placeholder_copy | escape }}</p>{%- endif -%}
      {%- endunless -%}
    </div>
    <div class="hw-proof__summary">
      {%- if section.settings.summary != blank -%}<p>{{ section.settings.summary | escape }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}<a class="hw-button hw-button--light" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood customer proof",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer proof" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for golfers who care about the details." },
    { "type": "textarea", "id": "quote", "label": "Approved quote" },
    { "type": "text", "id": "placeholder_copy", "label": "Unapproved quote placeholder", "default": "Approved customer review will appear here." },
    { "type": "text", "id": "customer_name", "label": "Customer name" },
    { "type": "text", "id": "product_purchased", "label": "Product purchased" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "summary", "label": "Review summary", "default": "Customer reviews" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read Reviews" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Haywood customer proof" }]
}
{% endschema %}
