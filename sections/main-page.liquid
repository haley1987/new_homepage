{%- if page.handle == 'store-locator' -%}
  {{ 'haywood-store-locator.css' | asset_url | stylesheet_tag }}
  {%- render 'haywood-store-locator-page', page_settings: section.settings -%}
{%- elsif page.handle == 'the-haywood-golf-story' -%}
  {{ 'haywood-story.css' | asset_url | stylesheet_tag }}
  {%- render 'haywood-story-page', page_settings: section.settings -%}
{%- elsif page.handle == 'return-policy' -%}
  {{ 'haywood-return-policy.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'haywood-return-policy.js' | asset_url }}" defer="defer"></script>
  {%- render 'haywood-return-policy-page', page_settings: section.settings -%}
{%- elsif page.handle == 'booking' -%}
  {{ 'haywood-booking.css' | asset_url | stylesheet_tag }}
  {%- render 'haywood-booking-page' -%}
{%- else -%}
  {{ 'section-main-page.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="main-page-title page-title h0{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ page.title | escape }}
    </h1>
    <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Haywood story page"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Hero eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Hero heading",
      "default": "Built from a better idea."
    },
    {
      "type": "textarea",
      "id": "story_intro",
      "label": "Hero introduction",
      "default": "Haywood began in Vancouver with a simple belief: golfers should not have to choose between considered design, custom specifications and fair pricing."
    },
    {
      "type": "image_picker",
      "id": "story_hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "story_origin_eyebrow",
      "label": "Origin eyebrow",
      "default": "VANCOUVER · 2018"
    },
    {
      "type": "text",
      "id": "story_origin_heading",
      "label": "Origin heading",
      "default": "Frustration became a blueprint."
    },
    {
      "type": "textarea",
      "id": "story_origin_copy",
      "label": "Origin copy",
      "default": "After a disappointing experience at a major golf retailer, we started asking better questions. What if we designed the clubs ourselves, worked directly with trusted manufacturing partners and built every order around the golfer receiving it?"
    },
    {
      "type": "textarea",
      "id": "story_origin_copy_2",
      "label": "Origin copy — second paragraph",
      "default": "We began with wedges—sourcing, prototyping and testing until the product met our standards for feel, performance and durability. That same process now guides every Haywood club."
    },
    {
      "type": "image_picker",
      "id": "story_origin_image",
      "label": "Origin image"
    },
    {
      "type": "text",
      "id": "story_people_eyebrow",
      "label": "People section eyebrow",
      "default": "WHY WE BUILD"
    },
    {
      "type": "text",
      "id": "story_people_heading",
      "label": "People section heading",
      "default": "Golf is personal. Your equipment should be too."
    },
    {
      "type": "textarea",
      "id": "story_people_copy",
      "label": "People section copy",
      "default": "Every Haywood club is built to order. That lets us focus on the details that matter—head, shaft, length, lie and grip—while staying close to the golfers who play our equipment."
    },
    {
      "type": "image_picker",
      "id": "story_people_image",
      "label": "People section image"
    },
    {
      "type": "text",
      "id": "story_cta_eyebrow",
      "label": "CTA eyebrow",
      "default": "THE STORY CONTINUES"
    },
    {
      "type": "text",
      "id": "story_cta_heading",
      "label": "CTA heading",
      "default": "See what we are building now."
    },
    {
      "type": "textarea",
      "id": "story_cta_copy",
      "label": "CTA copy",
      "default": "Explore the current Haywood lineup or visit the Journal for equipment insight, fitting knowledge and stories from the workshop."
    },
    {
      "type": "text",
      "id": "story_primary_label",
      "label": "Primary button label",
      "default": "SHOP ALL CLUBS"
    },
    {
      "type": "url",
      "id": "story_primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "story_secondary_label",
      "label": "Secondary button label",
      "default": "VISIT THE JOURNAL"
    },
    {
      "type": "url",
      "id": "story_secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Store locator page"
    },
    {
      "type": "text",
      "id": "locator_eyebrow",
      "label": "Introduction eyebrow",
      "default": "FIND HAYWOOD NEAR YOU"
    },
    {
      "type": "text",
      "id": "locator_heading",
      "label": "Introduction heading",
      "default": "Try Haywood in person."
    },
    {
      "type": "textarea",
      "id": "locator_intro",
      "label": "Introduction copy",
      "default": "Find a Haywood dealer or fitting partner near you. Explore available locations, get fit and experience our clubs before you order."
    },
    {
      "type": "text",
      "id": "locator_note_heading",
      "label": "Visit note heading",
      "default": "Before you visit"
    },
    {
      "type": "textarea",
      "id": "locator_note_copy",
      "label": "Visit note copy",
      "default": "Haywood product availability, fitting services and pricing vary by location. Some partners carry select models or offer different fitting experiences. Please contact the location directly to confirm available products, appointment requirements and current pricing before visiting."
    },
    {
      "type": "text",
      "id": "locator_fit_eyebrow",
      "label": "Online fitting eyebrow",
      "default": "NO FITTER NEARBY?"
    },
    {
      "type": "text",
      "id": "locator_fit_heading",
      "label": "Online fitting heading",
      "default": "Find your fit online."
    },
    {
      "type": "textarea",
      "id": "locator_fit_copy",
      "label": "Online fitting copy",
      "default": "Answer a few questions about your swing, game and preferences. Our Find My Fit tool will help narrow down the right Haywood model and provide a recommended build starting point."
    },
    {
      "type": "text",
      "id": "locator_fit_label",
      "label": "Online fitting button",
      "default": "FIND MY FIT"
    },
    {
      "type": "url",
      "id": "locator_fit_link",
      "label": "Online fitting link"
    },
    {
      "type": "text",
      "id": "locator_dealer_eyebrow",
      "label": "Dealer enquiry eyebrow",
      "default": "BECOME A HAYWOOD DEALER"
    },
    {
      "type": "text",
      "id": "locator_dealer_heading",
      "label": "Dealer enquiry heading",
      "default": "Interested in carrying Haywood?"
    },
    {
      "type": "textarea",
      "id": "locator_dealer_copy",
      "label": "Dealer enquiry copy",
      "default": "We’re growing our network of trusted dealers and fitting partners. If you’re interested in carrying Haywood products, email our team to introduce yourself."
    },
    {
      "type": "text",
      "id": "locator_dealer_label",
      "label": "Dealer enquiry button",
      "default": "EMAIL OUR TEAM"
    },
    {
      "type": "text",
      "id": "locator_dealer_email",
      "label": "Dealer enquiry email",
      "default": "info@haywoodgolf.com"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
