{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
-%}

<section
  class="hw-section hw-split color-{{ section.settings.color_scheme }} gradient"
  style="--hw-fit-media-fit: {{ section.settings.image_fit }}; --hw-fit-desktop-position: {{ section.settings.desktop_position }}; --hw-fit-mobile-position: {{ section.settings.mobile_position }};"
>
  <div class="hw-shell hw-split__grid">
    <div class="hw-split__media">
      {%- if desktop_image != blank -%}
        <picture>
          {%- if mobile_image != blank -%}<source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 800 }}" sizes="100vw">{%- endif -%}
          {{ desktop_image | image_url: width: 1600 | image_tag: widths: '550, 750, 1100, 1400, 1600', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
        </picture>
      {%- else -%}
        <div class="hw-media-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
    <div class="hw-split__content">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="hw-copy">{{ section.settings.body }}</div>{%- endif -%}
      <div class="hw-actions">
        {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}<a class="hw-button hw-button--solid" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>{%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}<a class="hw-button" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood Find My Fit",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [
      { "value": "contain", "label": "Show complete image" }, { "value": "cover", "label": "Crop to fill" }
    ], "default": "contain" },
    { "type": "select", "id": "desktop_position", "label": "Desktop image position", "options": [
      { "value": "left top", "label": "Left top" }, { "value": "center top", "label": "Center top" }, { "value": "right top", "label": "Right top" },
      { "value": "left center", "label": "Left center" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right center" },
      { "value": "left bottom", "label": "Left bottom" }, { "value": "center bottom", "label": "Center bottom" }, { "value": "right bottom", "label": "Right bottom" }
    ], "default": "center center" },
    { "type": "select", "id": "mobile_position", "label": "Mobile image position", "options": [
      { "value": "left top", "label": "Left top" }, { "value": "center top", "label": "Center top" }, { "value": "right top", "label": "Right top" },
      { "value": "left center", "label": "Left center" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right center" },
      { "value": "left bottom", "label": "Left bottom" }, { "value": "center bottom", "label": "Center bottom" }, { "value": "right bottom", "label": "Right bottom" }
    ], "default": "center center" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Not sure where to start?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the clubs that fit your game." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Answer a few questions and narrow down the models and specifications that make sense for you.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary CTA label", "default": "Find My Fit" },
    { "type": "url", "id": "primary_link", "label": "Primary CTA link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA label" },
    { "type": "url", "id": "secondary_link", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Haywood Find My Fit" }]
}
{% endschema %}
