{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{{ 'haywood-journal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign show_date = true
  assign show_author = false
  assign share_block = nil
  assign has_content_block = false

  for block in section.blocks
    case block.type
      when 'title'
        assign show_date = block.settings.blog_show_date
        assign show_author = block.settings.blog_show_author
      when 'share'
        assign share_block = block
      when 'content'
        assign has_content_block = true
    endcase
  endfor

  assign article_words = article.content | strip_html | split: ' ' | size
  assign reading_time = article_words | plus: 199 | divided_by: 200
  if reading_time < 1
    assign reading_time = 1
  endif
  assign article_alt = article.image.alt | default: article.title
-%}

<article class="hw-article article-template">
  <header class="hw-article__hero">
    <div class="hw-article__shell hw-article__hero-grid{% if article.image == blank %} hw-article__hero-grid--no-image{% endif %}">
      <div class="hw-article__hero-copy">
        <p class="hw-article__eyebrow">
          <a class="hw-article__back-link" href="{{ blog.url }}">Haywood Journal</a>
        </p>
        <h1 class="hw-article__title">{{ article.title | escape }}</h1>
        <div class="hw-article__meta">
          {%- if show_date -%}
            <span>{{ article.published_at | time_tag: format: 'date' }}</span>
          {%- endif -%}
          <span>{{ reading_time }} min read</span>
          {%- if show_author -%}<span>By {{ article.author | escape }}</span>{%- endif -%}
        </div>
      </div>

      {%- if article.image != blank -%}
        <div class="hw-article__hero-media">
          {{ article.image
            | image_url: width: 2200
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '550, 750, 1100, 1500, 1800, 2200',
              sizes: '(min-width: 750px) 55vw, 100vw',
              alt: article_alt
          }}
        </div>
      {%- else -%}
        <div class="hw-article__hero-placeholder" aria-hidden="true"></div>
      {%- endif -%}
    </div>
  </header>

  {%- for block in section.blocks -%}
    {%- if block.type == '@app' -%}
      <div class="hw-article__apps" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {%- endif -%}
  {%- endfor -%}

  <div class="hw-article__shell hw-article__main">
    <div class="hw-article__reading-grid">
      <aside class="hw-article__share" aria-label="Share this article">
        {%- if share_block != nil -%}
          <span class="hw-article__share-label">Share</span>
          {% assign share_url = request.origin | append: article.url %}
          {% render 'share-button', block: share_block, share_link: share_url %}
        {%- endif -%}
      </aside>

      {%- if has_content_block -%}
        <div class="hw-article__content rte">
          {{ article.content }}
        </div>
      {%- endif -%}

      <aside class="hw-article__aside" aria-label="Find your Haywood clubs">
        <span class="hw-article__aside-label">Not sure what fits?</span>
        <h2 class="hw-article__aside-title">Turn knowledge into the right build.</h2>
        <p class="hw-article__aside-copy">Use Find My Fit for a clear starting recommendation, or explore every club in the Haywood lineup.</p>
        <div class="hw-article__aside-links">
          <a class="hw-article__button hw-article__button--gold" href="/pages/fitting-tool">Find My Fit</a>
          <a class="hw-article__button" href="/collections/all">Shop Clubs</a>
        </div>
      </aside>
    </div>
  </div>

  <section class="hw-article__related" aria-labelledby="RelatedArticles-{{ section.id }}">
    <div class="hw-article__shell">
      <div class="hw-article__related-head">
        <div>
          <p class="hw-article__section-label">Keep reading</p>
          <h2 class="hw-article__related-title" id="RelatedArticles-{{ section.id }}">More from the Journal</h2>
        </div>
        <a class="hw-article__related-all" href="{{ blog.url }}">View all articles →</a>
      </div>

      <div class="hw-article__related-grid">
        {%- assign related_count = 0 -%}
        {%- for related_article in blog.articles -%}
          {%- unless related_article.id == article.id -%}
            {%- assign related_alt = related_article.image.alt | default: related_article.title -%}
            <article class="hw-article-related">
              <a class="hw-article-related__media" href="{{ related_article.url }}" aria-label="{{ related_article.title | escape }}">
                {%- if related_article.image != blank -%}
                  {{ related_article.image
                    | image_url: width: 1000
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 550, 750, 1000',
                      sizes: '(min-width: 750px) 31vw, 120px',
                      alt: related_alt
                  }}
                {%- else -%}
                  <span class="hw-journal-card__placeholder" aria-hidden="true"></span>
                {%- endif -%}
              </a>
              <div class="hw-article-related__body">
                <time class="hw-article-related__date" datetime="{{ related_article.published_at | date: '%Y-%m-%d' }}">{{ related_article.published_at | date: '%B %e, %Y' }}</time>
                <h3 class="hw-article-related__title">
                  <a class="hw-article-related__link" href="{{ related_article.url }}">{{ related_article.title | escape }}</a>
                </h3>
                <a class="hw-article-related__cta" href="{{ related_article.url }}">Read article <span aria-hidden="true">→</span></a>
              </div>
            </article>
            {%- assign related_count = related_count | plus: 1 -%}
            {%- if related_count == 3 -%}{%- break -%}{%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper background-secondary">
      <div id="comments" class="page-width page-width--narrow">
        {%- if article.comments_count > 0 -%}
          {%- assign comments_anchor = '#Comments-' | append: article.id -%}
          <h2 id="Comments-{{ article.id }}" tabindex="-1">{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- for comment in article.comments -%}
                <article class="article-template__comments-comment" id="{{ comment.id }}">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                    <span class="caption-with-letter-spacing">{{ comment.created_at | time_tag: format: 'date' }}</span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: comments_anchor %}
            </div>
          {% endpaginate %}
        {%- endif -%}

        {% form 'new_comment', article %}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>{{ 'blogs.article.success' | t }}</h3>
            </div>
          {%- endif -%}

          <div class="article-template__comment-fields">
            <div class="field field--with-error">
              <input type="text" name="comment[author]" id="CommentForm-author" class="field__input" autocomplete="name" value="{{ form.author }}" aria-required="true" required placeholder="{{ 'blogs.article.name' | t }}">
              <label class="field__label" for="CommentForm-author">{{ 'blogs.article.name' | t }} <span aria-hidden="true">*</span></label>
            </div>
            <div class="field field--with-error">
              <input type="email" name="comment[email]" id="CommentForm-email" class="field__input" autocomplete="email" value="{{ form.email }}" autocorrect="off" autocapitalize="off" aria-required="true" required placeholder="{{ 'blogs.article.email' | t }}">
              <label class="field__label" for="CommentForm-email">{{ 'blogs.article.email' | t }} <span aria-hidden="true">*</span></label>
            </div>
          </div>
          <div class="field field--with-error">
            <textarea rows="5" name="comment[body]" id="CommentForm-body" class="text-area field__input" aria-required="true" required placeholder="{{ 'blogs.article.message' | t }}">{{ form.body }}</textarea>
            <label class="form__label field__label" for="CommentForm-body">{{ 'blogs.article.message' | t }} <span aria-hidden="true">*</span></label>
          </div>
          {%- if blog.moderated? -%}<p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>{%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Haywood article",
  "tag": "section",
  "class": "section",
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Article title and meta",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "blog_show_date", "default": true, "label": "Show date" },
        { "type": "checkbox", "id": "blog_show_author", "default": false, "label": "Show author" }
      ]
    },
    { "type": "content", "name": "Article content", "limit": 1 },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "share_label", "label": "Share label", "default": "Share" }
      ]
    }
  ]
}
{% endschema %}
