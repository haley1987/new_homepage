<section class="hw-section hw-community" aria-label="{{ section.settings.accessibility_label | escape }}" style="--hw-section-background: {{ section.settings.background_color | default: '#ffffff' }}; --hw-heading-color: {{ section.settings.heading_color | default: '#0b0b0a' }}; --hw-text-color: {{ section.settings.text_color | default: '#5b5a55' }};">
  <div class="hw-shell hw-community__layout">
    <header class="hw-community__header">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.handle != blank -%}<p class="hw-community__handle">{{ section.settings.handle | escape }}</p>{%- endif -%}
    </header>

    <div class="hw-community__grid">
      {%- for block in section.blocks -%}
        <figure class="hw-community__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '400, 600, 900, 1200, 1600', sizes: '(min-width: 750px) 50vw, 50vw', loading: 'lazy' }}
          {%- else -%}
            <div class="hw-community__placeholder" data-image-purpose="{{ block.settings.image_purpose | escape }}">
              <span>{{ block.settings.image_purpose | escape }}</span>
            </div>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}<figcaption class="hw-community__caption">{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
    {%- if section.settings.link_label != blank and section.settings.link != blank -%}
      <div class="hw-community__footer"><a class="hw-community__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Haywood community",
  "settings": [
    { "type": "header", "content": "Content colors" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#0b0b0a" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#5b5a55" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow the Arc." },
    { "type": "text", "id": "handle", "label": "Social handle", "default": "@HAYWOODGOLF" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Haywood golfers, workshop and community" }
  ],
  "blocks": [
    { "type": "image", "name": "Image", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "image_purpose", "label": "Placeholder purpose", "default": "Lifestyle photography" },
      { "type": "text", "id": "caption", "label": "Caption" }
    ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Haywood community", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }]
}
{% endschema %}
