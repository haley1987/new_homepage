{{ 'haywood-careers.css' | asset_url | stylesheet_tag }}

{%- render 'haywood-careers-page', page_settings: section.settings, job_blocks: section.blocks -%}

{% schema %}
{
  "name": "Haywood careers",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Introduction" },
    { "type": "text", "id": "careers_eyebrow", "label": "Eyebrow", "default": "WORK WITH HAYWOOD" },
    { "type": "text", "id": "careers_heading", "label": "Heading", "default": "Different ways to be part of Haywood." },
    { "type": "textarea", "id": "careers_intro", "label": "Introduction", "default": "We are not hiring for any roles right now. But if you fit golfers, run a retail business or create thoughtful golf content, there may still be a way for us to work together." },

    { "type": "header", "content": "Current opportunities" },
    { "type": "text", "id": "careers_status_eyebrow", "label": "Eyebrow", "default": "CURRENT OPPORTUNITIES" },
    { "type": "text", "id": "careers_status_heading", "label": "Heading", "default": "No open roles right now." },
    { "type": "textarea", "id": "careers_status_copy", "label": "Copy", "default": "When a position becomes available, we will post the complete role and application details here. We do not keep general employment applications on file between openings." },

    { "type": "header", "content": "Partnership paths" },
    { "type": "text", "id": "careers_paths_eyebrow", "label": "Section eyebrow", "default": "OTHER WAYS TO WORK TOGETHER" },
    { "type": "text", "id": "careers_paths_heading", "label": "Section heading", "default": "A job is not the only way in." },

    { "type": "text", "id": "careers_fit_heading", "label": "Fitting heading", "default": "Fit Haywood." },
    { "type": "textarea", "id": "careers_fit_copy", "label": "Fitting copy", "default": "If you are a professional fitter or fitting facility interested in working with Haywood products, introduce yourself and tell us about your fitting experience." },
    { "type": "text", "id": "careers_fit_label", "label": "Fitting button", "default": "FITTING PARTNER INQUIRY" },
    { "type": "text", "id": "careers_fit_email", "label": "Fitting email", "default": "info@haywoodgolf.com" },

    { "type": "text", "id": "careers_retail_heading", "label": "Retail heading", "default": "Carry Haywood." },
    { "type": "textarea", "id": "careers_retail_copy", "label": "Retail copy", "default": "Retailers and golf businesses interested in carrying Haywood can contact our team to discuss products, territory and partnership fit." },
    { "type": "text", "id": "careers_retail_label", "label": "Retail button", "default": "RETAILER INQUIRY" },
    { "type": "text", "id": "careers_retail_email", "label": "Retail email", "default": "info@haywoodgolf.com" },

    { "type": "text", "id": "careers_creator_heading", "label": "Creator heading", "default": "Create with Haywood." },
    { "type": "textarea", "id": "careers_creator_copy", "label": "Creator copy", "default": "Rep Haywood is our creator program for golfers with a point of view and an audience that is listening. We choose partners by fit, not follower count." },
    { "type": "text", "id": "careers_creator_label", "label": "Creator button", "default": "EXPLORE REP HAYWOOD" },
    { "type": "url", "id": "careers_creator_link", "label": "Creator link" },

    { "type": "header", "content": "Closing contact" },
    { "type": "text", "id": "careers_contact_eyebrow", "label": "Eyebrow", "default": "NOT SURE WHERE YOU FIT?" },
    { "type": "text", "id": "careers_contact_heading", "label": "Heading", "default": "Start with a conversation." },
    { "type": "textarea", "id": "careers_contact_copy", "label": "Copy", "default": "Tell us what you have in mind and our team will point you in the right direction." },
    { "type": "text", "id": "careers_contact_label", "label": "Button", "default": "CONTACT HAYWOOD" },
    { "type": "url", "id": "careers_contact_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "job",
      "name": "Job posting",
      "settings": [
        { "type": "checkbox", "id": "active", "label": "Show this job", "default": true },
        { "type": "text", "id": "title", "label": "Job title", "default": "Golf Club Builder / Order Prep Associate" },
        { "type": "text", "id": "location", "label": "Location", "default": "Vancouver, BC" },
        { "type": "text", "id": "hours", "label": "Hours", "default": "32-40 hours/week" },
        { "type": "text", "id": "pay", "label": "Compensation", "default": "$20-$23/hour" },
        { "type": "textarea", "id": "intro", "label": "Introduction", "default": "A hands-on role preparing, finishing and inspecting custom golf clubs before they reach our customers, with room to develop additional club-building skills." },
        { "type": "richtext", "id": "responsibilities", "label": "What you'll do", "default": "<ul><li>Prepare and pack custom golf club orders for shipment</li><li>Clean and finish completed clubs to Haywood's quality standards</li><li>Perform quality-control checks on completed builds</li><li>Organize components and inventory</li><li>Maintain a clean, organized and efficient workspace</li><li>Assist with basic golf club assembly and building</li><li>Learn additional club-building processes through hands-on training</li></ul>" },
        { "type": "richtext", "id": "qualifications", "label": "What we're looking for", "default": "<ul><li>Strong attention to detail and a high standard for quality</li><li>Reliable, punctual and consistent</li><li>Comfortable performing hands-on and repetitive work</li><li>Organized and able to follow established processes</li><li>Willingness to learn and take on additional responsibilities</li><li>Interest in golf, golf equipment or craftsmanship is an asset, but not required</li><li>Previous club-building experience is not required; training will be provided</li></ul>" },
        { "type": "richtext", "id": "perks", "label": "Compensation and perks", "default": "<p>$20-$23/hour | 32-40 hours per week</p><ul><li>Employee discount after a 3-month probationary period</li><li>Occasional team lunches</li><li>Periodic team golf rounds and outings</li><li>Weekly simulator golf challenges</li><li>Relaxed, respectful, detail-driven work environment</li><li>Opportunity to develop hands-on club-building skills</li></ul>" },
        { "type": "textarea", "id": "application_copy", "label": "Application instructions", "default": "Send your resume and a brief cover letter to our team." },
        { "type": "text", "id": "apply_label", "label": "Apply button", "default": "APPLY BY EMAIL" },
        { "type": "text", "id": "apply_email", "label": "Application email", "default": "info@haywoodgolf.com" },
        { "type": "text", "id": "details_label", "label": "Details button", "default": "VIEW ROLE DETAILS" },
        { "type": "url", "id": "pdf_link", "label": "Optional PDF download" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Haywood careers" }
  ]
}
{% endschema %}
