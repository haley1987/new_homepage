{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
-%}

<section class="hw-section hw-final-cta" style="--hw-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  <div class="hw-final-cta__media" aria-hidden="true">
    {%- if desktop_image != blank -%}
      <picture>
        {%- if mobile_image != blank -%}<source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 900 }}" sizes="100vw">{%- endif -%}
        {{ desktop_image | image_url: width: 2400 | image_tag: widths: '900, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy' }}
      </picture>
    {%- else -%}
      <div class="hw-media-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
    {%- endif -%}
  </div>
  <div class="hw-final-cta__overlay" aria-hidden="true"></div>
  <div class="hw-shell hw-final-cta__content">
    {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="hw-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="hw-copy">{{ section.settings.body }}</div>{%- endif -%}
    <div class="hw-actions">
      {%- if section.settings.primary_label != blank and section.settings.primary_link != blank -%}<a class="hw-button hw-button--light" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>{%- endif -%}
      {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}<a class="hw-button" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood final CTA",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay strength", "default": 45 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your build starts here" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your best golf." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Explore the lineup or find the models and specifications that fit your game.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary CTA label", "default": "Shop Clubs" },
    { "type": "url", "id": "primary_link", "label": "Primary CTA link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary CTA label", "default": "Find My Fit" },
    { "type": "url", "id": "secondary_link", "label": "Secondary CTA link" }
  ],
  "presets": [{ "name": "Haywood final CTA" }]
}
{% endschema %}
