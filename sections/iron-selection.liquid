      <script>
          let showingFirst = true;
        
      function toggleRecommendation() {
          const firstCard = document.getElementById("firstCard");
          const secondCard = document.getElementById("secondCard");
          const prevB = document.getElementById("prevB");
          const nextB = document.getElementById("nextB");
      
          if (showingFirst) {
              firstCard.style.display = "none";
              secondCard.setAttribute("style", "display: flex !important;"); // Ensure it's visible
              prevB.style.display = "block"; 
              nextB.style.display = "none";
          } else {
              firstCard.style.display = "flex"; // Keep flex for layout consistency
              secondCard.style.display = "none";
              prevB.style.display = "none"; 
              nextB.style.display = "block";
          }
          showingFirst = !showingFirst;
      }
      
      </script>








