{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{% comment %}Haywood technical specifications — compact chart treatment, responsive at every breakpoint.{% endcomment %}
{%- style -%}
  /* Keep technical artwork legible without allowing it to become a full-screen banner. */
  #Banner-{{ section.id }} {
    width: 100%;
    min-height: 0 !important;
    height: auto !important;
    display: block;
  }
  #Banner-{{ section.id }} .banner__media {
    position: static;
    min-height: 0 !important;
    height: auto !important;
    border: 1px solid rgba(11, 35, 65, .14);
    background: #fff;
  }
  #Banner-{{ section.id }} .banner__media::before { content: none; display: none; }
  #Banner-{{ section.id }} .banner__media .banner__media-image {
    position: static;
    display: block;
    width: 100%;
    max-width: 72rem;
    height: auto;
    max-height: 62rem;
    margin-inline: auto;
    padding: clamp(2rem, 4vw, 5rem);
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} {
    padding: clamp(4.5rem, 5vw, 6.5rem) 0;
    background: #f2eee5;
  }

  #shopify-section-{{ section.id }} .hw-specs-shell {
    display: grid;
    grid-template-columns: minmax(24rem, .42fr) minmax(0, .58fr);
    gap: clamp(4rem, 7vw, 9rem);
    align-items: center;
    width: min(calc(100% - 8rem), 120rem);
    margin-inline: auto;
  }

  #shopify-section-{{ section.id }} .hw-specs-eyebrow {
    margin: 0;
    color: #c9a66b;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} h2.specs_banner_title {
    max-width: 12ch;
    margin: 1.4rem 0 2rem;
    color: #0b2341;
    font-family: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
    font-size: clamp(3.8rem, 4vw, 5.2rem);
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: .95;
    overflow-wrap: normal;
    word-break: normal;
  }

  #shopify-section-{{ section.id }} .hw-specs-copy {
    max-width: 42rem;
    margin: 0;
    color: #5d6470;
    font-size: 1.65rem;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .hw-specs-link {
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 2.6rem;
    padding-bottom: .5rem;
    border-bottom: 1px solid #c9a66b;
    color: #0b2341;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .hw-specs-link:hover {
    color: #8d6c37;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: 4rem 0;
    }

    #shopify-section-{{ section.id }} .hw-specs-shell {
      grid-template-columns: 1fr;
      gap: 3rem;
      width: calc(100% - 4rem);
    }

    #Banner-{{ section.id }} .banner__media .banner__media-image {
      width: 100%;
      max-width: 100%;
      max-height: 54rem;
      padding: 1.6rem;
    }
  }
{%- endstyle -%}


{%- liquid
  assign specs_url = product.metafields['specs-image']['specs-image']
  assign fetch_priority = 'auto'
  assign specs_copy = 'Review loft, lie, length, offset and head specifications in one place. Open the original chart when you need a closer look.'
  if product.title contains 'Driver' or product.title contains 'Fairway' or product.title contains 'Hybrid'
    assign specs_copy = 'Review loft, lie, head profile, length and available setup information in one place.'
  elsif product.title contains 'Putter'
    assign specs_copy = 'Review loft, lie, head weight and available length information in one place.'
  elsif product.title contains 'Wedge'
    assign specs_copy = 'Review loft, lie, length, bounce and sole specifications in one place.'
  elsif product.tags contains 'headsonly' or product.title contains 'Heads Only' or product.title contains 'Head Only'
    assign specs_copy = 'Review available lofts and head specifications before planning your build.'
  endif
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- comment -%}
  Renders only when product.metafields['specs-image']['specs-image'] (URL) is present.
  If empty, the section outputs nothing (self-hiding).
{%- endcomment -%}
{%- if specs_url != blank -%}
<div class="hw-specs-shell">
  <header class="hw-specs-intro">
    <p class="hw-specs-eyebrow">Technical reference</p>
    <h2 class="specs_banner_title" id="full-specs">Club specifications.</h2>
    <p class="hw-specs-copy">{{ specs_copy }}</p>
    <a class="hw-specs-link" href="{{ specs_url | escape }}" target="_blank" rel="noopener">
      Open full-size chart <span aria-hidden="true">→</span>
    </a>
  </header>
  <div
    id="Banner-{{ section.id }}"
    class="banner banner--content-align-center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    <div class="banner__media media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <img
        src="{{ specs_url | escape }}"
        alt="{{ product.title | escape }} specifications"
        width="1600"
        height="1600"
        class="banner__media-image"
        loading="lazy"
        decoding="async"
        fetchpriority="{{ fetch_priority }}"
      >
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Specs Image Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "image_height",
      "label": "Image height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Specs Image Banner (URL metafield)" }]
}
{% endschema %}
