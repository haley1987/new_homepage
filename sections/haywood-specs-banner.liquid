{% comment %}
  Haywood product specifications.

  Approved equipment specifications use live, responsive HTML so customers
  never need to zoom a flattened chart image. The metafield image remains as a
  safe fallback for any future product whose measurements have not been mapped.
{% endcomment %}

{%- liquid
  assign specs_url = product.metafields['specs-image']['specs-image']
  assign has_structured_specs = false
  assign model_name = product.title
  assign model_type = 'Iron specifications'
  assign profile_handicap = blank
  assign profile_distance = 0
  assign profile_forgiveness = 0
  assign profile_workability = 0
  assign item_label = 'club'
  assign item_suffix = 'iron'
  assign column_labels = 'Loft^Length^Lie^Offset^Swing weight' | split: '^'
  assign spec_rows = blank
  assign geometry_rows = blank
  assign geometry_label = blank
  assign specs_intro = 'Review every club without opening a separate chart. Select a club on mobile or compare the complete set on desktop.'
  assign specs_note = 'Swing weights are based on standard length with a 110 g shaft. Actual swing weight varies with custom length, shaft and grip selections.'

  case product.handle
    when 'cb2-forged-players-cavity-back-irons'
      assign has_structured_specs = true
      assign model_name = 'CB2'
      assign model_type = 'Players cavity iron'
      assign profile_handicap = '0–13'
      assign profile_distance = 3
      assign profile_forgiveness = 4
      assign profile_workability = 4
      assign spec_rows = '4^23°^38.5″^60.5°^0.11″^D3~5^26°^38″^61°^0.10″^D3~6^30°^37.5″^61.5°^0.09″^D3~7^34°^37″^62°^0.08″^D3~8^38°^36.5″^62.5°^0.07″^D3~9^42°^36″^63°^0.06″^D3~PW^46°^35.75″^63.5°^0.05″^D4~AW^50°^35.5″^63.5°^0.04″^D4' | split: '~'
      assign geometry_rows = 'Blade length^3″~Club height^2.1″~Sole width^0.7″' | split: '~'
      assign geometry_label = 'CB2 number 7 iron head geometry'
    when 'cb-players-cavity-back-irons'
      assign has_structured_specs = true
      assign model_name = 'Haywood CB'
      assign model_type = 'Cavity back iron'
      assign profile_handicap = '0–13'
      assign profile_distance = 3
      assign profile_forgiveness = 3
      assign profile_workability = 4
      assign column_labels = 'Loft^Length^Lie^Offset^Bounce^Swing weight' | split: '^'
      assign spec_rows = '4^23°^38.5″^60.5°^0.11″^3°^D2~5^26°^38″^61°^0.10″^4°^D2~6^30°^37.5″^61.5°^0.09″^5°^D2~7^34°^37″^62°^0.08″^6°^D2~8^38°^36.5″^62.5°^0.07″^7°^D2~9^42°^36″^63°^0.06″^8°^D2~PW^46°^35.75″^63.5°^0.05″^9°^D3' | split: '~'
      assign geometry_rows = 'Blade length^3″~Club height^2.1″~Sole width^0.7″' | split: '~'
      assign geometry_label = 'Haywood CB number 7 iron head geometry'
    when 'mb2-forged-muscle-back-irons'
      assign has_structured_specs = true
      assign model_name = 'MB2'
      assign model_type = 'Muscle back iron'
      assign profile_handicap = '0–9'
      assign profile_distance = 3
      assign profile_forgiveness = 3
      assign profile_workability = 5
      assign spec_rows = '4^23°^38.5″^60.5°^0.10″^D3~5^26°^38″^61°^0.09″^D3~6^30°^37.5″^61.5°^0.08″^D3~7^34°^37″^62°^0.07″^D3~8^38°^36.5″^62.5°^0.06″^D3~9^42°^36″^63°^0.05″^D3~PW^46°^35.75″^63.5°^0.04″^D4~AW^50°^35.5″^63.5°^0.03″^D4' | split: '~'
      assign geometry_rows = 'Blade length^3″~Club height^2.1″~Sole width^0.6″' | split: '~'
      assign geometry_label = 'MB2 number 7 iron head geometry'
    when 'mb-muscle-back-blade-irons'
      assign has_structured_specs = true
      assign model_name = 'Haywood MB'
      assign model_type = 'Muscle back blade'
      assign profile_handicap = '0–9'
      assign profile_distance = 3
      assign profile_forgiveness = 2
      assign profile_workability = 5
      assign column_labels = 'Loft^Length^Lie^Offset^Bounce^Swing weight' | split: '^'
      assign spec_rows = '3^20°^39″^60°^0.11″^2°^D2~4^23°^38.5″^60.5°^0.10″^3°^D2~5^26°^38″^61°^0.09″^4°^D2~6^30°^37.5″^61.5°^0.08″^5°^D2~7^34°^37″^62°^0.07″^6°^D2~8^38°^36.5″^62.5°^0.06″^7°^D2~9^42°^36″^63°^0.05″^8°^D2~PW^46°^35.75″^63.5°^0.04″^9°^D3' | split: '~'
      assign geometry_rows = 'Blade length^3″~Club height^2.1″~Sole width^0.6″' | split: '~'
      assign geometry_label = 'Haywood MB number 7 iron head geometry'
    when 'pd-1-players-distance-irons'
      assign has_structured_specs = true
      assign model_name = 'PD.1'
      assign model_type = 'Players distance iron'
      assign profile_handicap = '5–15'
      assign profile_distance = 4
      assign profile_forgiveness = 4
      assign profile_workability = 3
      assign spec_rows = '4^21°^38.5″^61°^0.12″^D1~5^23°^38″^61.5°^0.10″^D1~6^26.5°^37.5″^62°^0.09″^D1~7^30.5°^37″^62.5°^0.08″^D1~8^35°^36.5″^63°^0.07″^D1~9^40°^36″^63.5°^0.06″^D1~PW^45°^35.75″^64°^0.05″^D2~AW^50°^35.5″^64°^0.04″^D2' | split: '~'
      assign geometry_rows = 'Blade length^3″~Top line^0.25″~Sole width^0.75″~Club height^2.2″' | split: '~'
      assign geometry_label = 'PD.1 number 7 iron head geometry'
    when 'sv-2-game-improvement-irons'
      assign has_structured_specs = true
      assign model_name = 'SV.2'
      assign model_type = 'Game improvement iron'
      assign profile_handicap = '15+'
      assign profile_distance = 5
      assign profile_forgiveness = 5
      assign profile_workability = 3
      assign spec_rows = '4^19°^38.5″^61.5°^0.20″^D1~5^22°^38″^62°^0.18″^D1~6^25.5°^37.5″^62.5°^0.16″^D1~7^29.5°^37″^63°^0.13″^D1~8^33.5°^36.5″^63.5°^0.10″^D1~9^38°^36″^64°^0.08″^D1~PW^43°^35.75″^64.5°^0.07″^D2~AW^48°^35.5″^64.5°^0.06″^D2' | split: '~'
      assign geometry_rows = 'Blade length^3.15″~Top line^0.3″~Sole width^0.90″~Club height^2.2″' | split: '~'
      assign geometry_label = 'SV.2 number 7 iron head geometry'
    when 'cb2-mb2-forged-combo-irons'
      assign has_structured_specs = true
      assign model_name = 'CB2 + MB2 Combo'
      assign model_type = 'Forged combo iron set'
      assign item_suffix = blank
      assign profile_handicap = '0–11'
      assign profile_distance = 3
      assign profile_forgiveness = 2
      assign profile_workability = 4
      assign spec_rows = '#4 CB2^23°^38.5″^60.5°^0.11″^D3~#5 CB2^26°^38″^61°^0.10″^D3~#6 CB2^30°^37.5″^61.5°^0.09″^D3~#7 CB2^34°^37″^62°^0.08″^D3~#7 MB2^34°^37″^62°^0.07″^D3~#8 MB2^38°^36.5″^62.5°^0.06″^D3~#9 MB2^42°^36″^63°^0.05″^D3~PW MB2^46°^35.75″^63.5°^0.04″^D4~AW MB2^50°^35.5″^63.5°^0.03″^D4' | split: '~'
      assign geometry_rows = 'CB2 blade length^3″~CB2 club height^2.1″~CB2 sole width^0.7″~MB2 blade length^3″~MB2 club height^2.1″~MB2 sole width^0.6″' | split: '~'
      assign geometry_label = 'CB2 and MB2 number 7 iron head geometry'
    when 'sv-2-pd-1-combo-iron-set'
      assign has_structured_specs = true
      assign model_name = 'SV.2 + PD.1 Combo'
      assign model_type = 'Combo iron set'
      assign item_suffix = blank
      assign profile_handicap = '10–15'
      assign profile_distance = 5
      assign profile_forgiveness = 4
      assign profile_workability = 4
      assign spec_rows = '#4 SV.2^19°^38.5″^61.5°^0.20″^D1~#5 SV.2^22°^38″^62°^0.18″^D1~#6 SV.2^25.5°^37.5″^62.5°^0.16″^D1~#7 SV.2^29.5°^37″^63°^0.13″^D1~#8 PD.1^35°^36.5″^63°^0.07″^D1~#9 PD.1^40°^36″^63.5°^0.06″^D1~PW PD.1^45°^35.75″^64°^0.05″^D2~AW PD.1^50°^35.5″^64°^0.04″^D2' | split: '~'
      assign geometry_rows = 'SV.2 blade length^3.15″~SV.2 top line^0.3″~SV.2 sole width^0.90″~SV.2 club height^2.2″~PD.1 blade length^3″~PD.1 top line^0.25″~PD.1 sole width^0.75″~PD.1 club height^2.2″' | split: '~'
      assign geometry_label = 'SV.2 and PD.1 number 7 iron head geometry'
    when 'adjustable-forgiving-golf-driver'
      assign has_structured_specs = true
      assign model_name = 'Driver'
      assign model_type = 'Adjustable driver'
      assign item_label = 'model'
      assign item_suffix = blank
      assign column_labels = 'Loft^Lie^Head weight^Volume^Standard length^Hosel adjustment^Face material^Body material' | split: '^'
      assign spec_rows = 'Driver^9°, 10.5°^56°^202 g^460 cc^45.25″^Loft −1.5° to +1.5° / lie 4° up^Forged titanium 6A-4V^811 titanium + carbon-fiber crown' | split: '~'
      assign specs_intro = 'Review the driver dimensions, materials and adjustability without opening a separate chart.'
      assign specs_note = blank
    when 'forgiving-fairway-woods'
      assign has_structured_specs = true
      assign model_name = 'Fairway Woods'
      assign model_type = 'Adjustable fairway woods'
      assign item_label = 'wood'
      assign item_suffix = blank
      assign column_labels = 'Loft^Lie^Head weight^Volume^Standard length^Hosel adjustment^Face material^Body material' | split: '^'
      assign spec_rows = '3 Wood^15°^58.5°^212 g^190 cc^43″^Loft −1.5° to +1.5° / lie 4° up^S450 stainless steel^17-4 stainless steel + carbon-fiber crown~5 Wood^18°^59°^216 g^178 cc^42.5″^Loft −1.5° to +1.5° / lie 4° up^S450 stainless steel^17-4 stainless steel + carbon-fiber crown~7 Wood^21°^59.5°^220 g^168 cc^42″^Loft −1.5° to +1.5° / lie 4° up^S450 stainless steel^17-4 stainless steel + carbon-fiber crown' | split: '~'
      assign specs_intro = 'Select a wood on mobile or compare all three lofts, dimensions and materials on desktop.'
      assign specs_note = blank
    when 'forgiving-golf-hybrid'
      assign has_structured_specs = true
      assign model_name = 'Hybrid'
      assign model_type = 'Adjustable hybrid'
      assign item_label = 'hybrid'
      assign item_suffix = blank
      assign column_labels = 'Loft^Lie^Head weight^Standard length^Hosel adjustment^Face material^Body material' | split: '^'
      assign spec_rows = '4 Hybrid^22°^59°^240 g^40″^Loft −1.5° to +1.5° / lie 4° up^17-4 stainless steel^17-4 stainless steel~5 Hybrid^25°^60°^245 g^39.5″^Loft −1.5° to +1.5° / lie 4° up^17-4 stainless steel^17-4 stainless steel' | split: '~'
      assign specs_intro = 'Select a hybrid on mobile or compare both lofts, dimensions and materials on desktop.'
      assign specs_note = blank
    when 'signature-driving-iron-2'
      assign has_structured_specs = true
      assign model_name = 'DI.2'
      assign model_type = 'Driving iron'
      assign item_label = 'build'
      assign item_suffix = blank
      assign column_labels = 'Shaft^Loft^Length^Lie^Offset^Bounce^Swing weight' | split: '^'
      assign spec_rows = '18° Graphite^HZRDUS Smoke Black 80 g^18°^39.75″^60°^0.13″^5°^D1~18° Steel^True Temper Dynamic Gold 130 g^18°^39.75″^60°^0.13″^5°^D5~21° Graphite^HZRDUS Smoke Black 80 g^21°^39.25″^60.5°^0.13″^6°^D1~21° Steel^True Temper Dynamic Gold 130 g^21°^39.25″^60.5°^0.13″^6°^D5' | split: '~'
      assign geometry_rows = 'Blade length^3.11″~Blade height^2.04″~Sole width^1.02″' | split: '~'
      assign geometry_label = 'DI.2 number 3 head geometry'
      assign specs_intro = 'Compare both lofts and stock shaft builds without opening or enlarging a chart.'
      assign specs_note = 'Swing weights are based on standard length with the listed shaft. Actual swing weight varies with custom length, shaft and grip selections.'
    when 'forged-golf-wedges'
      assign has_structured_specs = true
      assign model_name = 'Signature Wedges'
      assign model_type = 'Forged wedges'
      assign item_label = 'wedge'
      assign item_suffix = blank
      assign column_labels = 'Length^Lie^Bounce^Swing weight' | split: '^'
      assign spec_rows = '48° Wedge^35.75″^63.5°^8°^D3~50° Wedge^35.5″^63.5°^10°^D3~52° Wedge^35.5″^63.5°^10°^D3~54° Wedge^35.25″^63.5°^12°^D4~56° Wedge^35.25″^63.5°^12°^D4~58° Wedge^35″^63.5°^10°^D4~60° Wedge^35″^63.5°^10°^D5' | split: '~'
      assign specs_intro = 'Select a loft on mobile or compare every wedge specification on desktop.'
      assign specs_note = blank
    when 'milled-blade-golf-putter'
      assign has_structured_specs = true
      assign model_name = 'Signature Putter'
      assign model_type = 'Precision-milled blade putter'
      assign item_label = 'putter'
      assign item_suffix = blank
      assign column_labels = 'Loft^Lie^Head weight^Offset^Material' | split: '^'
      assign spec_rows = 'Signature Putter^3°^72°^350 g^Full shaft^1020 carbon steel' | split: '~'
      assign specs_intro = 'Review the blade putter geometry and head construction without opening a separate chart.'
      assign specs_note = blank
    when 'mid-mallet-golf-putter'
      assign has_structured_specs = true
      assign model_name = 'Mid-Mallet Putter'
      assign model_type = 'Precision-milled mid-mallet putter'
      assign item_label = 'putter'
      assign item_suffix = blank
      assign column_labels = 'Loft^Lie^Head weight^Offset^Material' | split: '^'
      assign spec_rows = 'Mid-Mallet Putter^3.5°^70°^360 g^3/4 shaft^1020 carbon steel' | split: '~'
      assign specs_intro = 'Review the mid-mallet putter geometry and head construction without opening a separate chart.'
      assign specs_note = blank
  endcase
-%}

{%- if has_structured_specs -%}
  {%- style -%}
    #HaywoodSpecs-{{ section.id }} {
      --hw-navy: #0b2341;
      --hw-gold: #c9a66b;
      --hw-cream: #f3efe7;
      --hw-line: rgba(11, 35, 65, .14);
      --hw-muted: #5d6470;
      padding: clamp(5rem, 7vw, 9rem) 0;
      background: var(--hw-cream);
      color: var(--hw-navy);
    }

    #HaywoodSpecs-{{ section.id }} * { box-sizing: border-box; }

    #HaywoodSpecs-{{ section.id }} .hw-specs__shell {
      width: min(calc(100% - 8rem), 120rem);
      margin-inline: auto;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__header {
      display: grid;
      grid-template-columns: minmax(0, .8fr) minmax(32rem, .45fr);
      gap: clamp(4rem, 8vw, 12rem);
      align-items: end;
      margin-bottom: clamp(3.5rem, 5vw, 6rem);
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__eyebrow,
    #HaywoodSpecs-{{ section.id }} .hw-specs__label {
      margin: 0;
      color: var(--hw-gold);
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: .15em;
      text-transform: uppercase;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__title {
      margin: 1.3rem 0 0;
      color: var(--hw-navy);
      font-family: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
      font-size: clamp(4.2rem, 5vw, 6.8rem);
      font-weight: 400;
      letter-spacing: -.045em;
      line-height: .95;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__model-type {
      margin: 1.4rem 0 0;
      color: var(--hw-muted);
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: .11em;
      text-transform: uppercase;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__intro {
      max-width: 48rem;
      margin: 0;
      color: var(--hw-muted);
      font-size: 1.7rem;
      line-height: 1.65;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__profile {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      margin-bottom: 2.4rem;
      border: 1px solid var(--hw-line);
      background: rgba(255, 255, 255, .55);
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__profile-card {
      min-width: 0;
      padding: 2.2rem 2.4rem;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__profile-card + .hw-specs__profile-card {
      border-left: 1px solid var(--hw-line);
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__profile-card strong {
      display: block;
      margin-top: 1.1rem;
      color: var(--hw-navy);
      font-size: 2.1rem;
      font-weight: 500;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__rating {
      display: flex;
      gap: .65rem;
      margin-top: 1.4rem;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__rating span {
      width: .9rem;
      height: .9rem;
      border: 1px solid rgba(11, 35, 65, .45);
      border-radius: 50%;
      background: transparent;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__rating span.is-filled {
      border-color: var(--hw-navy);
      background: var(--hw-navy);
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__table-card {
      overflow-x: auto;
      border: 1px solid var(--hw-line);
      background: #fff;
      scrollbar-width: thin;
    }

    #HaywoodSpecs-{{ section.id }} table {
      width: 100%;
      min-width: calc(var(--hw-columns) * 10rem);
      border-collapse: collapse;
      table-layout: auto;
      color: var(--hw-navy);
      font-size: 1.6rem;
    }

    #HaywoodSpecs-{{ section.id }} th,
    #HaywoodSpecs-{{ section.id }} td {
      padding: 1.55rem 1.8rem;
      border-bottom: 1px solid var(--hw-line);
      text-align: left;
      overflow-wrap: normal;
      white-space: normal;
    }

    #HaywoodSpecs-{{ section.id }} thead th {
      background: var(--hw-navy);
      color: #fff;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    #HaywoodSpecs-{{ section.id }} tbody th {
      color: var(--hw-navy);
      font-weight: 700;
    }

    #HaywoodSpecs-{{ section.id }} tbody tr:nth-child(even) {
      background: rgba(243, 239, 231, .45);
    }

    #HaywoodSpecs-{{ section.id }} tbody tr:last-child > * { border-bottom: 0; }

    #HaywoodSpecs-{{ section.id }} .hw-specs__note {
      margin: 1.5rem 0 0;
      color: var(--hw-muted);
      font-size: 1.25rem;
      line-height: 1.55;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__geometry {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      margin: 3rem 0 0;
      border: 1px solid var(--hw-line);
      background: rgba(255, 255, 255, .55);
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__geometry div {
      padding: 2rem 2.4rem;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__geometry div + div {
      border-left: 1px solid var(--hw-line);
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__geometry dt {
      color: var(--hw-muted);
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__geometry dd {
      margin: .9rem 0 0;
      color: var(--hw-navy);
      font-family: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
      font-size: 2.6rem;
      line-height: 1;
    }

    #HaywoodSpecs-{{ section.id }} .hw-specs__mobile { display: none; }

    @media screen and (max-width: 749px) {
      #HaywoodSpecs-{{ section.id }} { padding: 4.8rem 0; }

      #HaywoodSpecs-{{ section.id }} .hw-specs__shell {
        width: calc(100% - 4rem);
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__header {
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-bottom: 3.2rem;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__title {
        font-size: clamp(4rem, 13vw, 5.4rem);
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__intro { font-size: 1.6rem; }

      #HaywoodSpecs-{{ section.id }} .hw-specs__profile {
        grid-template-columns: 1fr 1fr;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__profile-card {
        padding: 1.8rem;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__profile-card:nth-child(3) {
        border-left: 0;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__profile-card:nth-child(n+3) {
        border-top: 1px solid var(--hw-line);
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__desktop { display: none; }
      #HaywoodSpecs-{{ section.id }} .hw-specs__mobile { display: block; }

      #HaywoodSpecs-{{ section.id }} .hw-specs__club-picker {
        display: flex;
        gap: .8rem;
        margin: 1.2rem -2rem 0;
        padding: .4rem 2rem 1rem;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scrollbar-width: thin;
        scroll-snap-type: x proximity;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__club-picker button {
        min-width: 5rem;
        min-height: 4.8rem;
        flex: 0 0 auto;
        border: 1px solid var(--hw-line);
        border-radius: 0;
        background: #fff;
        color: var(--hw-navy);
        font: inherit;
        font-size: 1.5rem;
        font-weight: 700;
        scroll-snap-align: start;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__club-picker button[aria-selected="true"] {
        border-color: var(--hw-navy);
        background: var(--hw-navy);
        color: #fff;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__panel {
