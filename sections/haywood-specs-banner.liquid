  {%- endstyle -%}

  <section id="HaywoodSpecs-{{ section.id }}" class="hw-specs" data-hw-specs style="--hw-columns: {{ column_labels.size | plus: 1 }}">
    <div class="hw-specs__shell">
      <header class="hw-specs__header">
        <div>
          <p class="hw-specs__eyebrow">Technical reference</p>
          <h2 class="hw-specs__title" id="full-specs">{{ model_name }} specifications.</h2>
          <p class="hw-specs__model-type">{{ model_type }}</p>
        </div>
        <p class="hw-specs__intro">{{ specs_intro }}</p>
      </header>

      {%- if profile_handicap != blank -%}
        <div class="hw-specs__profile" aria-label="{{ model_name }} player profile">
          <article class="hw-specs__profile-card">
            <p class="hw-specs__label">Player profile</p>
            <strong>{{ profile_handicap }} handicap</strong>
          </article>
          <article class="hw-specs__profile-card">
            <p class="hw-specs__label">Distance</p>
            <div class="hw-specs__rating" aria-label="{{ profile_distance }} out of 5">
              {%- for rating_index in (1..5) -%}<span{% if rating_index <= profile_distance %} class="is-filled"{% endif %} aria-hidden="true"></span>{%- endfor -%}
            </div>
          </article>
          <article class="hw-specs__profile-card">
            <p class="hw-specs__label">Forgiveness</p>
            <div class="hw-specs__rating" aria-label="{{ profile_forgiveness }} out of 5">
              {%- for rating_index in (1..5) -%}<span{% if rating_index <= profile_forgiveness %} class="is-filled"{% endif %} aria-hidden="true"></span>{%- endfor -%}
            </div>
          </article>
          <article class="hw-specs__profile-card">
            <p class="hw-specs__label">Workability</p>
            <div class="hw-specs__rating" aria-label="{{ profile_workability }} out of 5">
              {%- for rating_index in (1..5) -%}<span{% if rating_index <= profile_workability %} class="is-filled"{% endif %} aria-hidden="true"></span>{%- endfor -%}
            </div>
          </article>
        </div>
      {%- endif -%}

      <div class="hw-specs__desktop">
        <div class="hw-specs__table-card">
          <table>
            <caption class="visually-hidden">{{ model_name }} specifications by {{ item_label }}</caption>
            <thead>
              <tr>
                <th scope="col">{{ item_label | capitalize }}</th>
                {%- for column_label in column_labels -%}<th scope="col">{{ column_label }}</th>{%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for spec_row in spec_rows -%}
                {%- assign cells = spec_row | split: '^' -%}
                <tr>
                  <th scope="row">{{ cells[0] }}</th>
                  {%- for column_label in column_labels -%}
                    {%- assign cell_index = forloop.index -%}<td>{{ cells[cell_index] }}</td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>

      <div class="hw-specs__mobile">
        {%- if spec_rows.size > 1 -%}
          <p class="hw-specs__label">Choose a {{ item_label }}</p>
          <div class="hw-specs__club-picker" role="tablist" aria-label="Choose a {{ model_name }} {{ item_label }}">
            {%- for spec_row in spec_rows -%}
              {%- assign cells = spec_row | split: '^' -%}
              <button type="button" role="tab" id="SpecsTab-{{ section.id }}-{{ forloop.index0 }}" aria-controls="SpecsPanel-{{ section.id }}-{{ forloop.index0 }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ cells[0] }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="hw-specs__panels">
          {%- for spec_row in spec_rows -%}
            {%- assign cells = spec_row | split: '^' -%}
            <article class="hw-specs__panel"{% if spec_rows.size > 1 %} role="tabpanel" id="SpecsPanel-{{ section.id }}-{{ forloop.index0 }}" aria-labelledby="SpecsTab-{{ section.id }}-{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}{% endif %}>
              <h3>{{ cells[0] }}{% if item_suffix != blank %} {{ item_suffix }}{% endif %}</h3>
              <dl>
                {%- for column_label in column_labels -%}
                  {%- assign cell_index = forloop.index -%}<div><dt>{{ column_label }}</dt><dd>{{ cells[cell_index] }}</dd></div>
                {%- endfor -%}
              </dl>
            </article>
          {%- endfor -%}
        </div>

        {%- if spec_rows.size > 1 -%}
          <details class="hw-specs__compare-all">
            <summary>Compare all {{ item_label }}s</summary>
            <p class="hw-specs__swipe-hint">Swipe across to review every measurement.</p>
            <div class="hw-specs__mobile-table" tabindex="0" role="region" aria-label="Scrollable {{ model_name }} specifications">
              <table>
                <caption class="visually-hidden">{{ model_name }} specifications by {{ item_label }}</caption>
                <thead>
                  <tr>
                    <th scope="col">{{ item_label | capitalize }}</th>
                    {%- for column_label in column_labels -%}<th scope="col">{{ column_label }}</th>{%- endfor -%}
                  </tr>
                </thead>
                <tbody>
                  {%- for spec_row in spec_rows -%}
                    {%- assign cells = spec_row | split: '^' -%}
                    <tr>
                      <th scope="row">{{ cells[0] }}</th>
                      {%- for column_label in column_labels -%}
                        {%- assign cell_index = forloop.index -%}<td>{{ cells[cell_index] }}</td>
                      {%- endfor -%}
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>
          </details>
        {%- endif -%}
      </div>

      {%- if specs_note != blank -%}<p class="hw-specs__note">{{ specs_note }}</p>{%- endif -%}

      {%- if geometry_rows != blank -%}
        <dl class="hw-specs__geometry" aria-label="{{ geometry_label | default: model_name }}">
          {%- for geometry_row in geometry_rows -%}
            {%- assign geometry_cells = geometry_row | split: '^' -%}
            <div><dt>{{ geometry_cells[0] }}</dt><dd>{{ geometry_cells[1] }}</dd></div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </section>

  <script>
    (() => {
      const root = document.getElementById('HaywoodSpecs-{{ section.id }}');
      if (!root || root.dataset.enhanced === 'true') return;
      root.dataset.enhanced = 'true';

      const tabs = Array.from(root.querySelectorAll('[role="tab"]'));
      const panels = Array.from(root.querySelectorAll('[role="tabpanel"]'));

      const selectTab = (nextTab, moveFocus = false) => {
        tabs.forEach((tab) => {
          const selected = tab === nextTab;
          tab.setAttribute('aria-selected', selected ? 'true' : 'false');
          tab.tabIndex = selected ? 0 : -1;
        });
        panels.forEach((panel) => {
          panel.hidden = panel.id !== nextTab.getAttribute('aria-controls');
        });
        if (moveFocus) nextTab.focus();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          let nextIndex = null;
          if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'Home') nextIndex = 0;
          if (event.key === 'End') nextIndex = tabs.length - 1;
          if (nextIndex === null) return;
          event.preventDefault();
          selectTab(tabs[nextIndex], true);
        });
      });
    })();
  </script>
