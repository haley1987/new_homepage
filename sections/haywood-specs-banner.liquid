        padding: 2rem;
        border: 1px solid var(--hw-line);
        background: #fff;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__panel[hidden] { display: none; }

      #HaywoodSpecs-{{ section.id }} .hw-specs__panel h3 {
        margin: 0 0 1.8rem;
        color: var(--hw-navy);
        font-family: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
        font-size: 3rem;
        font-weight: 400;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__panel dl {
        display: grid;
        grid-template-columns: 1fr 1fr;
        margin: 0;
        border-top: 1px solid var(--hw-line);
        border-left: 1px solid var(--hw-line);
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__panel dl div {
        min-width: 0;
        padding: 1.5rem;
        border-right: 1px solid var(--hw-line);
        border-bottom: 1px solid var(--hw-line);
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__panel dt {
        color: var(--hw-muted);
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__panel dd {
        margin: .7rem 0 0;
        color: var(--hw-navy);
        font-size: 1.8rem;
        font-weight: 600;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__compare-all {
        margin-top: 1.6rem;
        border-top: 1px solid var(--hw-line);
        border-bottom: 1px solid var(--hw-line);
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__compare-all summary {
        display: flex;
        min-height: 5.6rem;
        align-items: center;
        justify-content: space-between;
        color: var(--hw-navy);
        cursor: pointer;
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: .12em;
        list-style: none;
        text-transform: uppercase;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__compare-all summary::-webkit-details-marker { display: none; }
      #HaywoodSpecs-{{ section.id }} .hw-specs__compare-all summary::after { content: '+'; font-size: 2rem; font-weight: 400; }
      #HaywoodSpecs-{{ section.id }} .hw-specs__compare-all[open] summary::after { content: '−'; }

      #HaywoodSpecs-{{ section.id }} .hw-specs__swipe-hint {
        margin: 0 0 1rem;
        color: var(--hw-muted);
        font-size: 1.2rem;
      }

      #HaywoodSpecs-{{ section.id }} .hw-specs__mobile-table {
        max-width: 100%;
        margin-bottom: 1.6rem;
        overflow-x: auto;
        border: 1px solid var(--hw-line);
        background: #fff;
