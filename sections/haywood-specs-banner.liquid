{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{%- style -%}
  /* Keep technical artwork legible without allowing it to become a full-screen banner. */
  #Banner-{{ section.id }} {
    width: 100%;
  }
  #Banner-{{ section.id }} .banner__media { position: relative; }
  #Banner-{{ section.id }} .banner__media::before { content: none; display: none; }
  #Banner-{{ section.id }} .banner__media .banner__media-image {
    position: static;
    display: block;
    width: auto;
    max-width: 86rem;
    height: auto;
    max-height: 48rem;
    margin-inline: auto;
    object-fit: contain;
  }

  #shopify-section-{{ section.id }} {
    padding: clamp(4.5rem, 5vw, 6.5rem) 0;
    background: #f2eee5;
  }

  #shopify-section-{{ section.id }} .hw-specs-shell {
    width: min(calc(100% - 8rem), 100rem);
    margin-inline: auto;
    padding: clamp(3rem, 3vw, 4rem);
    border: 1px solid rgba(11, 35, 65, .14);
    background: #fff;
  }

  #shopify-section-{{ section.id }} .hw-specs-eyebrow {
    margin: 0;
    color: #c9a66b;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} h2.specs_banner_title {
    margin: 1rem 0 3rem;
    color: #0b2341;
    font-family: "Iowan Old Style", "Baskerville", "Times New Roman", serif;
    font-size: clamp(3.8rem, 4.5vw, 5.8rem);
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: .95;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding: 4rem 0;
    }

    #shopify-section-{{ section.id }} .hw-specs-shell {
      width: calc(100% - 4rem);
      padding: 2.4rem 1.6rem;
    }

    #Banner-{{ section.id }} .banner__media .banner__media-image {
      width: 100%;
      max-width: 100%;
      max-height: none;
    }
  }
{%- endstyle -%}


{%- liquid
  assign specs_url = product.metafields['specs-image']['specs-image']
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- comment -%}
  Renders only when product.metafields['specs-image']['specs-image'] (URL) is present.
  If empty, the section outputs nothing (self-hiding).
{%- endcomment -%}
{%- if specs_url != blank -%}
<div class="hw-specs-shell">
  <p class="hw-specs-eyebrow">Technical reference</p>
  <h2 class="specs_banner_title" id="full-specs">Full specifications</h2>
  <div
    id="Banner-{{ section.id }}"
    class="banner banner--content-align-center banner--{{ section.settings.image_height }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    <div class="banner__media media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <img
        src="{{ specs_url | escape }}"
        alt="{{ product.title | escape }} specifications"
        width="1600"
        height="1600"
        class="banner__media-image"
        loading="lazy"
        decoding="async"
        fetchpriority="{{ fetch_priority }}"
      >
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Specs Image Banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "select",
      "id": "image_height",
      "label": "Image height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Specs Image Banner (URL metafield)" }]
}
{% endschema %}
