{%- comment -%}
  Blog (list) — Dawn-friendly
  - Keeps Dawn page-width + H1 styling
  - No paginate (Shopify caps at 50 items via blog.articles)
  - Removes component-article-card/card includes and grid/collage layout
  - Optional toggles: image, date, excerpt, excerpt length
{%- endcomment -%}

{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  /* Keep Dawn’s adjustable section padding */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>

/* right-column image + uniform crop */
.blog-list {
  --thumb-width: 320px;   /* image column width on desktop (tweak as needed) */
  --thumb-ratio: 16/9;    /* crop: try 3/2 or 4/3 if you prefer */
  display: grid;
  gap: 2rem;
  padding: 0;
}

.blog-list__item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--thumb-width); /* text | image */
  gap: 1.25rem;
  align-items: start; /* use 'center' if you want vertical centering */
      border-bottom: 1px solid lightgrey;
    padding-bottom: 2rem;
}

/* when there’s no image, don’t reserve the right column */
.blog-list__item--no-image {
  grid-template-columns: 1fr;
}

/* uniform crop box on the right */
.blog-list__thumb {
  display: block;
  width: 100%;
  aspect-ratio: var(--thumb-ratio);
  overflow: hidden;
}
.blog-list__thumb img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;     /* crop to the box */
  object-position: center;
}

/* tidy text spacing + keep link color consistent */
.blog-list__body { margin: 0; }
.blog-list__date { opacity: .7; margin: 0 0 .25rem; }
.blog-list__title { margin: .1rem 0 .5rem; }
.main-blog .blog-list__title a,
.main-blog .blog-list__title a:visited { color: inherit; text-decoration: none; }

/* mobile: stack, image first, then text */
@media (max-width: 749px) {
  .blog-list__item { grid-template-columns: 1fr; }
  .blog-list__thumb { grid-row: 1; }
  .blog-list__body  { grid-row: 2; margin-top: .75rem; }
}

</style>

<div class="main-blog page-width section-{{ section.id }}-padding">
  <h1 class="title--primary{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ blog.title | escape }}
  </h1>

{%- assign articles = blog.articles -%}

{%- if articles.size > 0 -%}
  <ul class="blog-list" role="list">
    {%- for article in articles -%}

      {%- liquid
        assign has_thumb = false
        if section.settings.show_image and article.image != blank
          assign has_thumb = true
        endif
      -%}

      <li
        class="blog-list__item{% if has_thumb == false %} blog-list__item--no-image{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
          style="--animation-order: {{ forloop.index }};"
        {% endif %}
      >
        <!-- text (left) -->
        <div class="blog-list__body">
          {%- if section.settings.show_date -%}
            <p class="blog-list__date">{{ article.published_at | date: "%B %e, %Y" }}</p>
          {%- endif -%}

          <h2 class="blog-list__title">
            <a href="{{ article.url }}">{{ article.title }}</a>
          </h2>

          {%- if section.settings.show_excerpt -%}
            <p class="blog-list__excerpt">
              {{ article.excerpt_or_content | strip_html | truncatewords: section.settings.excerpt_words }}
            </p>
          {%- endif -%}
        </div>

        <!-- image (right) -->
        {%- if has_thumb -%}
          <a class="blog-list__thumb" href="{{ article.url }}">
            {{ article.image
              | image_url: width: 1200
              | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 480px, 100vw',
                  alt: article.image.alt | escape }}
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
{%- else -%}
  <p>No blog posts found.</p>
{%- endif -%}


</div>

{% schema %}
{
  "name": "Blog (list)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Show image", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "range", "id": "excerpt_words", "label": "Excerpt length", "min": 10, "max": 60, "step": 5, "default": 30 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ]
}
{% endschema %}
