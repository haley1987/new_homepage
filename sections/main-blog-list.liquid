{%- if blog.handle == 'press' -%}
  {{ 'haywood-press.css' | asset_url | stylesheet_tag }}
  {%- render 'haywood-press-page', press_blog: blog -%}
{%- else -%}
{%- comment -%}Haywood Journal index{%- endcomment -%}
{{ 'haywood-journal.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign journal_eyebrow = section.settings.eyebrow | default: 'Haywood Journal'
  assign journal_heading = section.settings.heading | default: 'Better golf, understood.'
  assign journal_intro = section.settings.intro | default: 'Equipment insight, fitting knowledge and stories from the workshop—written to help you make clearer decisions about your game.'
  assign featured_label = section.settings.featured_label | default: 'Featured story'
  assign latest_heading = section.settings.latest_heading | default: 'Latest from the Journal'
-%}

<section class="hw-journal">
  <header class="hw-journal__hero">
    <div class="hw-journal__shell hw-journal__hero-inner">
      <p class="hw-journal__eyebrow">{{ journal_eyebrow | escape }}</p>
      <h1 class="hw-journal__title">{{ journal_heading | escape }}</h1>
      <p class="hw-journal__intro">{{ journal_intro | escape }}</p>
    </div>
  </header>

  <div class="hw-journal__shell hw-journal__content">
    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles.size > 0 -%}
        {%- assign article_offset = 0 -%}

        {%- if paginate.current_page == 1 -%}
          {%- assign featured_article = blog.articles.first -%}
          {%- assign featured_alt = featured_article.image.alt | default: featured_article.title -%}
          {%- assign article_offset = 1 -%}

          <article class="hw-journal-feature">
            <a class="hw-journal-feature__media" href="{{ featured_article.url }}" aria-label="{{ featured_article.title | escape }}">
              {%- if featured_article.image != blank -%}
                {{ featured_article.image
                  | image_url: width: 2000
                  | image_tag:
                    loading: 'eager',
                    fetchpriority: 'high',
                    widths: '550, 750, 1100, 1500, 2000',
                    sizes: '(min-width: 750px) 66vw, 100vw',
                    alt: featured_alt
                }}
              {%- else -%}
                <span class="hw-journal-feature__placeholder" aria-hidden="true"></span>
              {%- endif -%}
            </a>

            <div class="hw-journal-feature__body">
              <span class="hw-journal-feature__label">{{ featured_label | escape }} · {{ featured_article.published_at | date: '%B %e, %Y' }}</span>
              <h2 class="hw-journal-feature__title">
                <a class="hw-journal-feature__link" href="{{ featured_article.url }}">{{ featured_article.title | escape }}</a>
              </h2>
              {%- if section.settings.show_excerpt -%}
                <p class="hw-journal-feature__excerpt">
                  {{ featured_article.excerpt_or_content | strip_html | truncatewords: section.settings.excerpt_words }}
                </p>
              {%- endif -%}
              <a class="hw-journal-feature__cta" href="{{ featured_article.url }}">Read the story <span aria-hidden="true">→</span></a>
            </div>
          </article>
        {%- endif -%}

        <div class="hw-journal__latest-head">
          <div>
            <p class="hw-journal__section-label">Journal</p>
            <h2 class="hw-journal__latest-title">{{ latest_heading | escape }}</h2>
          </div>
          <p class="hw-journal__count">{{ blog.articles_count }} article{% unless blog.articles_count == 1 %}s{% endunless %}</p>
        </div>

        <ul class="hw-journal__grid" role="list">
          {%- for article in blog.articles offset: article_offset -%}
            {%- assign article_alt = article.image.alt | default: article.title -%}
            <li class="hw-journal-card">
              <article>
                <a class="hw-journal-card__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
                  {%- if section.settings.show_image and article.image != blank -%}
                    {{ article.image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '360, 550, 750, 960, 1200',
                        sizes: '(min-width: 990px) 31vw, (min-width: 750px) 48vw, 100vw',
                        alt: article_alt
                    }}
                  {%- else -%}
                    <span class="hw-journal-card__placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </a>
                <div class="hw-journal-card__body">
                  {%- if section.settings.show_date -%}
                    <time class="hw-journal-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %e, %Y' }}</time>
                  {%- endif -%}
                  <h3 class="hw-journal-card__title">
                    <a class="hw-journal-card__link" href="{{ article.url }}">{{ article.title | escape }}</a>
                  </h3>
                  {%- if section.settings.show_excerpt -%}
                    <p class="hw-journal-card__excerpt">
                      {{ article.excerpt_or_content | strip_html | truncatewords: section.settings.excerpt_words }}
                    </p>
                  {%- endif -%}
                  <a class="hw-journal-card__cta" href="{{ article.url }}">Read article <span aria-hidden="true">→</span></a>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- else -%}
        <p class="hw-journal__empty">No Journal stories have been published yet.</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Haywood Journal",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Haywood Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better golf, understood." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Equipment insight, fitting knowledge and stories from the workshop—written to help you make clearer decisions about your game." },
    { "type": "text", "id": "featured_label", "label": "Featured article label", "default": "Featured story" },
    { "type": "text", "id": "latest_heading", "label": "Article grid heading", "default": "Latest from the Journal" },
    { "type": "checkbox", "id": "show_image", "label": "Show article images", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show article dates", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpts", "default": true },
    { "type": "range", "id": "excerpt_words", "label": "Excerpt length", "min": 12, "max": 50, "step": 2, "default": 24 },
    { "type": "range", "id": "articles_per_page", "label": "Articles per page", "min": 7, "max": 25, "step": 3, "default": 13 }
  ]
}
{% endschema %}
