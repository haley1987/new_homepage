{%- if product.handle == '7-iron-purchase-program' -%}
  <script>document.documentElement.classList.add('hw7-program-page');</script>
  {%- liquid
    assign sv2_product = all_products['sv-2-game-improvement-irons']
    assign pd1_product = all_products['pd-1-players-distance-irons']
    assign cb2_product = all_products['cb2-forged-players-cavity-back-irons']
    assign mb2_product = all_products['mb2-forged-muscle-back-irons']
  -%}

  <div
    class="hw7p"
    id="hw7-program"
    data-product-url="{{ product.url }}"
    data-sv2-image="{{ sv2_product.featured_image | image_url: width: 1200 }}"
    data-pd1-image="{{ pd1_product.featured_image | image_url: width: 1200 }}"
    data-cb2-image="{{ cb2_product.featured_image | image_url: width: 1200 }}"
    data-mb2-image="{{ mb2_product.featured_image | image_url: width: 1200 }}"
  >
    <section class="hw7p-hero">
      <div class="hw7p-hero-copy">
        <p class="hw7p-kicker">Try before you build</p>
        <h1>One iron.<br>Zero guesswork.</h1>
        <p class="hw7p-lede">Build a brand-new 7-iron to your specs. Play it on your course. Then receive a credit equal to the <strong>7-iron item price</strong>, before tax and shipping, toward a qualifying full set.</p>
        <div class="hw7p-actions">
          <a class="hw7p-button" href="#hw7-models">Compare the irons <span aria-hidden="true">→</span></a>
          <a class="hw7p-text-link" href="#hw7-how">See how the program works</a>
        </div>
        <ul class="hw7p-trust" role="list">
          <li><span aria-hidden="true">✓</span> Brand new—not a demo</li>
          <li><span aria-hidden="true">✓</span> Built to your specs</li>
          <li><span aria-hidden="true">✓</span> Yours to keep</li>
        </ul>
      </div>
      <div class="hw7p-hero-visual">
        <div class="hw7p-stamp"><strong>7-IRON</strong><span>item price<br>credited</span></div>
        <img
          class="hw7p-hero-image"
          src="{{ pd1_product.featured_image | image_url: width: 1200 }}"
          alt="PD.1 7-iron"
          width="1200"
          height="1200"
          loading="eager"
        >
        <div class="hw7p-viewing"><span>Currently viewing</span><strong>PD.1 · Players distance</strong></div>
      </div>
    </section>

    <section class="hw7p-how" id="hw7-how" aria-labelledby="hw7-how-title">
      <div class="hw7p-section-heading">
        <p class="hw7p-kicker">How the program works</p>
        <h2 id="hw7-how-title">A smarter way to commit to a set.</h2>
      </div>
      <ol class="hw7p-steps">
        <li><span>01</span><div><h3>Build one.</h3><p>Choose your model, shaft, grip and adjustments.</p></div></li>
        <li><span>02</span><div><h3>Play it.</h3><p>Test your actual club—not a worn stock demo.</p></div></li>
        <li><span>03</span><div><h3>Get the credit.</h3><p>When you are ready, receive a code equal to the 7-iron item price, before tax and shipping.</p></div></li>
      </ol>
    </section>

    <section class="hw7p-models" id="hw7-models" aria-labelledby="hw7-models-title">
      <div class="hw7p-models-intro">
        <div><p class="hw7p-kicker">Choose your profile</p><h2 id="hw7-models-title">Four distinct ways to play.</h2></div>
        <p>The lineup moves from maximum help and easy launch to maximum feedback and shot control. There is no universally best iron—only the best starting point for your game.</p>
      </div>

      <div class="hw7p-fit" aria-label="Choose an iron starting point">
        <div class="hw7p-fit-heading">
          <span>Choose a starting point</span>
          <strong>Which description sounds most like your game?</strong>
          <p>This is guidance—not a fitting. You can change your selection before ordering.</p>
          <a class="hw7p-fit-quiz" href="/pages/fitting-tool">Take the full fitting quiz <span aria-hidden="true">→</span></a>
        </div>
        <div class="hw7p-fit-options">
          <button type="button" data-model="sv2"><span>Maximum help</span><small>I want the easiest launch and most stability.</small><b>SV.2</b></button>
          <button type="button" class="is-active" data-model="pd1"><span>Speed + forgiveness</span><small>I want distance in a compact profile.</small><b>PD.1</b></button>
          <button type="button" data-model="cb2"><span>Forged feel + support</span><small>I want control with help on slight misses.</small><b>CB2</b></button>
          <button type="button" data-model="mb2"><span>Forged precision</span><small>I want maximum feedback and shot shaping.</small><b>MB2</b></button>
        </div>
      </div>

      <p class="hw7p-swipe" aria-label="Swipe to compare all four irons"><span>Swipe</span><i aria-hidden="true"></i><b aria-hidden="true">→</b></p>
      <div class="hw7p-grid">
        <article class="hw7p-card" id="hw7-model-sv2" data-card-model="sv2">
          <div class="hw7p-card-image">
            <span class="hw7p-flag">Most forgiving</span>
            <img src="{{ sv2_product.featured_image | image_url: width: 700 }}" alt="SV.2 iron" width="700" height="700" loading="lazy">
            <span class="hw7p-check" aria-hidden="true">✓</span>
          </div>
          <div class="hw7p-card-copy">
            <p class="hw7p-category">Game improvement</p><h3>SV.2</h3><strong>Easy launch. Maximum help.</strong>
            <p>Golfers prioritizing launch, speed and stability across the face.</p>
            <span class="hw7p-profile">Player profile · 15+ handicap</span>
            <dl>
              <div><dt>Distance</dt><dd><span class="hw7p-meter" aria-label="5 out of 5"><i></i><i></i><i></i><i></i><i></i></span></dd></div>
              <div><dt>Forgiveness</dt><dd><span class="hw7p-meter" aria-label="5 out of 5"><i></i><i></i><i></i><i></i><i></i></span></dd></div>
              <div><dt>Workability</dt><dd><span class="hw7p-meter" aria-label="3 out of 5"><i></i><i></i><i></i><i class="is-empty"></i><i class="is-empty"></i></span></dd></div>
            </dl>
            <button class="hw7p-select" type="button" data-model="sv2" data-configure-model>Configure SV.2 <span aria-hidden="true">→</span></button>
          </div>
        </article>

        <article class="hw7p-card is-selected" id="hw7-model-pd1" data-card-model="pd1">
          <div class="hw7p-card-image">
            <span class="hw7p-flag">Best all-rounder</span>
            <img src="{{ pd1_product.featured_image | image_url: width: 700 }}" alt="PD.1 iron" width="700" height="700" loading="lazy">
            <span class="hw7p-check" aria-hidden="true">✓</span>
          </div>
          <div class="hw7p-card-copy">
            <p class="hw7p-category">Players distance</p><h3>PD.1</h3><strong>Speed in a cleaner shape.</strong>
            <p>Golfers wanting speed and forgiveness in a more compact players profile.</p>
            <span class="hw7p-profile">Player profile · 5–15 handicap</span>
            <dl>
              <div><dt>Distance</dt><dd><span class="hw7p-meter" aria-label="4 out of 5"><i></i><i></i><i></i><i></i><i class="is-empty"></i></span></dd></div>
              <div><dt>Forgiveness</dt><dd><span class="hw7p-meter" aria-label="4 out of 5"><i></i><i></i><i></i><i></i><i class="is-empty"></i></span></dd></div>
              <div><dt>Workability</dt><dd><span class="hw7p-meter" aria-label="3 out of 5"><i></i><i></i><i></i><i class="is-empty"></i><i class="is-empty"></i></span></dd></div>
            </dl>
            <button class="hw7p-select" type="button" data-model="pd1" data-configure-model>Configure PD.1 <span aria-hidden="true">→</span></button>
          </div>
        </article>

        <article class="hw7p-card" id="hw7-model-cb2" data-card-model="cb2">
          <div class="hw7p-card-image">
            <img src="{{ cb2_product.featured_image | image_url: width: 700 }}" alt="CB2 iron" width="700" height="700" loading="lazy">
            <span class="hw7p-check" aria-hidden="true">✓</span>
          </div>
          <div class="hw7p-card-copy">
            <p class="hw7p-category">Forged players cavity</p><h3>CB2</h3><strong>Forged feel. Added support.</strong>
            <p>Golfers wanting forged feel and control with added support on slight misses.</p>
            <span class="hw7p-profile">Player profile · 0–13 handicap</span>
            <dl>
              <div><dt>Distance</dt><dd><span class="hw7p-meter" aria-label="3 out of 5"><i></i><i></i><i></i><i class="is-empty"></i><i class="is-empty"></i></span></dd></div>
              <div><dt>Forgiveness</dt><dd><span class="hw7p-meter" aria-label="4 out of 5"><i></i><i></i><i></i><i></i><i class="is-empty"></i></span></dd></div>
              <div><dt>Workability</dt><dd><span class="hw7p-meter" aria-label="4 out of 5"><i></i><i></i><i></i><i></i><i class="is-empty"></i></span></dd></div>
            </dl>
            <button class="hw7p-select" type="button" data-model="cb2" data-configure-model>Configure CB2 <span aria-hidden="true">→</span></button>
          </div>
        </article>

        <article class="hw7p-card" id="hw7-model-mb2" data-card-model="mb2">
          <div class="hw7p-card-image">
            <span class="hw7p-flag">Most workable</span>
            <img src="{{ mb2_product.featured_image | image_url: width: 700 }}" alt="MB2 iron" width="700" height="700" loading="lazy">
            <span class="hw7p-check" aria-hidden="true">✓</span>
          </div>
          <div class="hw7p-card-copy">
            <p class="hw7p-category">Forged muscle back</p><h3>MB2</h3><strong>Forged precision. Total control.</strong>
            <p>Consistent ball strikers prioritizing feedback, precision and shot shaping.</p>
            <span class="hw7p-profile">Player profile · 0–9 handicap</span>
            <dl>
              <div><dt>Distance</dt><dd><span class="hw7p-meter" aria-label="3 out of 5"><i></i><i></i><i></i><i class="is-empty"></i><i class="is-empty"></i></span></dd></div>
              <div><dt>Forgiveness</dt><dd><span class="hw7p-meter" aria-label="3 out of 5"><i></i><i></i><i></i><i class="is-empty"></i><i class="is-empty"></i></span></dd></div>
              <div><dt>Workability</dt><dd><span class="hw7p-meter" aria-label="5 out of 5"><i></i><i></i><i></i><i></i><i></i></span></dd></div>
            </dl>
            <button class="hw7p-select" type="button" data-model="mb2" data-configure-model>Configure MB2 <span aria-hidden="true">→</span></button>
          </div>
        </article>
      </div>

      <p class="hw7p-source">Ratings and player profiles are taken directly from each model’s Haywood product specifications. Your delivery, strike pattern and preferred flight still matter. <a href="/pages/compare-irons">View the full iron comparison →</a></p>
      <p class="hw7p-return-note">Custom-built 7-irons are non-refundable and non-returnable.</p>

    </section>

    <section class="hw7p-credit">
      <div class="hw7p-credit-copy">
        <p class="hw7p-kicker">How the credit works</p>
        <h2>The club stays with you. Its value moves forward.</h2>
        <p>There is no return step or rental fee. You keep the 7-iron. If you order a qualifying full set, Haywood provides a discount code equal to the 7-iron item price. Tax and shipping are not included in the credit.</p>
        <p class="hw7p-assurance"><strong>No deadline.</strong> Your discount code never expires, so play the 7-iron for as long as you need before deciding.</p>
        <p class="hw7p-important"><strong>Clear before you order:</strong> because the club is made for you, it is non-refundable and non-returnable.</p>
      </div>
      <ol class="hw7p-credit-steps">
        <li><span>01</span><strong>Buy your 7-iron</strong><p>Pay for one new club built to your specifications.</p></li>
        <li><span>02</span><strong>Play it</strong><p>Test it on the range and course for as long as you need. The club is yours to keep.</p></li>
        <li><span>03</span><strong>Build your set</strong><p>Apply a code equal to the 7-iron item price, before tax and shipping, to a qualifying full set.</p></li>
      </ol>
    </section>

    <section class="hw7p-proof">
      <div class="hw7p-rating"><div aria-label="5 out of 5 stars">★★★★★</div><strong>4.9 / 5</strong></div>
      <blockquote>“Fantastic club. The sound, the look, the feel—never mind how easy it is to hit. So happy with it, purchased the rest without a second thought.”<footer>Adam · Toronto, Canada · Verified buyer</footer></blockquote>
    </section>

    <section class="hw7p-faq">
      <div class="hw7p-faq-intro">
        <p class="hw7p-kicker">Know before you build</p>
        <h2>Questions, answered.</h2>
        <p>Still unsure about your model or specifications? Our builders can point you in the right direction.</p>
        <a href="/pages/contact">Talk to the Haywood team →</a>
      </div>
      <div class="hw7p-faq-list">
        <details open><summary>Is this a demo or used club?</summary><p>Neither. Your 7-iron is brand new and built to the specifications you choose—just like a club from your eventual set.</p></details>
        <details><summary>How does the full-set credit work?</summary><p>When you are ready to order a qualifying full set, Haywood provides a discount code equal to the 7-iron item price, before tax and shipping. The code never expires, so you can take as long as you need to decide.</p></details>
        <details><summary>Does my full set have to match the 7-iron?</summary><p>No. You can move to another qualifying Haywood iron model or use a blended-set configuration when you build the full set.</p></details>
        <details><summary>Can I return the 7-iron?</summary><p>Because each club is custom-built to your specifications, the 7-iron purchase is non-refundable and non-returnable.</p></details>
      </div>
    </section>

    <section class="hw7p-final">
      <p>Built for the way you play</p>
      <h2>Start with one swing<br>you can trust.</h2>
      <span>Choose your model. Build your 7-iron. Know what belongs in the bag.</span>
      <a class="hw7p-button" data-configure-final href="{{ product.url }}?apo-cfg=19917664,19917666,19917671,19917675,19917680,19917690,19917715,19917718,19917730,19917736,19917743,19917748,19917751#hw7-configurator">Configure Your 7 Iron <b aria-hidden="true">→</b></a>
    </section>
    <div id="hw7-configurator" class="hw7p-configurator-anchor" aria-hidden="true"></div>
  </div>

  <style>
    .hw7p{--navy:#10213e;--deep:#0b1830;--ink:#111a2a;--paper:#f7f5f0;--white:#fcfbf8;--mist:#e9eef1;--gold:#b7a064;--line:#d9d8d3;--muted:#60646b;color:var(--ink);background:var(--white);font-family:var(--font-body-family),Arial,sans-serif;line-height:1.5}
    .hw7p *{box-sizing:border-box}.hw7p a{color:inherit;text-decoration:none}.hw7p button{font:inherit}.hw7p h1,.hw7p h2,.hw7p h3{font-family:Iowan Old Style,Baskerville,Georgia,serif;font-weight:400;letter-spacing:-.045em}.hw7p :where(a,button,summary):focus-visible{outline:2px solid var(--gold);outline-offset:4px}.hw7p #hw7-how,.hw7p #hw7-models{scroll-margin-top:88px}
    .hw7p-kicker{display:flex;align-items:center;gap:12px;margin:0 0 24px;color:#756230;font-size:10px;font-weight:700;letter-spacing:.25em;text-transform:uppercase}.hw7p-kicker:before{content:'';width:28px;height:1px;background:var(--gold)}
    .hw7p-hero{min-height:calc(100svh - 96px);display:grid;grid-template-columns:.9fr 1.1fr;background:#fff;overflow:hidden}.hw7p-hero-copy{align-self:center;padding:clamp(70px,8vw,132px) clamp(32px,4.8vw,80px)}.hw7p-hero h1{max-width:660px;margin:0;color:var(--navy);font-size:clamp(70px,7vw,118px);line-height:.82}.hw7p-lede{max-width:635px;margin:38px 0 0;color:#3f4248;font-family:Iowan Old Style,Baskerville,Georgia,serif;font-size:clamp(19px,1.55vw,26px);line-height:1.52}.hw7p-lede strong{color:var(--ink)}.hw7p-actions{display:flex;align-items:center;gap:30px;margin-top:34px}.hw7p-button{display:inline-flex;align-items:center;justify-content:center;gap:30px;min-height:58px;padding:0 28px;background:var(--navy);color:#fff!important;font-size:11px;font-weight:750;letter-spacing:.13em;text-transform:uppercase;transition:transform .2s}.hw7p-button:hover{transform:translateY(-2px)}.hw7p-text-link{border-bottom:1px solid #8d8f93;padding:9px 0;font-size:13px;font-weight:650}.hw7p-trust{display:flex;flex-wrap:wrap;gap:18px 28px;margin:34px 0 0;padding:24px 0 0;border-top:1px solid var(--line);list-style:none;color:#555b63;font-size:11px}.hw7p-trust li{display:flex;align-items:center;gap:7px}.hw7p-trust li span{color:#897544}
    .hw7p-hero-visual{position:relative;min-height:690px;display:flex;align-items:center;justify-content:center;background:#edf2f4;overflow:hidden}.hw7p-hero-image{width:82%;height:auto;max-height:90%;object-fit:contain;filter:drop-shadow(0 24px 25px rgba(16,33,62,.16));mix-blend-mode:multiply}.hw7p-stamp{position:absolute;right:7%;top:12%;width:132px;aspect-ratio:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:50%;background:var(--gold);color:var(--deep);text-align:center;transform:rotate(7deg);z-index:2;box-shadow:0 20px 40px rgba(16,33,62,.13)}.hw7p-stamp strong{font:italic 700 34px/1 Georgia,serif}.hw7p-stamp span{margin-top:6px;font-size:8px;font-weight:800;line-height:1.15;letter-spacing:.08em;text-transform:uppercase}.hw7p-viewing{position:absolute;left:7%;bottom:6%;display:flex;flex-direction:column;gap:7px;min-width:250px;padding:18px 20px;border-left:3px solid var(--gold);background:rgba(252,251,248,.94);box-shadow:0 14px 35px rgba(16,33,62,.08)}.hw7p-viewing span{font-size:9px;color:#64686d;text-transform:uppercase;letter-spacing:.16em}.hw7p-viewing strong{font-size:12px;text-transform:uppercase;letter-spacing:.09em}
    .hw7p-how{padding:clamp(72px,8vw,126px) clamp(24px,7vw,110px);background:var(--navy);color:#fff}.hw7p-how .hw7p-kicker{color:#c5b27e}.hw7p-how h2,.hw7p-how h3{color:#fff}.hw7p-section-heading{display:grid;grid-template-columns:.55fr 1fr;gap:40px;align-items:end;max-width:1500px;margin:auto}.hw7p-section-heading h2,.hw7p-models-intro h2{margin:0;font-size:clamp(44px,5vw,78px);line-height:.97}.hw7p-steps{max-width:1500px;margin:78px auto 0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(255,255,255,.24)}.hw7p-steps li{display:grid;grid-template-columns:auto 1fr;gap:24px;padding:34px 34px 0 0;border-right:1px solid rgba(255,255,255,.18)}.hw7p-steps li+li{padding-left:34px}.hw7p-steps li:last-child{border-right:0}.hw7p-steps li>span{color:#c7b581;font-family:Georgia,serif;font-size:26px}.hw7p-steps h3{margin:0 0 9px;font-size:25px;letter-spacing:0}.hw7p-steps p{margin:0;color:#bdc5d0;font-size:14px;line-height:1.6}
    .hw7p-models{padding:clamp(75px,8vw,132px) clamp(24px,5vw,78px);background:var(--white)}.hw7p-models-intro{max-width:1460px;margin:auto;display:grid;grid-template-columns:1.15fr .6fr;gap:90px;align-items:end}.hw7p-models-intro h2{max-width:820px;color:var(--navy)}.hw7p-models-intro>p{margin:0 0 5px;color:#5d6268;font-family:Georgia,serif;font-size:19px;line-height:1.55}
