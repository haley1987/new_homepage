  </style>

  <script>
    (function () {
      var root = document.getElementById('hw7-program');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      var models = {
        sv2: { name: 'SV.2', category: 'Game improvement', config: '19917665' },
        pd1: { name: 'PD.1', category: 'Players distance', config: '19917666' },
        cb2: { name: 'CB2', category: 'Forged players cavity', config: '19917667' },
        mb2: { name: 'MB2', category: 'Forged muscle back', config: '19917668' }
      };
      var defaults = ['19917664','19917671','19917675','19917680','19917690','19917715','19917718','19917730','19917736','19917743','19917748','19917751'];
      var selected = 'pd1';
      var currentConfig = new URLSearchParams(window.location.search).get('apo-cfg') || '';
      Object.keys(models).forEach(function (key) {
        if (currentConfig.split(',').indexOf(models[key].config) !== -1) selected = key;
      });

      function configurationUrl(key) {
        var ids = [defaults[0], models[key].config].concat(defaults.slice(1));
        return root.dataset.productUrl + '?apo-cfg=' + ids.join(',') + '#hw7-configurator';
      }

      function update(key, reveal) {
        selected = key;
        var model = models[key];
        root.querySelectorAll('[data-card-model]').forEach(function (card) {
          card.classList.toggle('is-selected', card.dataset.cardModel === key);
        });
        root.querySelectorAll('[data-model]').forEach(function (button) {
          var active = button.dataset.model === key;
          if (button.closest('.hw7p-fit-options')) button.classList.toggle('is-active', active);
          if (button.classList.contains('hw7p-select')) {
            button.removeAttribute('aria-pressed');
            button.innerHTML = 'Configure ' + models[button.dataset.model].name + ' <span aria-hidden="true">→</span>';
          }
        });
        var heroImage = root.querySelector('.hw7p-hero-image');
        heroImage.src = root.dataset[key + 'Image'];
        heroImage.alt = model.name + ' 7-iron';
        root.querySelector('.hw7p-viewing strong').textContent = model.name + ' · ' + model.category;
        if (reveal && window.matchMedia('(max-width: 749px)').matches) {
          document.getElementById('hw7-model-' + key).scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
        }
      }

      root.querySelectorAll('[data-model]').forEach(function (button) {
        button.addEventListener('click', function () {
          var shouldConfigure = button.hasAttribute('data-configure-model');
          update(button.dataset.model, !shouldConfigure);
          if (shouldConfigure) launchConfigurator(button.dataset.model, true);
        });
      });
      root.querySelector('[data-configure-final]').addEventListener('click', function (event) {
        event.preventDefault();
        launchConfigurator(selected, true);
      });
      update(selected, false);

      function launchConfigurator(key, updateAddress) {
        var openAttempts = 0;
        function openConfiguratorWhenReady() {
          var overlay = document.getElementById('ConfigDrawer');
          var modelInput = document.getElementById('v_' + models[key].config);
          var optionsReady = overlay && overlay.querySelector('.mw-option');
          if ((!optionsReady || !modelInput) && openAttempts < 80) {
            openAttempts += 1;
            window.setTimeout(openConfiguratorWhenReady, 100);
            return;
          }
          if (!overlay) return;
          if (modelInput && !modelInput.checked) modelInput.click();
          overlay.setAttribute('open', 'true');
          document.body.classList.add('overlay-open');
          var stickyBar = document.getElementById('StickyConfigBar');
          if (stickyBar) stickyBar.style.display = 'none';
        }
        if (updateAddress && window.history && window.history.replaceState) {
          window.history.replaceState(null, '', configurationUrl(key));
        }
        openConfiguratorWhenReady();
      }

      if (window.location.hash === '#hw7-configurator' && currentConfig) {
        launchConfigurator(selected, false);
      }
    })();
  </script>
{%- endif -%}

