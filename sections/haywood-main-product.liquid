  :root{
    --left-nav-gap: 20%;  /* adjust if your left nav width changes */
    --crisp-gap: 190px;     /* ~ Crisp widget width + padding */
  }

  .sticky-config-bar {
position: fixed;
  bottom: 20px;
  left: 20vw;
  right: 190px;
  background-color: #000000eb;
  color: #fff;
  display: none;
  justify-content: space-between;
  align-items: center;
  padding: 14px 20px;
  z-index: 10;
  border-radius: 12px;
  box-shadow: 0 6px 20px #0000004d;
  font-size: 16px;
  font-weight: 500;
  pointer-events: auto;
  max-width: calc(100% - 450px);

  }

  .sticky-config-bar span {
    font-size: 15px;
    display: inline-block;
    margin-right: 12px;
  }

  .sticky-config-bar button {
background: #ffd600;
  color: #000;
  border: 2px solid black;
  padding: 10px 16px;
  font-weight: 700;
  text-transform: uppercase;
  border-radius: 9999px;
  font-size: 13px;
  white-space: nowrap;
  cursor: pointer;
  }

  /* Mobile / tablet */
  @media (max-width: 989px) {
    :root{
      --left-nav-gap: 0px;
      --crisp-gap: 0px;
    }
    .sticky-config-bar {
      left: 0; right: 0; bottom: 0;
      max-width: 100%;
      padding: 16px;
      flex-direction: column;
      gap: 10px;
      text-align: center;
      border-radius: 0;
      /* Safe area iPhone notches */
      padding-bottom: calc(16px + env(safe-area-inset-bottom, 0));
    }
    .sticky-config-bar button {
      width: 100%;
      margin-right: 0;
    }
  }

  /* Respect a sticky page footer / cookie banners: nudge up slightly if they overlap */
  .has-cookie-banner .sticky-config-bar { bottom: 72px; }

  /* Optional: fade-in transition */
  .sticky-config-bar[data-visible="true"] { display: flex; animation: bar-in .18s ease-out both; }
  @keyframes bar-in { from { transform: translateY(10px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

 div.product__tax.caption.rte {
