  {{ 'haywood-commerce.css' | asset_url | stylesheet_tag }}
  {% liquid
  assign has_apo = true
  if product.type == 'Gift Card' or product.type == 'Merch'
    assign has_apo = false
  endif
  if product.tags contains 'force-native' or product.tags contains 'native-variants'
    assign has_apo = false
  endif
  if product.tags contains 'force-apo'
    assign has_apo = true
  endif

  assign hw_display_title = product.title
  assign hw_display_title = hw_display_title | replace: "Haywood CB's", "Haywood CB"
  assign hw_display_title = hw_display_title | replace: "Haywood MB's", "Haywood MB"
  assign hw_display_title = hw_display_title | replace: ' (Game Improvement Model)', ''
  assign hw_display_title = hw_display_title | replace: ' (Players Distance Model)', ''

  assign hw_product_eyebrow = 'Haywood Golf'
  if product.type contains 'Iron' or product.title contains 'Iron' or product.title contains 'CB' or product.title contains 'MB' or product.title contains 'PD.1' or product.title contains 'SV.2'
    assign hw_product_eyebrow = 'Forged irons'
  elsif product.title contains 'Driver' or product.title contains 'Fairway' or product.title contains 'Hybrid'
    assign hw_product_eyebrow = 'Woods and hybrids'
  elsif product.title contains 'Wedge'
    assign hw_product_eyebrow = 'Wedges'
  elsif product.title contains 'Putter'
    assign hw_product_eyebrow = 'Putters'
  endif

  assign hw_product_summary = product.metafields.custom.product_subtitle.value
  if hw_product_summary == blank
    assign hw_product_summary = product.metafields.custom.short_description.value
  endif
  if product.title contains 'CB'
    assign hw_product_summary = 'A compact cavity profile balancing forged feel, control and forgiveness.'
  elsif product.title contains 'MB'
    assign hw_product_summary = 'A muscle-back profile created for feedback, precision and workability.'
  elsif product.title contains 'PD.1'
    assign hw_product_summary = 'Players distance performance in a clean, confidence-inspiring profile.'
  elsif product.title contains 'SV.2'
    assign hw_product_summary = 'Forgiveness, launch and speed for golfers who want help without excess bulk.'
  elsif hw_product_summary == blank
    assign hw_product_summary = 'Purpose-built performance, configured around the way you play.'
  endif
%}

