/* --- Product CTAs (vintage style) --- */
.hw-ctas { display:flex; flex-direction:column; gap:8px; margin-top:12px; }

/* Pill buttons */
.hw-btn {
  display:block; width:100%;
  padding:16px 20px;
  border-radius:9999px;
  text-transform:uppercase; letter-spacing:.08em;
  font-weight:700; font-size:12px; line-height:1; text-align:center;
  transition:opacity .15s ease, background-color .15s ease, color .15s ease, border-color .15s ease;
  cursor: pointer;
}
.hw-btn--primary { background:#000; color:#fff; border:1px solid #000; }
.hw-btn--primary:hover { opacity:.92; }

.hw-btn--ghost { background:#fff; color:#000; border:1.5px solid #000; text-decoration: none;}
.hw-btn--ghost:hover { background:#f6f6f6; text-decoration: none; }

/* Quiz link */
.hw-quiz-link { display:inline-block; margin-top:6px; font-size:13px; text-decoration:underline; color:#1a1a1a; }

/* Trust bullets */
.hw-objections { margin-top:16px; padding: 16px 0 !important; border-top:1px solid #e5e7eb; }
.hw-objections__list { list-style:none; margin:0; padding:0; color:#1f2937; }

/* ===== Description (bullets-first) ===== */
.product-description-bullets {
    margin-top: 0px !important;
    border-bottom: 1px solid #e5e7eb;
}

div.product-description-bullets.rte > ul {
    padding-left: 0;
}

/* --- Unify typography for trust + description blocks --- */
.hw-objections,
.product-description-bullets {
  color: #111827;           /* same gray-900 */
  font-size: 15px;          /* for mobile, overriden below */
  line-height: 1.6;
  padding: 16px 0 !important;
  border-top: 1px solid #e5e7eb;
  margin-top: 1.5rem;
  margin-bottom: 0;
}



/* Bold consistency in both blocks */
.hw-objections__list li strong,
.product-description-bullets li strong {
  font-weight: 700;
}

/* Optional: tighten the small “Benefits:” lead-in */
.product-description-bullets p:first-child {
  margin-bottom: .75rem;
}


/* Collapsible details */
.hw-desc__more { margin-top: .5rem; }
.hw-link {
  display: inline-block;
  color: #1d4ed8;            /* blue-600 */
  text-decoration: underline;
  cursor: pointer;
  list-style: none;          /* hide default marker in FF */
  font-size: 1.5rem;
}
.hw-link::-webkit-details-marker { display: none; } /* hide default marker in WebKit */

/* Inject “Read More ›” / “Read Less ›” via CSS */
.hw-link::after { content: 'Read More ›'; }
.hw-desc__more[open] .hw-link::after { content: 'See Less ‹'; }

/* Body inside the disclosure */
.hw-desc__body { margin-top: .75rem; }




/* — Why Players Choose Haywood — */
.why-players { background:#f9f6f1; padding:2rem; }
.why-players__title { text-align:center; font-weight: 700; margin-bottom:1.5rem; }
.why-players__grid { display:flex; flex-wrap:wrap; margin:-1rem 0 0 -1rem; margin-top: 1rem;}
.why-point { box-sizing:border-box; width:100%; padding:1.5rem 2rem; border-top:1px solid #ddd;  }
@media(min-width:750px) {
  .why-point { width:50%; }
  .why-point:nth-child(odd)  { border-right:1px solid #ddd; }
  .why-point:nth-child(-n+2){ border-top:none; }
}
.why-point__header { display:flex; align-items:center; gap:.5rem; }
.why-point__emoji  { font-size:2rem; line-height:1; }
.why-point__title  { margin:0; font-weight:600; font-size:1.8rem; }
.why-point__text   { margin:.5rem 0 0; color:#333; line-height:1.4; font-size:1.5rem; }

/* why_players section wrapper */
.why-players { margin-inline: 2rem; margin-top: 4rem; }                 /* mobile default */
@media screen and (min-width: 750px){
  .why-players { margin-inline: 3rem; }               /* desktop */
