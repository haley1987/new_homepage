{{ 'haywood-woods-feature.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign image_alt = section.settings.image_alt | default: section.settings.heading
-%}

<section
  class="hw-section hw-woods"
  style="--hw-woods-background: {{ section.settings.background_color }}; --hw-woods-panel: {{ section.settings.panel_color }}; --hw-woods-heading: {{ section.settings.heading_color }}; --hw-woods-text: {{ section.settings.text_color }}; --hw-woods-desktop-position: {{ section.settings.desktop_position }}; --hw-woods-mobile-position: {{ section.settings.mobile_position }};"
>
  <div class="hw-shell">
    <div class="hw-woods__panel">
      <div class="hw-woods__media">
        <picture>
          {%- if mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 900 }} 900w"
              sizes="100vw"
            >
          {%- endif -%}

          {%- if desktop_image != blank -%}
            {{ desktop_image
              | image_url: width: 2200
              | image_tag:
                loading: 'lazy',
                widths: '750, 1100, 1500, 1800, 2200',
                sizes: '(min-width: 990px) 62vw, 100vw',
                alt: image_alt
            }}
          {%- else -%}
            <img
              src="{{ 'haywood-woods-feature.jpg' | asset_url }}"
              width="1535"
              height="1025"
              loading="lazy"
              alt="{{ image_alt | escape }}"
            >
          {%- endif -%}
        </picture>
      </div>

      <div class="hw-woods__content">
        {% render 'haywood-arc-mark', variant: 'woods' %}
        <div class="hw-woods__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="hw-woods__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="hw-woods__body rte">{{ section.settings.body }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
            <a class="hw-button hw-button--light" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood woods feature",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Haywood driver, fairway wood and hybrid" },
    { "type": "select", "id": "desktop_position", "label": "Desktop image position", "options": [
      { "value": "left center", "label": "Left" },
      { "value": "center center", "label": "Center" },
      { "value": "right center", "label": "Right" }
    ], "default": "center center" },
    { "type": "select", "id": "mobile_position", "label": "Mobile image position", "options": [
      { "value": "left center", "label": "Left" },
      { "value": "center center", "label": "Center" },
      { "value": "right center", "label": "Right" }
    ], "default": "center center" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Woods & Hybrids" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Confidence from the tee." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Adjustable drivers, fairway woods and hybrids built to deliver speed, control and a clean look at address.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Woods & Hybrids" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#f2eee5" },
    { "type": "color", "id": "panel_color", "label": "Text panel background", "default": "#0b2341" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#c7cfda" }
  ],
  "presets": [{ "name": "Haywood woods feature" }]
}
{% endschema %}
