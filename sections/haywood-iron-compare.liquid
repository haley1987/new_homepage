{{ 'haywood-iron-compare.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign trial_product = section.settings.trial_product
  assign combo_product = section.settings.combo_product
  assign forged_combo_product = section.settings.forged_combo_product
-%}

<main class="hw-compare">
  <header class="hw-compare__hero">
    <div class="hw-compare__shell">
      <div class="hw-compare__hero-grid">
        <div>
          <p class="hw-compare__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h1 class="hw-compare__title">{{ section.settings.heading | escape }}</h1>
          <p class="hw-compare__lede">{{ section.settings.intro | escape }}</p>
        </div>
        <aside class="hw-compare__hero-aside">
          <strong>{{ section.blocks.size }} profiles</strong>
          <p>{{ section.settings.aside_copy | escape }}</p>
        </aside>
      </div>

      <nav class="hw-compare__quick-nav" aria-label="Jump to an iron model">
        {%- for block in section.blocks -%}
          {%- assign compare_product = block.settings.product -%}
          {%- if compare_product != blank -%}
            <a href="#compare-{{ compare_product.handle }}">{{ block.settings.short_name | default: compare_product.title | escape }}</a>
          {%- endif -%}
          {%- if forloop.index == 2 and combo_product != blank -%}
            <a href="#compare-{{ combo_product.handle }}">SV.2 + PD.1 Combo</a>
          {%- endif -%}
          {%- if forloop.index == 4 and forged_combo_product != blank -%}
            <a href="#compare-{{ forged_combo_product.handle }}">CB2 + MB2 Combo</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  </header>

  <section class="hw-compare__section" aria-labelledby="CompareModels-{{ section.id }}">
    <div class="hw-compare__shell">
      <div class="hw-compare__section-heading">
        <div>
          <p class="hw-compare__eyebrow">Choose your profile</p>
          <h2 id="CompareModels-{{ section.id }}">Four distinct ways to play.</h2>
        </div>
        <p>{{ section.settings.models_intro | escape }}</p>
      </div>

      <div class="hw-compare__models">
        {%- for block in section.blocks -%}
          {%- assign compare_product = block.settings.product -%}
          {%- if compare_product != blank -%}
            <article class="hw-compare-card" id="compare-{{ compare_product.handle }}" {{ block.shopify_attributes }}>
              <a class="hw-compare-card__media" href="{{ compare_product.url }}" aria-label="Explore {{ block.settings.short_name | default: compare_product.title | escape }}">
                {%- if compare_product.featured_image != blank -%}
                  {{ compare_product.featured_image | image_url: width: 1200 | image_tag:
                    widths: '480, 720, 960, 1200',
                    sizes: '(min-width: 1200px) 28vw, (min-width: 750px) 48vw, 100vw',
                    loading: 'lazy',
                    alt: compare_product.featured_image.alt | default: compare_product.title
                  }}
                {%- endif -%}
              </a>
              <div class="hw-compare-card__body">
                <p class="hw-compare-card__position">{{ block.settings.position | escape }}</p>
                <h3>{{ block.settings.short_name | default: compare_product.title | escape }}</h3>
                <p class="hw-compare-card__best">{{ block.settings.best_for | escape }}</p>
                <a class="hw-compare-card__link" href="{{ compare_product.url }}">Explore model <span aria-hidden="true">→</span></a>
              </div>
            </article>
          {%- endif -%}
          {%- if forloop.index == 2 and combo_product != blank -%}
          <article class="hw-compare-combo" id="compare-{{ combo_product.handle }}">
            <a class="hw-compare-combo__media" href="{{ combo_product.url }}" aria-label="Explore the SV.2 and PD.1 combo set">
              {%- if combo_product.featured_image != blank -%}
                {{ combo_product.featured_image | image_url: width: 1200 | image_tag:
                  widths: '480, 720, 960, 1200',
                  sizes: '(min-width: 1200px) 28vw, (min-width: 750px) 48vw, 100vw',
                  loading: 'lazy',
                  alt: combo_product.featured_image.alt | default: combo_product.title
                }}
              {%- endif -%}
            </a>
            <div class="hw-compare-combo__body">
              <p class="hw-compare-card__position">Combo set</p>
              <h3>SV.2 + PD.1</h3>
              <p class="hw-compare-card__best">Easy-launching SV.2 long irons paired with compact PD.1 scoring irons.</p>
              <a class="hw-compare-card__link" href="{{ combo_product.url }}">Explore combo set <span aria-hidden="true">→</span></a>
            </div>
          </article>
          {%- endif -%}

          {%- if forloop.index == 4 and forged_combo_product != blank -%}
          <article class="hw-compare-combo" id="compare-{{ forged_combo_product.handle }}">
            <a class="hw-compare-combo__media" href="{{ forged_combo_product.url }}" aria-label="Explore the CB2 and MB2 combo set">
              {%- if forged_combo_product.featured_image != blank -%}
                {{ forged_combo_product.featured_image | image_url: width: 1200 | image_tag:
                  widths: '480, 720, 960, 1200',
                  sizes: '(min-width: 1200px) 28vw, (min-width: 750px) 48vw, 100vw',
                  loading: 'lazy',
                  alt: forged_combo_product.featured_image.alt | default: forged_combo_product.title
                }}
              {%- endif -%}
            </a>
            <div class="hw-compare-combo__body">
              <p class="hw-compare-card__position">Combo set</p>
              <h3>CB2 + MB2</h3>
              <p class="hw-compare-card__best">Forgiving CB2 long irons paired with precise, workable MB2 scoring irons.</p>
              <a class="hw-compare-card__link" href="{{ forged_combo_product.url }}">Explore combo set <span aria-hidden="true">→</span></a>
            </div>
          </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="hw-compare__section hw-compare__section--paper" aria-labelledby="CompareTable-{{ section.id }}">
    <div class="hw-compare__shell">
      <div class="hw-compare__section-heading">
        <div>
          <p class="hw-compare__eyebrow">At a glance</p>
          <h2 id="CompareTable-{{ section.id }}">See the differences.</h2>
        </div>
        <p>These are relative comparisons within the Haywood iron lineup. Your delivery, strike pattern and preferred flight still matter.</p>
      </div>

      <p class="hw-compare__swipe-note" aria-hidden="true">Swipe to compare →</p>
      <div class="hw-compare__table-wrap" tabindex="0" aria-label="Scrollable iron model comparison">
        <table class="hw-compare__table">
          <thead>
            <tr>
              <th scope="col">Characteristic</th>
              {%- for block in section.blocks -%}
                <th scope="col">{{ block.settings.short_name | escape }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Profile</th>
              {%- for block in section.blocks -%}<td>{{ block.settings.position | escape }}</td>{%- endfor -%}
            </tr>
            <tr>
              <th scope="row">Forgiveness</th>
              {%- for block in section.blocks -%}<td>{{ block.settings.forgiveness | escape }}</td>{%- endfor -%}
            </tr>
            <tr>
              <th scope="row">Launch</th>
              {%- for block in section.blocks -%}<td>{{ block.settings.launch | escape }}</td>{%- endfor -%}
            </tr>
            <tr>
              <th scope="row">Workability</th>
              {%- for block in section.blocks -%}<td>{{ block.settings.workability | escape }}</td>{%- endfor -%}
            </tr>
            <tr>
              <th scope="row">Best starting point</th>
              {%- for block in section.blocks -%}<td>{{ block.settings.best_for | escape }}</td>{%- endfor -%}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="hw-compare__section" aria-labelledby="CompareSpecs-{{ section.id }}">
    <div class="hw-compare__shell">
      <div class="hw-compare__section-heading">
        <div>
          <p class="hw-compare__eyebrow">Technical specifications</p>
          <h2 id="CompareSpecs-{{ section.id }}">Go deeper when you need to.</h2>
        </div>
        <p>Open any model to review the same live, responsive specification chart used on its product page—no image zooming required.</p>
      </div>

      <div class="hw-compare__specs">
        {%- for block in section.blocks -%}
          {%- assign compare_product = block.settings.product -%}
          {%- if compare_product != blank -%}
            <details class="hw-compare-spec"{% if forloop.first %} open{% endif %}>
              <summary>
                <strong>{{ block.settings.short_name | escape }}</strong>
                <span>View specifications</span>
              </summary>
              <div class="hw-compare-spec__panel">
                {%- capture chart_instance_id -%}{{ section.id }}-{{ forloop.index0 }}{%- endcapture -%}
                {%- render 'haywood-iron-spec-chart', iron_product: compare_product, instance_id: chart_instance_id -%}
                <a class="hw-compare-spec__link" href="{{ compare_product.url }}#full-specs">View on the product page</a>
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- if trial_product != blank -%}
    <section class="hw-compare__section hw-compare__section--paper" aria-labelledby="CompareTrial-{{ section.id }}">
      <div class="hw-compare__shell">
        <div class="hw-compare__trial">
          <a class="hw-compare__trial-media" href="{{ trial_product.url }}" aria-label="Explore the 7-Iron Purchase Program">
            {%- if trial_product.featured_image != blank -%}
              {{ trial_product.featured_image | image_url: width: 1400 | image_tag:
                widths: '600, 900, 1200, 1400',
                sizes: '(min-width: 990px) 58vw, 100vw',
                loading: 'lazy',
                alt: trial_product.featured_image.alt | default: trial_product.title
              }}
            {%- endif -%}
          </a>
          <div class="hw-compare__trial-copy">
            <p class="hw-compare__eyebrow">The 7-Iron Purchase Program</p>
            <h2 id="CompareTrial-{{ section.id }}">Still deciding? Start with one.</h2>
            <p>{{ section.settings.trial_copy | escape }}</p>
            <div class="hw-compare__actions">
              <a class="hw-compare__button" href="{{ trial_product.url }}">Build your 7-iron</a>
              <a class="hw-compare__button hw-compare__button--secondary" href="{{ section.settings.fit_link }}">Find My Fit</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
</main>

{% schema %}
{
  "name": "Haywood iron comparison",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMPARE HAYWOOD IRONS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the profile that fits your game." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Compare the SV.2, PD.1, CB2 and MB2 by forgiveness, launch, workability and player profile—then explore the model that feels right." },
    { "type": "textarea", "id": "aside_copy", "label": "Hero supporting copy", "default": "Start with the performance characteristics you value most. Use Find My Fit if you would rather receive a recommendation." },
    { "type": "textarea", "id": "models_intro", "label": "Model section copy", "default": "The lineup moves from maximum help and easy launch to maximum feedback and shot control. There is no universally best iron—only the best starting point for your game." },
    { "type": "product", "id": "combo_product", "label": "SV.2 + PD.1 combo product" },
    { "type": "product", "id": "forged_combo_product", "label": "CB2 + MB2 combo product" },
    { "type": "product", "id": "trial_product", "label": "7-Iron Program product" },
    { "type": "textarea", "id": "trial_copy", "label": "7-Iron Program copy", "default": "Order one brand-new 7-iron built to your specifications. If you move into the full set, its purchase price is applied toward your order." },
    { "type": "url", "id": "fit_link", "label": "Find My Fit link" }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Iron model",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "short_name", "label": "Short model name" },
        { "type": "text", "id": "position", "label": "Profile" },
        { "type": "textarea", "id": "best_for", "label": "Best for" },
        { "type": "text", "id": "forgiveness", "label": "Relative forgiveness" },
        { "type": "text", "id": "launch", "label": "Relative launch" },
        { "type": "text", "id": "workability", "label": "Relative workability" }
      ]
    }
  ],
  "presets": [
    { "name": "Haywood iron comparison" }
  ]
}
{% endschema %}
