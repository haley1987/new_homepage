{%- comment -%}
  FAQ Accordion — Dawn-friendly (no JS)
  • Uses <details>/<summary> for native toggle + accessibility
  • Per-block alignment + richtext content
  • Minimal, isolated CSS namespaced by section.id
{%- endcomment -%}

{%- style -%}
/* --- Scoped to this section only --- */
.faq-{{ section.id }}{ max-width:1200px;}
.faq-{{ section.id }}__heading { margin:0 0 24px; font-size:clamp(22px, 2vw, 28px);}
.faq-{{ section.id }}__list { display:grid; gap:8px; }

.faq-{{ section.id }} details {
  border-bottom: 1.5px solid #1c3a3a;
  padding: 0;
}

.faq-{{ section.id }} summary {
  list-style: none;
  cursor: pointer;
  padding: 20px 0;
  font-size: 20px;
  line-height: 1.3;
  font-weight: 700;
  display:flex; align-items:center; justify-content:space-between;
}

/* Remove default marker and add our own + / – */
.faq-{{ section.id }} summary::-webkit-details-marker { display:none; }
.faq-{{ section.id }} summary::after{
  content:"";
  flex: 0 0 24px;
  width:24px; height:24px;
  background-repeat:no-repeat; background-size:contain;
  background-image:url('https://cdn.shopify.com/s/files/1/0066/1202/5428/files/icons8-plus-math-60.png?v=1673907287');
}
.faq-{{ section.id }} details[open] summary::after{
  background-image:url('https://cdn.shopify.com/s/files/1/0066/1202/5428/files/icons8-subtract-60.png?v=1673907287');
}

.faq-{{ section.id }}__panel {
  padding: 0 0 18px 0;
  animation: faq-{{ section.id }}-open .25s ease;
}
@keyframes faq-{{ section.id }}-open { from{opacity:0} to{opacity:1} }

.faq-{{ section.id }}__panel .rte { max-width: 100%; }
.faq-{{ section.id }}__item--align-left  { text-align:left; }
.faq-{{ section.id }}__item--align-center{ text-align:center; }
.faq-{{ section.id }}__item--align-right { text-align:right; }

/* Optional section padding controls */
.section-{{ section.id }}-padding{
  padding-left: 1rem !important;
  padding-right: 1rem !important;
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}
@media (min-width: 750px){
  .section-{{ section.id }}-padding{
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

@media (min-width: 990px){
.faq-{{ section.id }}{ }
}
{%- endstyle -%}

<section class="section-{{ section.id }}-padding">
  <div class="faq-{{ section.id }}">
    {%- if section.settings.title != blank -%}
      <h2 class="faq-{{ section.id }}__heading">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="faq-{{ section.id }}__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign align = block.settings.alignment -%}
        <details class="faq-{{ section.id }}__item faq-{{ section.id }}__item--align-{{ align }}"
                 {% if block.settings.open_by_default %}open{% endif %}
                 {{ block.shopify_attributes }}>
          <summary>{{ block.settings.heading | escape }}</summary>
          <div class="faq-{{ section.id }}__panel">
            <div class="rte">{{ block.settings.body }}</div>
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "FAQs" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "heading", "label": "Question", "default": "What is your return policy?" },
        { "type": "richtext", "id": "body", "label": "Answer", "default": "<p>Answer text goes here.</p>" },
        {
          "type": "select",
          "id": "alignment",
          "label": "Text alignment",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        { "type": "checkbox", "id": "open_by_default", "label": "Open by default", "default": false }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    { "name": "FAQ Accordion", "category": "Text" }
  ]
}
{% endschema %}
