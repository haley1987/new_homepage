{{ 'haywood-faq.css' | asset_url | stylesheet_tag }}
<script src="{{ 'haywood-faq.js' | asset_url }}" defer="defer"></script>

<section class="hwfaq" data-hwfaq>
  <div class="hwfaq__hero">
    <div class="hwfaq__shell hwfaq__hero-inner">
      <p class="hwfaq__eyebrow"><span></span>{{ section.settings.eyebrow | escape }}</p>
      <h1 class="hwfaq__title">{{ section.settings.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="hwfaq__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </div>
    {%- render 'haywood-arc-mark', variant: 'faq' -%}
  </div>

  <div class="hwfaq__body">
    <div class="hwfaq__shell">
      <div class="hwfaq__toolbar">
        <div>
          <p class="hwfaq__section-label">FREQUENTLY ASKED QUESTIONS</p>
          <h2>Start with the essentials.</h2>
        </div>

        <div class="hwfaq__search-wrap">
          <label for="FaqSearch-{{ section.id }}">Search FAQs</label>
          <div class="hwfaq__search-field">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
            <input
              id="FaqSearch-{{ section.id }}"
              type="search"
              placeholder="{{ section.settings.search_placeholder | escape }}"
              autocomplete="off"
              data-hwfaq-search
            >
          </div>
        </div>
      </div>

      <div class="hwfaq__list" data-hwfaq-list>
        {%- assign category_keys = 'choosing|fitting|trying|orders' | split: '|' -%}
        {%- assign faq_index = 0 -%}
        {%- for category_key in category_keys -%}
          {%- case category_key -%}
            {%- when 'choosing' -%}
              {%- assign category_title = 'Choosing your clubs' -%}
            {%- when 'fitting' -%}
              {%- assign category_title = 'Custom fitting and specifications' -%}
            {%- when 'trying' -%}
              {%- assign category_title = 'Trying and ordering' -%}
            {%- when 'orders' -%}
              {%- assign category_title = 'Orders, shipping and returns' -%}
          {%- endcase -%}

          {%- assign category_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.category == category_key -%}
              {%- assign category_count = category_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if category_count > 0 -%}
            <section class="hwfaq__group" data-hwfaq-group aria-labelledby="FaqCategory-{{ section.id }}-{{ category_key }}">
              <div class="hwfaq__group-heading">
                <p>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
                <h3 id="FaqCategory-{{ section.id }}-{{ category_key }}">{{ category_title }}</h3>
              </div>

              <div class="hwfaq__group-items">
                {%- for block in section.blocks -%}
                  {%- if block.settings.category == category_key -%}
                    {%- assign faq_index = faq_index | plus: 1 -%}
                    <details
                      class="hwfaq__item"
                      data-hwfaq-item
                      data-search-text="{{ category_title | append: ' ' | append: block.settings.heading | append: ' ' | append: block.settings.body | strip_html | downcase | escape }}"
                      {% if block.settings.open_by_default %}open data-open-by-default{% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <summary>
                        <span class="hwfaq__number" aria-hidden="true">{{ faq_index | prepend: '0' | slice: -2, 2 }}</span>
                        <span class="hwfaq__question">{{ block.settings.heading | escape }}</span>
                        <span class="hwfaq__toggle" aria-hidden="true"></span>
                      </summary>
                      <div class="hwfaq__panel">
                        <div class="rte">{{ block.settings.body }}</div>
                      </div>
                    </details>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </section>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <p class="hwfaq__empty" data-hwfaq-empty hidden>No matching questions. Try a different search or contact our team.</p>
    </div>
  </div>

  <div class="hwfaq__contact">
    <div class="hwfaq__shell hwfaq__contact-inner">
      <div>
        <p class="hwfaq__contact-eyebrow">{{ section.settings.contact_eyebrow | escape }}</p>
        <h2>{{ section.settings.contact_heading | escape }}</h2>
        <p>{{ section.settings.contact_copy | escape }}</p>
      </div>
      <a class="hwfaq__button" href="mailto:{{ section.settings.contact_email | escape }}">
        {{ section.settings.contact_label | escape }} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.heading | strip | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.body | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HELP & SUPPORT"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Questions, answered."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Quick answers about fittings, custom builds, returns and ordering."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search by topic or question"
    },
    {
      "type": "header",
      "content": "Contact call to action"
    },
    {
      "type": "text",
      "id": "contact_eyebrow",
      "label": "Eyebrow",
      "default": "STILL NEED HELP?"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Heading",
      "default": "Talk to a real person."
    },
    {
      "type": "textarea",
      "id": "contact_copy",
      "label": "Copy",
      "default": "Use the chat in the corner or email our team. We’ll help you find the right answer."
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Button label",
      "default": "EMAIL OUR TEAM"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email address",
      "default": "info@haywoodgolf.com"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            {
              "value": "choosing",
              "label": "Choosing your clubs"
            },
            {
              "value": "fitting",
              "label": "Custom fitting and specifications"
            },
            {
              "value": "trying",
              "label": "Trying and ordering"
            },
            {
              "value": "orders",
              "label": "Orders, shipping and returns"
            }
          ],
          "default": "choosing"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Answer",
          "default": "<p>Answer text goes here.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "FAQ Accordion",
      "category": "Text"
    }
  ]
}
{% endschema %}
