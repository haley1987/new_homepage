<section class="hw-section hw-process">
  <div class="hw-shell">
    <header class="hw-process__header">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="hw-copy">{{ section.settings.body }}</div>{%- endif -%}
    </header>
    <div class="hw-process__grid">
      {%- for block in section.blocks -%}
        <article class="hw-process__step" {{ block.shopify_attributes }}>
          <span class="hw-process__number">0{{ forloop.index }}</span>
          <div>
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: class: 'hw-process__image', widths: '400, 600, 900', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw', loading: 'lazy' }}{%- endif -%}
            <h3 class="hw-process__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.copy != blank -%}<p class="hw-process__copy">{{ block.settings.copy | escape }}</p>{%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood build process",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for you, not pulled from a shelf." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Every set follows a deliberate path from specification to final inspection.</p>" }
  ],
  "blocks": [
    { "type": "step", "name": "Process step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Designed" },
      { "type": "textarea", "id": "copy", "label": "Copy", "default": "Purposeful shapes, materials and specifications selected for performance." },
      { "type": "image_picker", "id": "image", "label": "Image" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Haywood build process", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
