<section class="hw-section hw-process">
  <div class="hw-shell">
    <header class="hw-process__header">
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="hw-title hw-title--medium">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="hw-copy">{{ section.settings.body }}</div>{%- endif -%}
    </header>

    <div class="hw-process__grid">
      {%- for block in section.blocks -%}
        <article class="hw-process__step" {{ block.shopify_attributes }}>
          <div class="hw-process__text">
            <span class="hw-process__number">0{{ forloop.index }}</span>
            <h3 class="hw-process__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.copy != blank -%}<p class="hw-process__copy">{{ block.settings.copy | escape }}</p>{%- endif -%}
          </div>
          <div class="hw-process__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 900 | image_tag: class: 'hw-process__image', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 13vw, 46vw', loading: 'lazy' }}
            {%- else -%}
              <div class="hw-process__placeholder" data-image-purpose="{{ block.settings.image_purpose | escape }}">
                <span>{{ block.settings.image_purpose | escape }}</span>
              </div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood build process",
  "settings": [
    { "type": "image_picker", "id": "workshop_image", "label": "Workshop image" },
    { "type": "image_picker", "id": "workshop_mobile_image", "label": "Mobile workshop image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made one set at a time." },
    { "type": "richtext", "id": "body", "label": "Body" }
  ],
  "blocks": [
    { "type": "step", "name": "Process step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Designed" },
      { "type": "textarea", "id": "copy", "label": "Copy", "default": "Purpose shaped by performance." },
      { "type": "image_picker", "id": "image", "label": "Step image" },
      { "type": "text", "id": "image_purpose", "label": "Placeholder label", "default": "PROCESS PHOTOGRAPHY" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Haywood build process", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
