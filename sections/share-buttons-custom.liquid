{%- comment -%}
  sections/share-row-custom.liquid
  - Dawn-friendly, self-contained
  - 4 equal boxes: Facebook / X(Twitter) / Pinterest / Instagram
  - Instagram: uses Web Share API on capable devices, else copies link
{%- endcomment -%}

{%- liquid
  # Title to share
  if template.name == 'product' and product
    assign share_title = product.title | escape
  elsif template.name == 'article' and article
    assign share_title = article.title | escape
  else
    assign share_title = shop.name | escape
  endif

  # Absolute URL
  if template.name == 'product' and product
    assign share_path = product.url
  elsif template.name == 'article' and article
    assign share_path = article.url
  else
    assign share_path = request.path
  endif
  assign share_abs = request.origin | append: share_path

  # Pinterest image (products only)
  assign pin_image = nil
  if template.name == 'product' and product
    assign media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
    if media and media.preview_image
      assign pin_image = media.preview_image | image_url: width: 1200
    elsif media
      assign pin_image = media | image_url: width: 1200
    endif
  endif
-%}

<section class="section section--share-row">
  <div class="page-width">
    <h2 class="h4">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading | escape }}
      {%- elsif template.name == 'product' and product -%}
        Share our {{ product.title }}
      {%- elsif template.name == 'article' and article -%}
        Share {{ article.title }}
      {%- else -%}
        Share
      {%- endif -%}
    </h2>

    <div class="share-row" role="group" aria-label="Share buttons">
      {%- if section.settings.enable_facebook -%}
      <a class="share-row__item" target="_blank" rel="noopener"
         href="https://www.facebook.com/sharer.php?u={{ share_abs | url_encode }}"
         aria-label="Share on Facebook">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9V12.1h2.54V9.96c0-2.5 1.49-3.88 3.77-3.88 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.87h-2.34V22c4.78-.79 8.44-4.94 8.44-9.94Z"/></svg>
        <span>{{ section.settings.label_facebook }}</span>
      </a>
      {%- endif -%}

      {%- if section.settings.enable_twitter -%}
      <a class="share-row__item" target="_blank" rel="noopener"
         href="https://twitter.com/intent/tweet?text={{ share_title | url_param_escape }}&url={{ share_abs | url_encode }}"
         aria-label="Share on Twitter/X">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M13.7 10.9 20.9 3h-1.7l-6.2 7.2L7.7 3H3l7.6 11.1L3 21h1.7l6.6-7.6 5.7 7.6H21l-7.3-10.1Zm-2.3 2.7-.76-1.08L5.2 4.3h2.1l4.87 6.9.76 1.08 5.7 8h-2.1l-4.83-6.7Z"/></svg>
        <span>{{ section.settings.label_twitter }}</span>
      </a>
      {%- endif -%}

      {%- if section.settings.enable_pinterest and pin_image -%}
      <a class="share-row__item" target="_blank" rel="noopener"
         href="https://pinterest.com/pin/create/button/?url={{ share_abs | url_encode }}&media={{ pin_image | url_encode }}&description={{ share_title | url_param_escape }}"
         aria-label="Share on Pinterest">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 2C6.5 2 3 5.9 3 10.2c0 2.5 1.4 5.6 3.7 6.6.35.16.27-.03.52-1.01.03-.11.2-.77.2-.77.1-.25.06-.34-.15-.56-.74-.71-1.3-2.03-1.3-3.26 0-3.15 2.43-5.98 6.52-5.98 3.56 0 5.55 2.2 5.55 5.14 0 3.84-1.7 7.08-4.23 7.08-1.4 0-2.45-1.16-2.11-2.58.4-1.68 1.18-3.49 1.18-4.7 0-1.08-.58-1.98-1.79-1.98-1.42 0-2.55 1.47-2.55 3.44 0 1.25.42 2.08.42 2.08l-1.69 7.17c-.5 2.12-.07 4.72-.04 4.97.02.13.18.16.26.06.11-.14 1.55-2.08 2.05-4 .14-.55.79-3.05.79-3.05.39.75 1.52 1.4 2.73 1.4 3.6 0 6.26-3.47 6.26-8.12C20.5 5.65 16.96 2 12 2Z"/></svg>
        <span>{{ section.settings.label_pinterest }}</span>
      </a>
      {%- endif -%}

      {%- if section.settings.enable_instagram -%}
      <a class="share-row__item js-share-ig"
         href="{{ share_abs }}"
         data-url="{{ share_abs }}"
         data-title="{{ share_title }}"
         aria-label="Share to Instagram (opens native share on mobile / copies link on desktop)">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5a5.5 5.5 0 1 1 0 11.001 5.5 5.5 0 0 1 0-11Zm0 2a3.5 3.5 0 1 0 .001 7.001A3.5 3.5 0 0 0 12 9.5Zm5.25-3.25a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
        <span>{{ section.settings.label_instagram }}</span>
      </a>
      {%- endif -%}
    </div>

    <div class="share-row__sr-only" aria-live="polite"></div>
  </div>

  <style>
    .section--share-row .share-row{
      display:flex; border:1px solid var(--color-border, #e5e7eb); border-radius:0;
    }
    .section--share-row .share-row__item{
      flex:1 1 0; display:flex; align-items:center; justify-content:center; gap:.6rem;
      padding:1rem 1.25rem; text-decoration:none; color:inherit;
      text-transform:uppercase; font-weight:700; letter-spacing:.06em;
      border-left:1px solid var(--color-border, #e5e7eb);
    }
    .section--share-row .share-row__item:first-child{ border-left:0; }
    .section--share-row .share-row__item:hover{ background:rgba(0,0,0,.03); }
    .section--share-row svg{ width:18px; height:18px; }
    @media (max-width: 749px){
      .section--share-row .share-row{ flex-direction:column; }
      .section--share-row .share-row__item{ border-left:0; border-top:1px solid var(--color-border, #e5e7eb); }
      .section--share-row .share-row__item:first-child{ border-top:0; }
    }
  </style>

  <script>
    (function(){
      var btn = document.currentScript.previousElementSibling?.previousElementSibling?.querySelector('.js-share-ig');
      var live = document.currentScript.previousElementSibling;
      if(!btn) return;

      function announce(msg){ if(live){ live.textContent = msg; } }

      btn.addEventListener('click', function(e){
        e.preventDefault();
        var url = btn.getAttribute('data-url');
        var title = btn.getAttribute('data-title');

        if (navigator.share){
          navigator.share({ title: title, url: url }).catch(function(err){ /* user canceled */ });
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText){
          navigator.clipboard.writeText(url).then(function(){
            announce('Link copied to clipboard');
          }).catch(function(){ window.prompt('Copy this link:', url); });
        } else {
          window.prompt('Copy this link:', url);
        }
      });
    })();
  </script>
</section>

{% schema %}
{
  "name": "Share row (custom)",
  "tag": "section",
  "class": "section",
  "templates": ["product", "article"],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },

    { "type": "checkbox", "id": "enable_facebook", "label": "Facebook", "default": true },
    { "type": "checkbox", "id": "enable_twitter", "label": "Twitter (X)", "default": true },
    { "type": "checkbox", "id": "enable_pinterest", "label": "Pinterest (products only)", "default": true },
    { "type": "checkbox", "id": "enable_instagram", "label": "Instagram (Web Share / Copy link)", "default": true },

    { "type": "text", "id": "label_facebook",  "label": "Facebook label",  "default": "SHARE" },
    { "type": "text", "id": "label_twitter",   "label": "Twitter label",   "default": "TWEET" },
    { "type": "text", "id": "label_pinterest", "label": "Pinterest label", "default": "PIN IT" },
    { "type": "text", "id": "label_instagram", "label": "Instagram label", "default": "INSTAGRAM" }
  ],
  "presets": [
    { "name": "Share row (custom)" }
  ]
}
{% endschema %}
