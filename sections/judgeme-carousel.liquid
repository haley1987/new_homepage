{% comment %}
  sections/judgeme-carousel.liquid
  “Judgeme Carousel” section for Dawn 2.0
{% endcomment %}
<section id="shopify-section-{{ section.id }}" class="judgeme-carousel-section">
  <div class="judgeme-carousel-container">
    <!-- Title + Rating -->
    <div class="judgeme-carousel-header">
      <h2 class="judgeme-carousel-title">{{ section.settings.heading }}</h2>
      <div class="judgeme-carousel-rating">
        <span
          class="jdgm-all-reviews-rating"
          data-score="{{ shop.metafields.judgeme.all_reviews_rating }}"
          aria-label="{{ shop.metafields.judgeme.all_reviews_rating }} stars"
          role="img"
          tabindex="0"
        ></span>
        <span
          class="jdgm-carousel-number-of-reviews"
          data-number-of-reviews="{{ shop.metafields.judgeme.all_reviews_count }}"
        >
          from {{ shop.metafields.judgeme.all_reviews_count }} reviews
        </span>
      </div>
    </div>

    <!-- Judge.me carousel itself -->
    <div class="jdgm-carousel-wrapper" data-auto-install="false">
      {{ shop.metafields.judgeme.featured_carousel }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Judgeme Carousel",
  "settings": [
    {
      "type":    "text",
      "id":      "heading",
      "label":   "Section Heading",
      "default": "Let customers speak for us"
    }
  ],
  "presets": [
    { "name":"Judgeme Carousel", "category":"Testimonials" }
  ]
}
{% endschema %}
