{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
-%}

<section
  class="hw-section hw-image-break"
  style="--hw-mobile-height: {{ section.settings.mobile_height }}svh; --hw-desktop-height: {{ section.settings.desktop_height }}svh; --hw-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"
>
  <div class="hw-image-break__media" aria-hidden="true">
    {%- if desktop_image != blank -%}
      <picture>
        {%- if mobile_image != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 900 }} 900w" sizes="100vw">
        {%- endif -%}
        {{ desktop_image | image_url: width: 2400 | image_tag: widths: '900, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy' }}
      </picture>
    {%- else -%}
      <div class="hw-media-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
    {%- endif -%}
  </div>
  <div class="hw-image-break__overlay" aria-hidden="true"></div>
  <div class="hw-shell hw-image-break__content hw-image-break__content--{{ section.settings.horizontal_alignment }} hw-image-break__content--{{ section.settings.vertical_alignment }}">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="hw-kicker">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.statement != blank -%}<h2 class="hw-image-break__statement">{{ section.settings.statement | escape }}</h2>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}<a class="hw-image-break__link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Haywood image break",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "statement", "label": "Statement", "default": "Built differently." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay strength", "default": 25 },
    { "type": "range", "id": "mobile_height", "min": 40, "max": 100, "step": 5, "unit": "vh", "label": "Mobile image height", "default": 70 },
    { "type": "range", "id": "desktop_height", "min": 40, "max": 100, "step": 5, "unit": "vh", "label": "Desktop image height", "default": 80 },
    { "type": "select", "id": "horizontal_alignment", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "select", "id": "vertical_alignment", "label": "Vertical alignment", "options": [
      { "value": "top", "label": "Top" }, { "value": "middle", "label": "Middle" }, { "value": "bottom", "label": "Bottom" }
    ], "default": "bottom" }
  ],
  "presets": [{ "name": "Haywood image break" }]
}
{% endschema %}
