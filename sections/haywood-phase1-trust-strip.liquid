<section class="hw-section hw-trust" aria-label="{{ section.settings.accessibility_label | escape }}">
  <ul class="hw-trust__list">
    {%- for block in section.blocks -%}
      <li class="hw-trust__item" {{ block.shopify_attributes }}>
        {%- if block.settings.show_icon -%}
          <svg class="hw-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'maple' -%}<path d="M12 2l1.5 4 3-1-1 3 3 1.5-3 2 1 3.5-4-1v7h-1v-7l-4 1 1-3.5-3-2L8.5 8l-1-3 3 1L12 2z"/>
              {%- when 'tools' -%}<path d="M14.5 5.5a4 4 0 01-5 5L4 16l4 4 5.5-5.5a4 4 0 005-5l-2.5 2.5-2-2 2.5-2.5a4 4 0 00-2-2z"/>
              {%- when 'box' -%}<path d="M3 7l9-4 9 4-9 4-9-4zm0 0v10l9 4 9-4V7M12 11v10"/>
              {%- when 'star' -%}<path d="M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3z"/>
              {%- else -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/>
            {%- endcase -%}
          </svg>
        {%- endif -%}
        <p class="hw-trust__title">{{ block.settings.title | escape }}</p>
        {%- if block.settings.copy != blank -%}<p class="hw-trust__copy">{{ block.settings.copy | escape }}</p>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Haywood trust strip",
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Why golfers choose Haywood" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": true },
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "maple", "label": "Maple" }, { "value": "tools", "label": "Tools" },
          { "value": "box", "label": "Box" }, { "value": "star", "label": "Star" },
          { "value": "globe", "label": "Globe" }
        ], "default": "maple" },
        { "type": "text", "id": "title", "label": "Title", "default": "Designed in Canada" },
        { "type": "text", "id": "copy", "label": "Supporting copy", "default": "Purposeful design from Vancouver." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Haywood trust strip", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
