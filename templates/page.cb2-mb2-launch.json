      "settings": {
        "custom_liquid": "{% comment %}\n  HAYWOOD GOLF\n  CB.2 + MB.2 LAUNCH PAGE\n\n  Replace the three image URLs below with Shopify CDN URLs.\n{% endcomment %}\n\n{% assign hero_image = 'https://cdn.shopify.com/s/files/1/0066/1202/5428/files/Haywood-325.jpg?v=1784571593' %}\n{% assign arc_image = 'https://cdn.shopify.com/s/files/1/0066/1202/5428/files/Haywood-55.jpg?v=1784569716' %}\n{% assign detail_image = 'https://cdn.shopify.com/s/files/1/0066/1202/5428/files/Haywood-57.jpg?v=1784569716' %}\n\n{% assign cb2_url = '/products/cb2-forged-players-cavity-back-irons' %}\n{% assign mb2_url = '/products/mb2-forged-muscle-back-irons' %}\n{% assign combo_url = '/products/cb2-mb2-forged-combo-irons' %}\n\n<style>\n  html,\n  body {\n    overflow-x: hidden;\n  }\n\n  .hw-launch {\n    --black: #07090c;\n    --white: #f1f1ef;\n    --grey: #a8a9ad;\n    --line-dark: rgba(255, 255, 255, 0.14);\n    --line-light: rgba(8, 10, 13, 0.18);\n\n    width: 100%;\n    max-width: 100%;\n    margin: 0;\n    overflow: hidden;\n    background: var(--black);\n    color: #ffffff;\n  }\n\n  .hw-launch,\n  .hw-launch * {\n    box-sizing: border-box;\n  }\n\n  .hw-launch img {\n    display: block;\n    width: 100%;\n  }\n\n  .hw-launch a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  .hw-launch h1,\n  .hw-launch h2,\n  .hw-launch h3,\n  .hw-launch p {\n    margin: 0;\n  }\n\n  .hw-container {\n    width: 100%;\n    max-width: 1500px;\n    margin: 0 auto;\n    padding-left: clamp(24px, 5vw, 78px);\n    padding-right: clamp(24px, 5vw, 78px);\n  }\n\n  .hw-serif {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-weight: 400;\n    letter-spacing: -0.045em;\n  }\n\n  .hw-eyebrow {\n    color: #c3c4c7 !important;\n    -webkit-text-fill-color: #c3c4c7 !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1.4;\n    letter-spacing: 0.28em;\n    text-transform: uppercase;\n  }\n\n  .hw-button {\n    display: inline-flex;\n    min-height: 54px;\n    align-items: center;\n    justify-content: center;\n    padding: 16px 30px;\n    border: 1px solid #ffffff;\n    background: #ffffff;\n    color: #080a0d !important;\n    -webkit-text-fill-color: #080a0d !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    transition:\n      background-color 180ms ease,\n      color 180ms ease;\n  }\n\n  .hw-button:hover {\n    background: transparent;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n  }\n\n  /* HERO */\n\n  .hw-hero {\n    position: relative;\n    min-height: 88vh;\n    display: grid;\n    align-items: end;\n    background: var(--black);\n  }\n\n  .hw-hero__media,\n  .hw-hero__overlay {\n    position: absolute;\n    inset: 0;\n  }\n\n  .hw-hero__media img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hw-hero__overlay {\n    background:\n      linear-gradient(\n        90deg,\n        rgba(0, 0, 0, 0.6) 0%,\n        rgba(0, 0, 0, 0.18) 55%,\n        rgba(0, 0, 0, 0.04) 100%\n      ),\n      linear-gradient(\n        180deg,\n        rgba(0, 0, 0, 0.02) 35%,\n        rgba(0, 0, 0, 0.72) 100%\n      );\n  }\n\n  .hw-hero__content {\n    position: relative;\n    z-index: 3;\n    width: 100%;\n    padding-top: 180px;\n    padding-bottom: clamp(70px, 8vw, 120px);\n  }\n\n  .hw-hero__title {\n    max-width: 1050px;\n    margin-top: 24px !important;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    font-size: clamp(58px, 8vw, 126px);\n    line-height: 0.9;\n    overflow-wrap: normal;\n    word-break: normal;\n  }\n\n  .hw-hero__tagline {\n    max-width: 680px;\n    margin-top: 32px !important;\n    color: rgba(255, 255, 255, 0.86) !important;\n    -webkit-text-fill-color: rgba(255, 255, 255, 0.86) !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(18px, 1.8vw, 28px);\n    line-height: 1.4;\n  }\n\n  .hw-hero__action {\n    margin-top: 38px;\n  }\n\n  /* STATEMENT */\n\n  .hw-statement {\n    display: grid;\n    min-height: 70vh;\n    place-items: center;\n    border-top: 1px solid var(--line-dark);\n    text-align: center;\n  }\n\n  .hw-statement__inner {\n    width: 100%;\n    max-width: 1200px;\n    padding-top: 120px;\n    padding-bottom: 120px;\n  }\n\n  .hw-statement__lead {\n    max-width: 950px;\n    margin-left: auto !important;\n    margin-right: auto !important;\n    color: #9da0a6 !important;\n    -webkit-text-fill-color: #9da0a6 !important;\n    font-size: clamp(34px, 4.5vw, 68px);\n    line-height: 1.04;\n  }\n\n  .hw-statement__main {\n    max-width: 1100px;\n    margin-top: 40px !important;\n    margin-left: auto !important;\n    margin-right: auto !important;\n    color: #f4f4f4 !important;\n    -webkit-text-fill-color: #f4f4f4 !important;\n    font-size: clamp(54px, 7vw, 104px);\n    line-height: 0.95;\n  }\n\n  /* ARC */\n\n  .hw-arc {\n    display: grid;\n    grid-template-columns: minmax(0, 1.45fr) minmax(340px, 0.55fr);\n    min-height: 760px;\n    border-top: 1px solid var(--line-dark);\n  }\n\n  .hw-arc__media {\n    min-height: 760px;\n  }\n\n  .hw-arc__media img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hw-arc__copy {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: clamp(70px, 7vw, 110px);\n  }\n\n  .hw-arc__title {\n    margin-top: 25px !important;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    font-size: clamp(52px, 5.5vw, 86px);\n    line-height: 0.94;\n  }\n\n  .hw-arc__details {\n    margin-top: 58px;\n  }\n\n  .hw-arc__details p {\n    color: #b1b3b7 !important;\n    -webkit-text-fill-color: #b1b3b7 !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(17px, 1.35vw, 21px);\n    line-height: 1.35;\n  }\n\n  .hw-arc__details p + p {\n    margin-top: 14px !important;\n  }\n\n  /* CHOOSE YOUR SHAPE */\n\n  .hw-choose {\n    background: var(--white);\n    color: #0a0b0e;\n    padding-top: clamp(105px, 11vw, 170px);\n    padding-bottom: clamp(100px, 10vw, 155px);\n  }\n\n  .hw-choose .hw-eyebrow {\n    color: #737478 !important;\n    -webkit-text-fill-color: #737478 !important;\n  }\n\n  .hw-choose__title {\n    margin-top: 22px !important;\n    color: #090a0c !important;\n    -webkit-text-fill-color: #090a0c !important;\n    font-size: clamp(58px, 8vw, 120px);\n    line-height: 0.9;\n  }\n\n  .hw-models {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    margin-top: clamp(70px, 8vw, 115px);\n    border-top: 1px solid var(--line-light);\n    border-bottom: 1px solid var(--line-light);\n  }\n\n  .hw-model {\n    padding: clamp(58px, 6vw, 92px);\n  }\n\n  .hw-model:first-child {\n    padding-left: 0;\n  }\n\n  .hw-model:last-child {\n    padding-right: 0;\n    border-left: 1px solid var(--line-light);\n  }\n\n  .hw-model__title {\n    margin-top: 20px !important;\n    color: #090a0c !important;\n    -webkit-text-fill-color: #090a0c !important;\n    font-size: clamp(58px, 6vw, 88px);\n    line-height: 0.95;\n  }\n\n  .hw-model__statement {\n    max-width: 500px;\n    margin-top: 34px !important;\n    color: #111216 !important;\n    -webkit-text-fill-color: #111216 !important;\n    font-size: clamp(28px, 3vw, 43px);\n    line-height: 1.08;\n  }\n\n  .hw-model__body {\n    max-width: 470px;\n    margin-top: 30px !important;\n    color: #5d5f64 !important;\n    -webkit-text-fill-color: #5d5f64 !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(16px, 1.25vw, 19px);\n    line-height: 1.65;\n  }\n\n  .hw-model__link {\n    display: inline-block;\n    margin-top: 40px;\n    padding-bottom: 8px;\n    border-bottom: 1px solid #111111;\n    color: #111111 !important;\n    -webkit-text-fill-color: #111111 !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.18em;\n    text-transform: uppercase;\n  }\n\n  /* COMBO SETS */\n\n  .hw-combo {\n    background: var(--black);\n    padding-top: clamp(100px, 10vw, 160px);\n    padding-bottom: clamp(100px, 10vw, 160px);\n    border-top: 1px solid var(--line-dark);\n    border-bottom: 1px solid var(--line-dark);\n  }\n\n  .hw-combo__intro {\n    display: grid;\n    grid-template-columns: 1.1fr 0.9fr;\n    gap: clamp(50px, 8vw, 130px);\n    align-items: end;\n    margin-top: 28px;\n  }\n\n  .hw-combo__title {\n    max-width: 760px;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    font-size: clamp(58px, 7vw, 110px);\n    line-height: 0.9;\n  }\n\n  .hw-combo__copy {\n    max-width: 560px;\n    color: #a9abb0 !important;\n    -webkit-text-fill-color: #a9abb0 !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(17px, 1.4vw, 21px);\n    line-height: 1.65;\n  }\n\n  .hw-combo__options {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    margin-top: clamp(70px, 8vw, 115px);\n    border-top: 1px solid var(--line-dark);\n    border-bottom: 1px solid var(--line-dark);\n  }\n\n  .hw-combo__option {\n    min-height: 355px;\n    padding: clamp(34px, 4vw, 58px);\n  }\n\n  .hw-combo__option + .hw-combo__option {\n    border-left: 1px solid var(--line-dark);\n  }\n\n  .hw-combo__number {\n    color: #666970 !important;\n    -webkit-text-fill-color: #666970 !important;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 16px;\n  }\n\n  .hw-combo__configuration {\n    margin-top: 45px;\n  }\n\n  .hw-combo__model {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .hw-combo__range {\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(25px, 2.3vw, 38px);\n    font-weight: 400;\n    line-height: 1;\n  }\n\n  .hw-combo__name {\n    margin-top: 4px;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: clamp(36px, 3.6vw, 57px);\n    font-weight: 400;\n    line-height: 0.95;\n    letter-spacing: -0.04em;\n  }\n\n  .hw-combo__plus {\n    display: block;\n    margin: 20px 0;\n    color: #777a80 !important;\n    -webkit-text-fill-color: #777a80 !important;\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 28px;\n    line-height: 1;\n  }\n\n  .hw-combo__action {\n    display: flex;\n    justify-content: center;\n    margin-top: clamp(48px, 6vw, 82px);\n  }\n\n  /* DETAIL IMAGE */\n\n  .hw-detail {\n    position: relative;\n    min-height: 88vh;\n    display: grid;\n    align-items: end;\n  }\n\n  .hw-detail__media,\n  .hw-detail__overlay {\n    position: absolute;\n    inset: 0;\n  }\n\n  .hw-detail__media img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hw-detail__overlay {\n    background:\n      linear-gradient(\n        180deg,\n        rgba(0, 0, 0, 0.02) 30%,\n        rgba(0, 0, 0, 0.76) 100%\n      );\n  }\n\n  .hw-detail__content {\n    position: relative;\n    z-index: 2;\n    padding-top: 170px;\n    padding-bottom: clamp(75px, 8vw, 120px);\n  }\n\n  .hw-detail__title {\n    max-width: 1000px;\n    margin-top: 26px !important;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    font-size: clamp(62px, 8vw, 122px);\n    line-height: 0.9;\n  }\n\n  /* EDITORIAL POINTS */\n\n  .hw-points {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    border-top: 1px solid var(--line-dark);\n    border-bottom: 1px solid var(--line-dark);\n  }\n\n  .hw-point {\n    min-height: 370px;\n    padding: clamp(55px, 6vw, 90px);\n  }\n\n  .hw-point + .hw-point {\n    border-left: 1px solid var(--line-dark);\n  }\n\n  .hw-point__title {\n    color: #8f9196 !important;\n    -webkit-text-fill-color: #8f9196 !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n  }\n\n  .hw-point__statement {\n    margin-top: 48px !important;\n    color: #f3f3f3 !important;\n    -webkit-text-fill-color: #f3f3f3 !important;\n    font-size: clamp(34px, 3.5vw, 54px);\n    line-height: 1.05;\n  }\n\n  /* FINAL */\n\n  .hw-final {\n    position: relative;\n    min-height: 84vh;\n    display: grid;\n    place-items: center;\n    text-align: center;\n  }\n\n  .hw-final__media,\n  .hw-final__overlay {\n    position: absolute;\n    inset: 0;\n  }\n\n  .hw-final__media img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n  }\n\n  .hw-final__overlay {\n    background: rgba(0, 0, 0, 0.58);\n  }\n\n  .hw-final__content {\n    position: relative;\n    z-index: 2;\n    padding-top: 120px;\n    padding-bottom: 120px;\n  }\n\n  .hw-final__title {\n    margin-top: 24px !important;\n    color: #ffffff !important;\n    -webkit-text-fill-color: #ffffff !important;\n    font-size: clamp(60px, 8vw, 126px);\n    line-height: 0.9;\n  }\n\n  .hw-final__tagline {\n    margin-top: 30px !important;\n    color: rgba(255, 255, 255, 0.86) !important;\n    -webkit-text-fill-color: rgba(255, 255, 255, 0.86) !important;\n    font-family: Arial, Helvetica, sans-serif;\n    font-size: clamp(17px, 1.6vw, 24px);\n    line-height: 1.5;\n  }\n\n  .hw-final__action {\n    margin-top: 40px;\n  }\n\n  /* MOBILE */\n\n  @media screen and (max-width: 820px) {\n    .hw-hero {\n      min-height: 82vh;\n    }\n\n    .hw-hero__title {\n      font-size: clamp(54px, 15vw, 88px);\n    }\n\n    .hw-statement {\n      min-height: 64vh;\n    }\n\n    .hw-arc {\n      grid-template-columns: 1fr;\n      min-height: 0;\n    }\n\n    .hw-arc__media {\n      min-height: 0;\n      aspect-ratio: 4 / 5;\n    }\n\n    .hw-arc__copy {\n      padding: 80px 26px 95px;\n    }\n\n    .hw-models {\n      grid-template-columns: 1fr;\n    }\n\n    .hw-model {\n      padding: 58px 0;\n    }\n\n    .hw-model:last-child {\n      border-left: 0;\n      border-top: 1px solid var(--line-light);\n    }\n\n    .hw-combo__intro {\n      grid-template-columns: 1fr;\n    }\n\n    .hw-combo__options {\n      grid-template-columns: 1fr 1fr;\n    }\n\n    .hw-combo__option:nth-child(3) {\n      border-left: 0;\n      border-top: 1px solid var(--line-dark);\n    }\n\n    .hw-combo__option:nth-child(4) {\n      border-top: 1px solid var(--line-dark);\n    }\n\n    .hw-points {\n      grid-template-columns: 1fr;\n    }\n\n    .hw-point {\n      min-height: 0;\n    }\n\n    .hw-point + .hw-point {\n      border-left: 0;\n      border-top: 1px solid var(--line-dark);\n    }\n  }\n\n  @media screen and (max-width: 520px) {\n    .hw-button {\n      width: 100%;\n    }\n\n    .hw-hero {\n      min-height: 78vh;\n    }\n\n    .hw-hero__content {\n      padding-bottom: 60px;\n    }\n\n    .hw-hero__title {\n      font-size: clamp(48px, 15vw, 72px);\n      line-height: 0.94;\n    }\n\n    .hw-statement__lead {\n      font-size: 34px;\n    }\n\n    .hw-statement__main {\n      font-size: 54px;\n    }\n\n    .hw-choose__title,\n    .hw-combo__title,\n    .hw-detail__title {\n      font-size: 54px;\n    }\n\n    .hw-combo__options {\n      grid-template-columns: 1fr;\n    }\n\n    .hw-combo__option + .hw-combo__option {\n      border-left: 0;\n      border-top: 1px solid var(--line-dark);\n    }\n\n    .hw-final__title {\n      font-size: 54px;\n    }\n  }\n</style>\n\n<div class=\"hw-launch\">\n\n  <!-- HERO -->\n  <section class=\"hw-hero\">\n    <div class=\"hw-hero__media\">\n      <img\n        src=\"{{ hero_image }}\"\n        alt=\"Haywood CB.2 and MB.2 forged irons\"\n        loading=\"eager\"\n        fetchpriority=\"high\"\n      >\n    </div>\n\n    <div class=\"hw-hero__overlay\"></div>\n\n    <div class=\"hw-container hw-hero__content\">\n      <p class=\"hw-eyebrow\">\n        New forged players irons\n      </p>\n\n      <h1 class=\"hw-serif hw-hero__title\">\n        CB.2 + MB.2\n      </h1>\n\n      <p class=\"hw-hero__tagline\">\n        The next chapter of Haywood forged irons.\n      </p>\n\n      <div class=\"hw-hero__action\">\n        <a class=\"hw-button\" href=\"#choose-your-shape\">\n          Explore\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <!-- STATEMENT -->\n  <section class=\"hw-statement\">\n    <div class=\"hw-container hw-statement__inner\">\n      <p class=\"hw-serif hw-statement__lead\">\n        Some things don't need reinventing.\n      </p>\n\n      <h2 class=\"hw-serif hw-statement__main\">\n        They need to be refined.\n      </h2>\n    </div>\n  </section>\n\n  <!-- ARC -->\n  <section class=\"hw-arc\">\n    <div class=\"hw-arc__media\">\n      <img\n        src=\"{{ arc_image }}\"\n        alt=\"Haywood Arc mark framed by forged iron faces\"\n        loading=\"lazy\"\n      >\n    </div>\n\n    <div class=\"hw-arc__copy\">\n      <p class=\"hw-eyebrow\">\n        The next chapter\n      </p>\n\n      <h2 class=\"hw-serif hw-arc__title\">\n        Refined<br>\n        with<br>\n        intention.\n      </h2>\n\n      <div class=\"hw-arc__details\">\n        <p>Every edge.</p>\n        <p>Every radius.</p>\n        <p>Every surface.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- CHOOSE YOUR SHAPE -->\n  <section id=\"choose-your-shape\" class=\"hw-choose\">\n    <div class=\"hw-container\">\n      <p class=\"hw-eyebrow\">\n        Two distinct shapes\n      </p>\n\n      <h2 class=\"hw-serif hw-choose__title\">\n        Choose your shape.\n      </h2>\n\n      <div class=\"hw-models\">\n\n        <article class=\"hw-model\">\n          <p class=\"hw-eyebrow\">\n            The players cavity\n          </p>\n\n          <h3 class=\"hw-serif hw-model__title\">\n            CB.2\n          <